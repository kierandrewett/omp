diff --git a/packages/coding-agent/test/mcp-elicitation.test.ts b/packages/coding-agent/test/mcp-elicitation.test.ts
new file mode 100644
index 0000000000..1b2b88f07f
--- /dev/null
+++ b/packages/coding-agent/test/mcp-elicitation.test.ts
@@ -0,0 +1,394 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { connectToServer } from "@oh-my-pi/pi-coding-agent/mcp/client";
+import { ElicitationBroker, type ElicitationDialogs } from "@oh-my-pi/pi-coding-agent/mcp/elicitation";
+import type { MCPElicitationResult } from "@oh-my-pi/pi-coding-agent/mcp/types";
+
+const encoder = new TextEncoder();
+
+let server: Bun.Server<undefined> | null = null;
+
+afterEach(() => {
+	server?.stop(true);
+	server = null;
+});
+
+interface Reply {
+	result?: unknown;
+	error?: { code: number; message: string };
+}
+
+interface TestServer {
+	url: string;
+	/** `initialize` params the client sent. */
+	initialize: () => { capabilities: Record<string, unknown> } | undefined;
+}
+
+/**
+ * A minimal MCP server over Streamable HTTP. `tools/call` asks the client `elicitation/create` on
+ * the response stream, waits for the client's reply, then returns that reply as the tool result.
+ */
+function startServer(elicitation: Record<string, unknown>): TestServer {
+	let initializeParams: { capabilities: Record<string, unknown> } | undefined;
+	const replies = new Map<string, PromiseWithResolvers<Reply>>();
+	server = Bun.serve({
+		port: 0,
+		async fetch(req) {
+			if (req.method === "GET") return new Response(null, { status: 405 });
+			if (req.method === "DELETE") return new Response(null, { status: 204 });
+			const body = (await req.json()) as {
+				id?: string | number;
+				method?: string;
+				params?: { capabilities: Record<string, unknown> };
+				result?: unknown;
+				error?: { code: number; message: string };
+			};
+
+			// A response to the request the server sent.
+			if (body.method === undefined && body.id !== undefined) {
+				replies.get(String(body.id))?.resolve({ result: body.result, error: body.error });
+				return new Response(null, { status: 202 });
+			}
+			if (body.method === "initialize") {
+				initializeParams = body.params;
+				return Response.json(
+					{
+						jsonrpc: "2.0",
+						id: body.id,
+						result: {
+							protocolVersion: "2025-11-25",
+							capabilities: { tools: {} },
+							serverInfo: { name: "elicit-test", version: "1.0.0" },
+						},
+					},
+					{ headers: { "Mcp-Session-Id": "elicit-test" } },
+				);
+			}
+			if (body.method === "tools/call") {
+				const pending = Promise.withResolvers<Reply>();
+				replies.set("ask-1", pending);
+				const stream = new ReadableStream<Uint8Array>({
+					async start(controller) {
+						const send = (message: unknown) =>
+							controller.enqueue(encoder.encode(`event: message\ndata: ${JSON.stringify(message)}\n\n`));
+						send({ jsonrpc: "2.0", id: "ask-1", method: "elicitation/create", params: elicitation });
+						const reply = await pending.promise;
+						send({ jsonrpc: "2.0", id: body.id, result: { content: [], reply } });
+						controller.close();
+					},
+				});
+				return new Response(stream, { headers: { "Content-Type": "text/event-stream" } });
+			}
+			return new Response(null, { status: 202 });
+		},
+	});
+	return {
+		url: `http://127.0.0.1:${server.port}/mcp`,
+		initialize: () => initializeParams,
+	};
+}
+
+/** Answers dialogs from a script. A `undefined` entry is a dismissed dialog (Escape). */
+function scriptedDialogs(selects: Array<string | undefined>, inputs: Array<string | undefined> = []) {
+	const shown: string[] = [];
+	const notices: string[] = [];
+	const dialogs: ElicitationDialogs = {
+		select: async (title, options) => {
+			shown.push(`${title}\n${options.map(o => (typeof o === "string" ? o : o.label)).join(" | ")}`);
+			return selects.shift();
+		},
+		input: async title => {
+			shown.push(title);
+			return inputs.shift();
+		},
+		notify: message => {
+			notices.push(message);
+		},
+	};
+	return { dialogs, shown, notices };
+}
+
+async function askThroughServer(
+	elicitation: Record<string, unknown>,
+	broker: ElicitationBroker,
+): Promise<{ reply: Reply & MCPElicitationResult; server: TestServer }> {
+	const test = startServer(elicitation);
+	const connection = await connectToServer(
+		"elicit-test",
+		{ type: "http", url: test.url, timeout: 5000 },
+		{
+			elicitation: true,
+			onRequest: async (method, params) => {
+				if (method === "elicitation/create") return broker.handle("elicit-test", params);
+				return {};
+			},
+		},
+	);
+	try {
+		const out = await connection.transport.request<{ reply: Reply & MCPElicitationResult }>("tools/call", {
+			name: "ask",
+			arguments: {},
+		});
+		return { reply: out.reply, server: test };
+	} finally {
+		await connection.transport.close();
+	}
+}
+
+describe("MCP form elicitation: capability", () => {
+	it("declares form elicitation only when asked to and a handler exists", async () => {
+		const on = startServer({ message: "x" });
+		const connectedOn = await connectToServer(
+			"on",
+			{ type: "http", url: on.url, timeout: 5000 },
+			{ elicitation: true, onRequest: async () => ({}) },
+		);
+		await connectedOn.transport.close();
+		expect(on.initialize()?.capabilities.elicitation).toEqual({ form: {} });
+		expect(on.initialize()?.capabilities.roots).toEqual({ listChanged: false });
+		server?.stop(true);
+
+		const off = startServer({ message: "x" });
+		const connectedOff = await connectToServer(
+			"off",
+			{ type: "http", url: off.url, timeout: 5000 },
+			{ onRequest: async () => ({}) },
+		);
+		await connectedOff.transport.close();
+		expect(off.initialize()?.capabilities.elicitation).toBeUndefined();
+		server?.stop(true);
+
+		// A flag with no handler would leave the server's question unanswered, so it is not declared.
+		const orphan = startServer({ message: "x" });
+		const connectedOrphan = await connectToServer(
+			"orphan",
+			{ type: "http", url: orphan.url, timeout: 5000 },
+			{ elicitation: true },
+		);
+		await connectedOrphan.transport.close();
+		expect(orphan.initialize()?.capabilities.elicitation).toBeUndefined();
+	});
+});
+
+describe("MCP form elicitation: a server asks, a person answers", () => {
+	it("accepts an approval only when the person picks Accept", async () => {
+		const broker = new ElicitationBroker();
+		const ui = scriptedDialogs(["Accept"]);
+		broker.setUI(ui.dialogs);
+		const { reply } = await askThroughServer(
+			{ message: "Send this email to Sam?", requestedSchema: { type: "object", properties: {} } },
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "accept", content: {} });
+		expect(ui.shown[0]).toContain('MCP server "elicit-test" asks:');
+		expect(ui.shown[0]).toContain("Send this email to Sam?");
+	});
+
+	it("declines when the person picks Decline", async () => {
+		const broker = new ElicitationBroker();
+		broker.setUI(scriptedDialogs(["Decline"]).dialogs);
