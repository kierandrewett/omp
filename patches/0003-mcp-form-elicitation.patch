+
+	it("cancels when the person backs out partway through", async () => {
+		const broker = new ElicitationBroker();
+		broker.setUI(scriptedDialogs(["Answer the questions"], [undefined]).dialogs);
+		const { reply } = await askThroughServer(
+			{
+				message: "Name it",
+				requestedSchema: {
+					type: "object",
+					properties: { name: { type: "string", title: "Name" } },
+					required: ["name"],
+				},
+			},
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "cancel" });
+	});
+
+	it("does not accept when the final review is dismissed", async () => {
+		const broker = new ElicitationBroker();
+		broker.setUI(scriptedDialogs(["Answer the questions", undefined], ["hello"]).dialogs);
