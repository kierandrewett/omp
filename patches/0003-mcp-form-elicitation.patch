+			},
+			broker,
+		);
+		expect(reply.result).toEqual({
+			action: "accept",
+			content: { replicas: 7, env: "prod", backups: true, owner: "me@example.com" },
+		});
+		expect(ui.notices).toEqual(["Enter a number.", "Enter a whole number."]);
+		// The person sees their answers before anything is sent.
+		expect(ui.shown.at(-1)).toContain("- Replicas: 7");
+		expect(ui.shown.at(-1)).toContain("- Environment: Production");
