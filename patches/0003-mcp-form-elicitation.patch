index 0000000000..d9e9e31dde
--- /dev/null
+++ b/packages/coding-agent/src/mcp/elicitation.ts
@@ -0,0 +1,419 @@
+/**
+ * MCP form elicitation.
+ *
+ * A server can ask the person using the client a question mid-call (`elicitation/create`). This is
+ * how a gateway such as Executor asks "may I run this action?". The answer must come from a person,
+ * so anything that is not an explicit answer is a `cancel`: no UI, a dismissed dialog, a bad schema
+ * or a failure never becomes an `accept`. Dialogs carry no timeout for the same reason.
+ */
+import type { ExtensionUIContext } from "../extensibility/extensions/types";
+import type { MCPElicitationParams, MCPElicitationProperty, MCPElicitationResult, MCPElicitationValue } from "./types";
+
+/** The dialogs a question needs. Narrower than the whole UI context so tests can script them. */
+export type ElicitationDialogs = Pick<ExtensionUIContext, "select" | "input" | "notify">;
+
+const MAX_MESSAGE_CHARS = 2000;
+const MAX_TITLE_CHARS = 200;
+const MAX_META_CHARS = 1200;
+const MAX_ATTEMPTS = 5;
+const JSON_RPC_INVALID_PARAMS = -32602;
+
+const ACCEPT = "Accept";
+const DECLINE = "Decline";
+const ANSWER = "Answer the questions";
+const SUBMIT = "Submit";
+const DONE = "Done";
+const SKIP = "(skip)";
+const YES = "Yes";
+const NO = "No";
+
+/**
+ * Text from a server is shown in a terminal. Strip control characters, including the escape that
+ * starts terminal sequences, so a server cannot repaint the screen or hide part of its own question.
+ */
+function clean(text: unknown, limit: number): string {
+	const raw = typeof text === "string" ? text : "";
+	const stripped = raw.replace(/[\u0000-\u0008\u000b-\u001f\u007f-\u009f]/g, "");
+	return stripped.length > limit ? `${stripped.slice(0, limit - 1)}\u2026` : stripped;
+}
+
+class ElicitationSchemaError extends Error {
+	readonly code = JSON_RPC_INVALID_PARAMS;
+}
+
+interface Choice {
+	value: string;
+	label: string;
+}
+
+interface FieldBase {
+	key: string;
+	title: string;
+	description: string;
+	required: boolean;
+}
+
+type Field =
+	| (FieldBase & { kind: "boolean"; default?: boolean })
+	| (FieldBase & {
+			kind: "string";
+			default?: string;
+			minLength?: number;
+			maxLength?: number;
+			format?: string;
+	  })
+	| (FieldBase & { kind: "number"; integer: boolean; default?: number; minimum?: number; maximum?: number })
+	| (FieldBase & { kind: "choice"; choices: Choice[]; default?: string })
+	| (FieldBase & {
+			kind: "multi";
+			choices: Choice[];
+			default?: string[];
+			minItems?: number;
+			maxItems?: number;
+	  });
+
+function readChoices(property: MCPElicitationProperty, key: string): Choice[] | undefined {
+	if (property.oneOf) {
+		return property.oneOf.map(option => ({
+			value: option.const,
+			label: clean(option.title ?? option.const, MAX_TITLE_CHARS),
+		}));
+	}
+	if (property.enum) {
+		return property.enum.map((value, index) => ({
+			value,
+			label: clean(property.enumNames?.[index] ?? value, MAX_TITLE_CHARS),
+		}));
+	}
+	if (property.type === "array") {
+		const items = property.items;
+		if (items?.anyOf) {
+			return items.anyOf.map(option => ({
+				value: option.const,
+				label: clean(option.title ?? option.const, MAX_TITLE_CHARS),
+			}));
+		}
+		if (items?.enum) return items.enum.map(value => ({ value, label: clean(value, MAX_TITLE_CHARS) }));
+		throw new ElicitationSchemaError(`Field "${key}" is an array without enum items.`);
+	}
+	return undefined;
+}
+
+/** Turn the flat JSON Schema a server sends into fields. Anything the spec does not allow is refused. */
+function readFields(params: MCPElicitationParams): Field[] {
+	const properties = params.requestedSchema?.properties ?? {};
+	const required = new Set(params.requestedSchema?.required ?? []);
+	const fields: Field[] = [];
+	for (const [key, property] of Object.entries(properties)) {
+		const base: FieldBase = {
+			key,
+			title: clean(property.title ?? key, MAX_TITLE_CHARS) || key,
+			description: clean(property.description, MAX_MESSAGE_CHARS),
+			required: required.has(key),
+		};
+		const choices = readChoices(property, key);
+		if (property.type === "array") {
+			fields.push({
+				...base,
+				kind: "multi",
+				choices: choices ?? [],
+				...(Array.isArray(property.default) ? { default: property.default.map(String) } : {}),
+				...(property.minItems === undefined ? {} : { minItems: property.minItems }),
+				...(property.maxItems === undefined ? {} : { maxItems: property.maxItems }),
+			});
+		} else if (choices) {
+			fields.push({
+				...base,
+				kind: "choice",
+				choices,
+				...(typeof property.default === "string" ? { default: property.default } : {}),
+			});
+		} else if (property.type === "boolean") {
+			fields.push({
+				...base,
+				kind: "boolean",
+				...(typeof property.default === "boolean" ? { default: property.default } : {}),
+			});
+		} else if (property.type === "number" || property.type === "integer") {
+			fields.push({
+				...base,
+				kind: "number",
+				integer: property.type === "integer",
+				...(typeof property.default === "number" ? { default: property.default } : {}),
+				...(property.minimum === undefined ? {} : { minimum: property.minimum }),
+				...(property.maximum === undefined ? {} : { maximum: property.maximum }),
+			});
+		} else if (property.type === "string") {
+			fields.push({
+				...base,
+				kind: "string",
+				...(typeof property.default === "string" ? { default: property.default } : {}),
+				...(property.minLength === undefined ? {} : { minLength: property.minLength }),
+				...(property.maxLength === undefined ? {} : { maxLength: property.maxLength }),
+				...(property.format === undefined ? {} : { format: property.format }),
+			});
+		} else {
+			throw new ElicitationSchemaError(`Field "${key}" has an unsupported type.`);
+		}
+	}
+	return fields;
+}
+
+const FORMAT_CHECKS: Record<string, (text: string) => boolean> = {
+	email: text => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text),
+	uri: text => URL.canParse(text),
+	date: text => /^\d{4}-\d{2}-\d{2}$/.test(text) && !Number.isNaN(Date.parse(text)),
+	"date-time": text => !Number.isNaN(Date.parse(text)),
+};
+
+/** A reason the text is not acceptable, or undefined when it is. */
+function stringProblem(field: Extract<Field, { kind: "string" }>, text: string): string | undefined {
+	if (field.minLength !== undefined && text.length < field.minLength) {
+		return `At least ${field.minLength} characters.`;
+	}
+	if (field.maxLength !== undefined && text.length > field.maxLength) {
+		return `At most ${field.maxLength} characters.`;
+	}
+	const check = field.format ? FORMAT_CHECKS[field.format] : undefined;
+	if (check && !check(text)) return `Not a valid ${field.format}.`;
+	return undefined;
+}
+
+function numberProblem(field: Extract<Field, { kind: "number" }>, text: string): string | number {
+	const value = Number(text);
+	if (text.trim() === "" || !Number.isFinite(value)) return "Enter a number.";
+	if (field.integer && !Number.isInteger(value)) return "Enter a whole number.";
+	if (field.minimum !== undefined && value < field.minimum) return `At least ${field.minimum}.`;
+	if (field.maximum !== undefined && value > field.maximum) return `At most ${field.maximum}.`;
+	return value;
+}
+
+/** What a question returned: an answer, "no answer, leave it out", or the person backed out. */
+type Asked = { kind: "value"; value: MCPElicitationValue } | { kind: "skip" } | { kind: "cancel" };
+
+const CANCEL: Asked = { kind: "cancel" };
+
+function heading(field: Field): string {
+	return field.description
+		? `${field.title}${field.required ? "" : " (optional)"}\n${field.description}`
+		: `${field.title}${field.required ? "" : " (optional)"}`;
+}
+
+function labels(choices: Choice[]): string[] {
+	const seen = new Set<string>();
+	return choices.map(choice => {
+		// Two options can share a title. Add the value so the person can tell them apart.
+		const label = seen.has(choice.label) ? `${choice.label} (${choice.value})` : choice.label;
+		seen.add(choice.label);
+		return label;
+	});
+}
+
+async function askChoice(ui: ElicitationDialogs, field: Extract<Field, { kind: "choice" }>): Promise<Asked> {
+	const shown = labels(field.choices);
+	const options = field.required ? shown : [...shown, SKIP];
+	const initial = field.default === undefined ? undefined : field.choices.findIndex(c => c.value === field.default);
+	const picked = await ui.select(
+		heading(field),
+		options,
+		initial !== undefined && initial >= 0 ? { initialIndex: initial } : undefined,
+	);
+	if (picked === undefined) return CANCEL;
+	if (picked === SKIP) return { kind: "skip" };
+	const index = shown.indexOf(picked);
+	const choice = field.choices[index];
+	return choice ? { kind: "value", value: choice.value } : CANCEL;
+}
+
+async function askMulti(ui: ElicitationDialogs, field: Extract<Field, { kind: "multi" }>): Promise<Asked> {
+	const shown = labels(field.choices);
+	const chosen = new Set<number>(
+		(field.default ?? []).map(value => field.choices.findIndex(c => c.value === value)).filter(i => i >= 0),
+	);
+	for (let attempt = 0; attempt < 100; attempt += 1) {
+		const options = [...shown.map((label, i) => `${chosen.has(i) ? "[x]" : "[ ]"} ${label}`), DONE];
+		const picked = await ui.select(`${heading(field)}\nSelect each one you want, then choose ${DONE}.`, options);
+		if (picked === undefined) return CANCEL;
+		if (picked === DONE) {
+			const count = chosen.size;
+			if (field.minItems !== undefined && count < field.minItems) {
+				ui.notify(`Choose at least ${field.minItems}.`, "warning");
+				continue;
+			}
+			if (field.maxItems !== undefined && count > field.maxItems) {
+				ui.notify(`Choose at most ${field.maxItems}.`, "warning");
+				continue;
+			}
+			if (count === 0 && !field.required) return { kind: "skip" };
+			const value = [...chosen]
+				.sort((a, b) => a - b)
+				.flatMap(i => (field.choices[i] ? [field.choices[i].value] : []));
+			return { kind: "value", value };
+		}
+		const index = options.indexOf(picked);
+		if (index < 0 || index >= shown.length) return CANCEL;
+		if (chosen.has(index)) chosen.delete(index);
+		else chosen.add(index);
+	}
+	return CANCEL;
+}
+
+async function askText(ui: ElicitationDialogs, field: Extract<Field, { kind: "string" | "number" }>): Promise<Asked> {
+	const hint = field.default === undefined ? "" : ` Press Enter for ${String(field.default)}.`;
+	for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt += 1) {
+		const text = await ui.input(heading(field), hint.trim() || undefined);
+		if (text === undefined) return CANCEL;
+		let value: string | number;
+		if (text === "") {
+			if (field.default !== undefined) return { kind: "value", value: field.default };
+			if (!field.required) return { kind: "skip" };
+			ui.notify(`${field.title} is required.`, "warning");
+			continue;
+		}
+		let problem: string | undefined;
+		if (field.kind === "number") {
+			const parsed = numberProblem(field, text);
+			if (typeof parsed === "string") problem = parsed;
+			value = typeof parsed === "number" ? parsed : 0;
+			if (!problem) return { kind: "value", value };
+		} else {
+			problem = stringProblem(field, text);
+			if (!problem) return { kind: "value", value: text };
+		}
+		ui.notify(problem ?? "Not valid.", "warning");
+	}
+	return CANCEL;
+}
+
+async function askField(ui: ElicitationDialogs, field: Field): Promise<Asked> {
+	switch (field.kind) {
+		case "boolean": {
+			const options = field.default === false ? [NO, YES] : [YES, NO];
+			const picked = await ui.select(heading(field), options);
+			if (picked === undefined) return CANCEL;
+			return { kind: "value", value: picked === YES };
+		}
+		case "choice":
+			return askChoice(ui, field);
+		case "multi":
+			return askMulti(ui, field);
+		default:
+			return askText(ui, field);
+	}
+}
+
+function show(value: MCPElicitationValue, field: Field): string {
+	if (Array.isArray(value)) {
+		const names = value.map(v => {
+			const choice = field.kind === "multi" ? field.choices.find(c => c.value === v) : undefined;
+			return choice?.label ?? v;
+		});
+		return names.join(", ") || "(none)";
+	}
+	if (field.kind === "choice") return field.choices.find(c => c.value === value)?.label ?? String(value);
+	return String(value);
+}
+
+/**
+ * What a server attached in `_meta`, as plain text. Servers put the terms of an approval there, for example
+ * what accepting permits and whether it lasts, so the person has to see them before saying yes. OMP never
+ * acts on `_meta`: nothing is remembered or widened because a server asked for it.
+ */
+function describeMeta(meta: unknown): string {
+	if (typeof meta !== "object" || meta === null || Array.isArray(meta) || Object.keys(meta).length === 0) return "";
+	let text: string;
+	try {
+		text = JSON.stringify(meta, null, 1);
+	} catch {
+		return "";
+	}
+	return `\n\nThe server attached these terms (OMP applies none of them beyond this one answer):\n${clean(text, MAX_META_CHARS)}`;
+}
+
+/** Run one form: ask, review, answer. Never returns `accept` without an explicit yes. */
+export async function runElicitationForm(
+	ui: ElicitationDialogs,
+	serverName: string,
+	params: MCPElicitationParams,
+): Promise<MCPElicitationResult> {
+	const fields = readFields(params);
+	const message = clean(params.message, MAX_MESSAGE_CHARS);
+	const title = `MCP server "${clean(serverName, MAX_TITLE_CHARS)}" asks:\n${message}${describeMeta(params._meta)}`;
+
+	if (fields.length === 0) {
+		const picked = await ui.select(title, [ACCEPT, DECLINE]);
+		if (picked === ACCEPT) return { action: "accept", content: {} };
+		return { action: picked === DECLINE ? "decline" : "cancel" };
+	}
+
+	const outline = fields.map(field => `- ${field.title}${field.required ? "" : " (optional)"}`).join("\n");
+	const gate = await ui.select(`${title}\n\nIt wants to know:\n${outline}`, [ANSWER, DECLINE]);
+	if (gate !== ANSWER) return { action: gate === DECLINE ? "decline" : "cancel" };
+
+	const content: Record<string, MCPElicitationValue> = {};
+	for (const field of fields) {
+		const asked = await askField(ui, field);
+		if (asked.kind === "cancel") return { action: "cancel" };
+		if (asked.kind === "value") content[field.key] = asked.value;
+	}
+
+	const review = fields
+		.filter(field => content[field.key] !== undefined)
+		.map(field => `- ${field.title}: ${show(content[field.key] as MCPElicitationValue, field)}`)
+		.join("\n");
+	const final = await ui.select(
+		`Send these answers to "${clean(serverName, MAX_TITLE_CHARS)}"?\n${review || "(no answers)"}`,
+		[SUBMIT, DECLINE],
+	);
+	if (final === SUBMIT) return { action: "accept", content };
+	return { action: final === DECLINE ? "decline" : "cancel" };
+}
+
+/**
+ * Holds the current dialogs and answers `elicitation/create` for every server. Questions are asked
+ * one at a time, so two servers cannot put dialogs on top of each other.
+ */
+export class ElicitationBroker {
+	#ui: ElicitationDialogs | undefined;
+	#tail: Promise<unknown> = Promise.resolve();
+
+	/** Set when the session has a screen a person can answer on. Clear it when it goes away. */
+	setUI(ui: ElicitationDialogs | undefined): void {
+		this.#ui = ui;
+	}
+
+	get hasUI(): boolean {
+		return this.#ui !== undefined;
+	}
+
+	handle(serverName: string, params: unknown): Promise<MCPElicitationResult> {
+		const run = this.#tail.then(
+			() => this.#ask(serverName, params),
+			() => this.#ask(serverName, params),
+		);
+		this.#tail = run.catch(() => undefined);
+		return run;
+	}
+
+	async #ask(serverName: string, params: unknown): Promise<MCPElicitationResult> {
+		const request = params as Partial<MCPElicitationParams> | null;
+		if (typeof request !== "object" || request === null || typeof request.message !== "string") {
+			throw Object.assign(new Error("elicitation/create needs a message."), { code: JSON_RPC_INVALID_PARAMS });
+		}
+		if (request.mode !== undefined && request.mode !== "form") {
+			// Only form mode is declared. A server that sends another mode gets a clear refusal.
+			throw Object.assign(new Error(`Elicitation mode "${String(request.mode)}" is not supported.`), {
+				code: JSON_RPC_INVALID_PARAMS,
+			});
+		}
+		const ui = this.#ui;
+		if (!ui) return { action: "cancel" };
+		try {
+			return await runElicitationForm(ui, serverName, request as MCPElicitationParams);
+		} catch (error) {
+			if (error instanceof ElicitationSchemaError) throw error;
+			// A failing dialog is not an answer.
+			return { action: "cancel" };
+		}
+	}
+}
