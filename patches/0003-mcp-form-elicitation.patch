+			{ message: "Delete it?", requestedSchema: { type: "object", properties: {} } },
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "decline" });
+	});
+
+	it("cancels, never accepts, when the dialog is dismissed", async () => {
+		const broker = new ElicitationBroker();
+		broker.setUI(scriptedDialogs([undefined]).dialogs);
+		const { reply } = await askThroughServer(
+			{ message: "Delete it?", requestedSchema: { type: "object", properties: {} } },
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "cancel" });
+	});
+
+	it("cancels when there is no screen to ask on", async () => {
+		const broker = new ElicitationBroker();
+		const { reply } = await askThroughServer(
+			{ message: "Delete it?", requestedSchema: { type: "object", properties: {} } },
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "cancel" });
+	});
+
+	it("cancels when the dialog throws", async () => {
+		const broker = new ElicitationBroker();
+		broker.setUI({
+			select: async () => {
+				throw new Error("the screen went away");
+			},
+			input: async () => undefined,
+			notify: () => {},
+		});
+		const { reply } = await askThroughServer(
+			{ message: "Delete it?", requestedSchema: { type: "object", properties: {} } },
+			broker,
+		);
+		expect(reply.result).toEqual({ action: "cancel" });
+	});
+
+	it("collects typed answers, rejects bad ones, and asks again", async () => {
+		const broker = new ElicitationBroker();
+		const ui = scriptedDialogs(
+			["Answer the questions", "Production", "Yes", "Submit"],
+			["abc", "7.5", "7", "me@example.com"],
+		);
+		broker.setUI(ui.dialogs);
+		const { reply } = await askThroughServer(
+			{
+				message: "Provision a database",
+				requestedSchema: {
+					type: "object",
+					properties: {
+						replicas: { type: "integer", title: "Replicas", minimum: 1, maximum: 9 },
+						env: {
+							type: "string",
+							title: "Environment",
+							oneOf: [
+								{ const: "prod", title: "Production" },
+								{ const: "dev", title: "Development" },
+							],
+						},
+						backups: { type: "boolean", title: "Enable backups" },
+						owner: { type: "string", title: "Owner email", format: "email" },
