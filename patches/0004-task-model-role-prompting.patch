diff --git a/packages/coding-agent/test/task/task-model-roles-prompt.test.ts b/packages/coding-agent/test/task/task-model-roles-prompt.test.ts
new file mode 100644
index 0000000000..008d7fa6cc
--- /dev/null
+++ b/packages/coding-agent/test/task/task-model-roles-prompt.test.ts
@@ -0,0 +1,41 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { TaskTool } from "@oh-my-pi/pi-coding-agent/task";
+import * as discoveryModule from "@oh-my-pi/pi-coding-agent/task/discovery";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+
+const ROLES = { haiku: "anthropic/claude-haiku-5-5", sonnet: "anthropic/claude-sonnet-5-5" };
+
+async function describeTool(overrides: Record<string, unknown>): Promise<string> {
+	vi.spyOn(discoveryModule, "discoverAgents").mockResolvedValue({
+		agents: [{ name: "task", description: "General-purpose task agent", systemPrompt: "s", source: "bundled" }],
+		projectAgentsDir: null,
+	});
+	const session = {
+		cwd: "/tmp/omp-task-model-roles-prompt",
+		hasUI: false,
+		settings: Settings.isolated({ modelRoles: ROLES, ...overrides }),
+		getSessionFile: () => null,
+		getSessionSpawns: () => "*",
+		getSessionAgents: () => [],
+	} as unknown as ToolSession;
+	return (await TaskTool.create(session)).description;
+}
+
+describe("task description model roles", () => {
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	it("shows the operator's roles as @role with their models when per-call models are on", async () => {
+		const description = await describeTool({ "task.perCallModel": "on" });
+		expect(description).toContain("`@haiku` = `anthropic/claude-haiku-5-5`");
+		expect(description).toContain("`@sonnet` = `anthropic/claude-sonnet-5-5`");
+	});
+
+	it("does not mention roles or `model` when per-call models are off", async () => {
+		const description = await describeTool({ "task.perCallModel": "off" });
+		expect(description).not.toContain("@haiku");
+		expect(description).not.toContain("`model`:");
+	});
+});
