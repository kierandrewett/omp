+import { existsSync } from "node:fs";
+import { Database } from "bun:sqlite";
+import { getStatsDbPath, logger } from "@oh-my-pi/pi-utils";
+
+/** How many requests each model served, read from the stats database. */
+export interface ModelUsage {
+	/** Requests across every model in the window. */
+	total: number;
+	/** Requests per `provider/model-id`. */
+	byModel: ReadonlyMap<string, number>;
+}
+
+export const EMPTY_MODEL_USAGE: ModelUsage = { total: 0, byModel: new Map() };
+
+/** Only recent history counts: a model you stopped using should fade out of the ranking. */
+export const MODEL_USAGE_WINDOW_DAYS = 90;
+const CACHE_TTL_MS = 10 * 60 * 1000;
+
+export interface LoadModelUsageOptions {
+	dbPath?: string;
+	now?: number;
+	windowDays?: number;
+}
+
+let cached: { key: string; at: number; usage: ModelUsage } | undefined;
+
+/**
+ * Per-model request counts from `stats.db`, read-only, cached for ten minutes.
+ * Missing, locked or unreadable history gives an empty result, so usage never blocks or breaks routing.
+ * The database is only as fresh as the last `omp stats` sync; for a ranking that is enough.
+ */
+export function loadModelUsage(options: LoadModelUsageOptions = {}): ModelUsage {
+	const dbPath = options.dbPath ?? getStatsDbPath();
+	const now = options.now ?? Date.now();
+	const windowDays = options.windowDays ?? MODEL_USAGE_WINDOW_DAYS;
+	const key = `${dbPath}:${windowDays}`;
+	if (cached && cached.key === key && now - cached.at < CACHE_TTL_MS) return cached.usage;
+	const usage = readModelUsage(dbPath, now - windowDays * 24 * 60 * 60 * 1000);
+	cached = { key, at: now, usage };
+	return usage;
+}
+
+function readModelUsage(dbPath: string, since: number): ModelUsage {
+	if (!existsSync(dbPath)) return EMPTY_MODEL_USAGE;
+	let db: Database | undefined;
+	try {
+		db = new Database(dbPath, { readonly: true });
+		// The hourly rollup holds the same counts as the raw per-request rows in a few thousand rows instead of
+		// hundreds of thousands. The raw table takes about a second to scan, and this read is synchronous.
+		const rows = db
+			.query(
+				"SELECT provider, model, SUM(requests) AS requests FROM message_rollup WHERE bucket >= ? GROUP BY provider, model",
+			)
+			.all(since) as { provider: string; model: string; requests: number }[];
+		const byModel = new Map<string, number>();
+		let total = 0;
+		for (const row of rows) {
+			byModel.set(`${row.provider}/${row.model}`, row.requests);
+			total += row.requests;
+		}
+		return { total, byModel };
+	} catch (error) {
+		logger.debug("Could not read model usage from the stats database", { error: String(error) });
+		return EMPTY_MODEL_USAGE;
+	} finally {
+		db?.close();
+	}
+}
+
+/** Forget the cached counts. Tests use this; production code lets the cache expire. */
+export function resetModelUsageCache(): void {
+	cached = undefined;
+}
