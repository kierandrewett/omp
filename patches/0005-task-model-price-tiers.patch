diff --git a/packages/coding-agent/src/task/model-economy.ts b/packages/coding-agent/src/task/model-economy.ts
new file mode 100644
index 0000000000..4b8a2d6e56
--- /dev/null
+++ b/packages/coding-agent/src/task/model-economy.ts
@@ -0,0 +1,187 @@
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import { modelKind } from "@oh-my-pi/pi-catalog/types";
+import type { ModelRegistry } from "../config/model-registry";
+import { resolveRoleChain } from "../config/model-resolver";
+import { MODEL_ROLE_IDS, roleCandidatePool } from "../config/model-roles";
+import type { Settings } from "../config/settings";
+import type { PerCallModelAdvertisement } from "./model-approval";
+import type { ModelUsage } from "./model-usage";
+
+/** One to four dollar signs. `$` is the cheapest quarter of all loaded chat models, `$$$$` the dearest. */
+export type PriceTier = 1 | 2 | 3 | 4;
+
+export const PRICE_TIERS: readonly PriceTier[] = [1, 2, 3, 4];
+
+/**
+ * Every chat model the registry has loaded, whether or not you have credentials for it. The tier scale is
+ * the split across this whole set, so a tier means the same thing whichever providers you signed in to.
+ * Other kinds are priced per image or per second, which is not comparable.
+ */
+function loadedChatModels(registry: Pick<ModelRegistry, "getAll">): Model<Api>[] {
+	return registry.getAll().filter(model => modelKind(model) === "chat");
+}
+
+/** How much each level of evidence about a model counts. A hit on the exact model ID outweighs its family, and a family outweighs its provider. */
+export const USAGE_WEIGHTS = { exact: 0.6, family: 0.3, provider: 0.1 } as const;
+
+export function formatTier(tier: PriceTier): string {
+	return "$".repeat(tier);
+}
+
+/** A selector made only of one to four `$`, or undefined. */
+export function parseTier(selector: unknown): PriceTier | undefined {
+	if (typeof selector !== "string") return undefined;
+	const match = /^\${1,4}$/.exec(selector.trim());
+	return match ? (match[0].length as PriceTier) : undefined;
+}
+
+/** Input plus output price per million tokens. Zero means unknown: free tiers, subscriptions and local models all read zero. */
+function blendedPrice(model: Pick<Model<Api>, "cost">): number {
+	return model.cost.input + model.cost.output;
+}
+
+/** The three blended-price cut points between the four tiers. */
+export interface TierScale {
+	cuts: readonly [number, number, number];
+}
+
+/**
+ * Split the priced models into quarters by blended price. Unpriced models do not shape the scale, and
+ * a model's tier is how many cut points its price exceeds, so equal prices always share a tier.
+ * Undefined with no priced model at all.
+ */
+export function buildTierScale(models: readonly Pick<Model<Api>, "cost">[]): TierScale | undefined {
+	const prices = models.map(blendedPrice).filter(price => price > 0);
+	if (prices.length === 0) return undefined;
+	prices.sort((a, b) => a - b);
+	const at = (quantile: number): number => prices[Math.max(0, Math.ceil(prices.length * quantile) - 1)];
+	return { cuts: [at(0.25), at(0.5), at(0.75)] };
+}
+
+export function tierOf(scale: TierScale | undefined, model: Pick<Model<Api>, "cost">): PriceTier | undefined {
+	const price = blendedPrice(model);
+	if (!scale || !(price > 0)) return undefined;
+	return (1 + scale.cuts.filter(cut => price > cut).length) as PriceTier;
+}
+
+/** The model line without its trailing version, date or `latest` parts: `claude-haiku-5-5` and `claude-haiku-5` share `claude-haiku`. */
+export function modelFamily(id: string): string {
+	return id.replace(/(?:[-_.:]v?\d+(?:\.\d+)*|[-_.:](?:latest|preview))+$/i, "") || id;
+}
+
+/**
+ * Share of recent requests that hit this model, weighted by how specific the evidence is: requests on
+ * the exact `provider/model-id` count most, requests on the same model family next, and requests on the
+ * same provider least. 0 with no history. Always between 0 and 1.
+ */
+export function usageScore(usage: ModelUsage, model: Pick<Model<Api>, "provider" | "id">): number {
+	if (usage.total <= 0) return 0;
+	const family = modelFamily(model.id);
+	let exact = 0;
+	let sameFamily = 0;
+	let sameProvider = 0;
+	for (const [key, requests] of usage.byModel) {
+		const split = key.indexOf("/");
+		if (key.slice(0, split) !== model.provider) continue;
+		sameProvider += requests;
+		const id = key.slice(split + 1);
+		if (modelFamily(id) === family) sameFamily += requests;
+		if (id === model.id) exact += requests;
+	}
+	const score =
+		USAGE_WEIGHTS.exact * (exact / usage.total) +
+		USAGE_WEIGHTS.family * (sameFamily / usage.total) +
+		USAGE_WEIGHTS.provider * (sameProvider / usage.total);
+	return Math.min(1, score);
+}
+
+/** A configured model role and what it costs and how much it is used. */
+export interface RoleEconomy {
+	role: string;
+	/** The configured selector as written. */
+	selector: string;
+	model: Model<Api>;
+	tier: PriceTier | undefined;
+	/** See {@link usageScore}. */
+	usage: number;
+}
+
+/**
+ * The configured aliases that resolve to a usable model, with price tier and usage. Built-in semantic
+ * roles are routing policies, not model choices, so they are left out. An alias that fails to resolve
+ * is skipped so it cannot stop another from routing.
+ */
+export function describeConfiguredRoles(settings: Settings, registry: ModelRegistry, usage: ModelUsage): RoleEconomy[] {
+	const scale = buildTierScale(loadedChatModels(registry));
+	const roles: RoleEconomy[] = [];
+	for (const [role, selector] of Object.entries(settings.getModelRoles())) {
+		if (!selector?.trim() || MODEL_ROLE_IDS.some(id => id === role)) continue;
+		try {
+			const chain = resolveRoleChain(role, settings, roleCandidatePool(role, settings, registry));
+			if (chain.length === 0) continue;
+			const model = chain[0].model;
+			roles.push({ role, selector, model, tier: tierOf(scale, model), usage: usageScore(usage, model) });
+		} catch {
+			// Skipped on purpose; see above.
+		}
+	}
+	return roles;
+}
+
+/**
+ * The role to use for a requested tier: the role in that tier, or in the nearest tier when there is
+ * none (the cheaper side wins a tie). Among roles in the chosen tier, the most used one wins, then the
+ * name for a stable order. Undefined when no role has a known price.
+ */
+export function pickRoleForTier(tier: PriceTier, roles: readonly RoleEconomy[]): RoleEconomy | undefined {
+	const priced = roles.filter((entry): entry is RoleEconomy & { tier: PriceTier } => entry.tier !== undefined);
+	if (priced.length === 0) return undefined;
+	const distance = (entry: { tier: PriceTier }): number => Math.abs(entry.tier - tier);
+	const nearest = Math.min(...priced.map(distance));
+	const candidates = priced.filter(entry => distance(entry) === nearest);
+	const cheapest = Math.min(...candidates.map(entry => entry.tier));
+	return candidates
+		.filter(entry => entry.tier === cheapest)
+		.sort((a, b) => b.usage - a.usage || a.role.localeCompare(b.role))[0];
+}
+
+/** An advertised role plus its price tier, when its model has a price. */
+export interface TieredRole {
+	role: string;
+	patterns: string[];
+	tier?: string;
+}
+
+/** The advertisement with a tier on each role whose first resolvable selector has a known price. */
+export type TieredModelAdvertisement = Omit<PerCallModelAdvertisement, "roles"> & { roles: TieredRole[] };
+
+/** The catalog model an advertised selector names, ignoring a `:level` and an `@upstream` pin. */
+function findModel(pattern: string, models: readonly Model<Api>[]): Model<Api> | undefined {
+	const withoutLevel = pattern.replace(/:[A-Za-z]+$/, "");
+	const withoutPin = withoutLevel.replace(/@[^@/]*$/, "");
+	for (const candidate of [pattern, withoutLevel, withoutPin]) {
+		const model = models.find(entry => `${entry.provider}/${entry.id}` === candidate);
+		if (model) return model;
+	}
+	return undefined;
+}
+
+/** Add a tier to each advertised role. Reads the catalog for prices only; it never widens what is advertised. */
+export function tierAdvertisedRoles(
+	advertisement: PerCallModelAdvertisement,
+	registry: Pick<ModelRegistry, "getAll"> | undefined,
+): TieredModelAdvertisement {
+	if (!registry) return advertisement;
+	const models = loadedChatModels(registry);
+	const scale = buildTierScale(models);
+	const roles = advertisement.roles.map((entry): TieredRole => {
+		for (const pattern of entry.patterns) {
+			const model = findModel(pattern, models);
+			if (!model) continue;
+			const tier = tierOf(scale, model);
+			return tier === undefined ? entry : { ...entry, tier: formatTier(tier) };
+		}
+		return entry;
+	});
+	return { ...advertisement, roles };
+}
