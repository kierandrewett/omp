@@ -0,0 +1,78 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import type { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import * as judgmentModule from "@oh-my-pi/pi-coding-agent/judgment";
+import { classifyAutoTaskModel } from "@oh-my-pi/pi-coding-agent/task/auto-model";
+import * as modelUsageModule from "@oh-my-pi/pi-coding-agent/task/model-usage";
+
+// Blended prices 2, 4, ... 16: m1 is in the cheapest quarter, m7 in the dearest.
+const LADDER = [1, 2, 3, 4, 5, 6, 7, 8].map(step =>
+	createMockModel({ id: `m${step}`, cost: { input: step, output: step, cacheRead: 0, cacheWrite: 0 } }),
+);
+
+const registry = { getAll: () => LADDER, getAvailable: () => LADDER } as unknown as ModelRegistry;
+
+/** Stand in for the native judge: record what it is shown and answer with `choice`. */
+function stubJudge(choice: string): { shown: () => Record<string, string> } {
+	let state: Record<string, string> = {};
+	vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(true);
+	vi.spyOn(judgmentModule, "resolveJudge").mockReturnValue({
+		withCandidate: async (
+			run: (
+				candidate: { judge: (input: { state: Record<string, string> }) => Promise<unknown> },
+				kind: string,
+			) => Promise<unknown>,
+		) =>
+			run(
+				{
+					judge: async input => {
+						state = input.state;
+						const other = choice === "haiku" ? "sonnet" : "haiku";
+						return {
+							answers: {
+								model: { choice, confidence: 0.9, probabilities: { [choice]: 0.9, [other]: 0.1 } },
+							},
+						};
+					},
+				},
+				"native",
+			),
+	} as never);
+	return { shown: () => state };
+}
+
+describe("automatic task model selection", () => {
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	it("shows the judge each role's price tier and its weighted share of your recent use", async () => {
+		// All use is on m7. haiku (m1) shares only the provider with it; sonnet (m7) is the exact model.
+		vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue({
+			total: 100,
+			byModel: new Map([["mock/m7", 100]]),
+		});
+		const judge = stubJudge("haiku");
+		const decision = await classifyAutoTaskModel({
+			settings: Settings.isolated({ modelRoles: { haiku: "mock/m1", sonnet: "mock/m7" } }),
+			registry,
+			task: "Rename a variable across three files.",
+		});
+		expect(decision).toEqual({ role: "@haiku", fallback: false });
+		expect(JSON.parse(judge.shown().role_tiers)).toEqual({ haiku: "$", sonnet: "$$$$" });
+		expect(JSON.parse(judge.shown().role_usage_percent)).toEqual({ haiku: 10, sonnet: 100 });
+	});
+
+	it("leaves roles with no known price out of the tiers instead of calling them cheap", async () => {
+		vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue(modelUsageModule.EMPTY_MODEL_USAGE);
+		const free = [...LADDER, createMockModel({ id: "free" })];
+		const judge = stubJudge("sonnet");
+		await classifyAutoTaskModel({
+			settings: Settings.isolated({ modelRoles: { haiku: "mock/free", sonnet: "mock/m7" } }),
+			registry: { getAll: () => free, getAvailable: () => free } as unknown as ModelRegistry,
+			task: "Plan a database migration.",
+		});
+		expect(JSON.parse(judge.shown().role_tiers)).toEqual({ sonnet: "$$$$" });
+	});
+});
