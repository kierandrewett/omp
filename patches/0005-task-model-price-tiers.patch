@@ -0,0 +1,67 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import { Database } from "bun:sqlite";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { loadModelUsage, resetModelUsageCache } from "@oh-my-pi/pi-coding-agent/task/model-usage";
+
+const DAY = 24 * 60 * 60 * 1000;
+const NOW = Date.UTC(2026, 10, 1);
+
+describe("loadModelUsage", () => {
+	let dir: string;
+	let dbPath: string;
+
+	beforeEach(async () => {
+		resetModelUsageCache();
+		dir = await fs.mkdtemp(path.join(os.tmpdir(), "omp-model-usage-"));
+		dbPath = path.join(dir, "stats.db");
+	});
+
+	afterEach(async () => {
+		resetModelUsageCache();
+		await fs.rm(dir, { recursive: true, force: true });
+	});
+
+	function seed(rows: [provider: string, model: string, ageDays: number, requests?: number][]): void {
+		const db = new Database(dbPath);
+		db.run(
+			"CREATE TABLE message_rollup (bucket INTEGER NOT NULL, provider TEXT NOT NULL, model TEXT NOT NULL, requests INTEGER NOT NULL)",
+		);
+		for (const [provider, model, ageDays, requests = 1] of rows) {
+			db.run("INSERT INTO message_rollup (bucket, provider, model, requests) VALUES (?, ?, ?, ?)", [
+				NOW - ageDays * DAY,
+				provider,
+				model,
+				requests,
+			]);
+		}
+		db.close();
+	}
+
+	it("counts requests per provider/model inside the window only", () => {
+		seed([
+			["anthropic", "claude-haiku-5-5", 1],
+			["anthropic", "claude-haiku-5-5", 30],
+			["anthropic", "claude-haiku-5-5", 120],
+			["openai", "gpt-5.5", 2],
+		]);
+		const usage = loadModelUsage({ dbPath, now: NOW, windowDays: 90 });
+		expect(usage.total).toBe(3);
+		expect(Object.fromEntries(usage.byModel)).toEqual({ "anthropic/claude-haiku-5-5": 2, "openai/gpt-5.5": 1 });
+	});
+
+	it("gives no usage, and no error, when the database is missing or is not a stats database", async () => {
+		expect(loadModelUsage({ dbPath, now: NOW }).total).toBe(0);
+		resetModelUsageCache();
+		await Bun.write(dbPath, "not a database");
+		expect(loadModelUsage({ dbPath, now: NOW }).total).toBe(0);
+	});
+
+	it("does not write to the database it reads", async () => {
+		seed([["anthropic", "claude-haiku-5-5", 1]]);
+		const before = await Bun.file(dbPath).bytes();
+		loadModelUsage({ dbPath, now: NOW });
+		expect(await Bun.file(dbPath).bytes()).toEqual(before);
+	});
+});
