@@ -0,0 +1,175 @@
+import { describe, expect, it } from "bun:test";
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import type { PerCallModelAdvertisement } from "@oh-my-pi/pi-coding-agent/task/model-approval";
+import {
+	buildTierScale,
+	modelFamily,
+	parseTier,
+	pickRoleForTier,
+	type RoleEconomy,
+	tierAdvertisedRoles,
+	tierOf,
+	usageScore,
+} from "@oh-my-pi/pi-coding-agent/task/model-economy";
+import type { ModelUsage } from "@oh-my-pi/pi-coding-agent/task/model-usage";
+
+function priced(id: string, input: number, output: number, provider = "mock"): Model<Api> {
+	return createMockModel({ id, provider, cost: { input, output, cacheRead: 0, cacheWrite: 0 } });
+}
+
+function usage(counts: Record<string, number>): ModelUsage {
+	const byModel = new Map(Object.entries(counts));
+	return { total: [...byModel.values()].reduce((sum, requests) => sum + requests, 0), byModel };
+}
+
+describe("price tiers", () => {
+	// Blended prices 2, 4, 6, 8, 10, 12, 14, 16: two models per quarter.
+	const models = [1, 2, 3, 4, 5, 6, 7, 8].map(step => priced(`m${step}`, step, step));
+
+	it("splits the priced models into quarters of the whole set", () => {
+		const scale = buildTierScale(models);
+		expect(models.map(model => tierOf(scale, model))).toEqual([1, 1, 2, 2, 3, 3, 4, 4]);
+	});
+
+	it("leaves free and unpriced models out of the scale and out of every tier", () => {
+		const free = priced("free", 0, 0);
+		const scale = buildTierScale([...models, free, free, free, free]);
+		expect(models.map(model => tierOf(scale, model))).toEqual([1, 1, 2, 2, 3, 3, 4, 4]);
+		expect(tierOf(scale, free)).toBeUndefined();
+		expect(buildTierScale([free])).toBeUndefined();
+	});
+
+	it("puts equal prices in the same tier", () => {
+		const same = [priced("a", 3, 3), priced("b", 3, 3), priced("c", 3, 3), priced("d", 3, 3)];
+		const scale = buildTierScale(same);
+		expect(new Set(same.map(model => tierOf(scale, model))).size).toBe(1);
+	});
+
+	it("reads only one to four dollar signs as a tier", () => {
+		expect(["$", "$$", " $$$ ", "$$$$"].map(parseTier)).toEqual([1, 2, 3, 4]);
+		for (const rejected of ["", "$$$$$", "@haiku", "$ $", "haiku", undefined, 2]) {
+			expect(parseTier(rejected)).toBeUndefined();
+		}
+	});
+});
+
+describe("usage score", () => {
+	const history = usage({
+		"anthropic/claude-haiku-5-5": 60,
+		"anthropic/claude-haiku-5": 10,
+		"anthropic/claude-opus-5-5": 20,
+		"openai/gpt-5.5": 10,
+	});
+
+	it("groups ids into a family by dropping trailing versions", () => {
+		expect(modelFamily("claude-haiku-5-5")).toBe("claude-haiku");
+		expect(modelFamily("claude-haiku-5")).toBe("claude-haiku");
+		expect(modelFamily("claude-sonnet-4.5-latest")).toBe("claude-sonnet");
+		expect(modelFamily("gpt-5.6-luna")).toBe("gpt-5.6-luna");
+	});
+
+	it("counts the exact model ID above its family, its family above its provider, and an unused provider at zero", () => {
+		const exact = usageScore(history, { provider: "anthropic", id: "claude-haiku-5-5" });
+		// Never used itself, but a sibling in the same family was.
+		const family = usageScore(history, { provider: "anthropic", id: "claude-haiku-6" });
+		// Never used, and no sibling; the provider was.
+		const provider = usageScore(history, { provider: "anthropic", id: "claude-sonnet-5" });
+		const none = usageScore(history, { provider: "xai", id: "grok-4.6" });
+		expect(exact).toBeGreaterThan(family);
+		expect(family).toBeGreaterThan(provider);
+		expect(provider).toBeGreaterThan(none);
+		expect(none).toBe(0);
+	});
+
+	it("ranks a heavily used exact model above a lightly used one in the same family", () => {
+		const heavy = usageScore(history, { provider: "anthropic", id: "claude-haiku-5-5" });
+		const light = usageScore(history, { provider: "anthropic", id: "claude-haiku-5" });
+		expect(heavy).toBeGreaterThan(light);
+	});
+
+	it("is 0 with no history and never above 1", () => {
+		expect(usageScore({ total: 0, byModel: new Map() }, { provider: "a", id: "b" })).toBe(0);
+		const only = usage({ "a/b-1": 5 });
+		expect(usageScore(only, { provider: "a", id: "b-1" })).toBeLessThanOrEqual(1);
+	});
+});
+
+describe("picking a role for a tier", () => {
+	function role(name: string, tier: RoleEconomy["tier"], usageShare = 0): RoleEconomy {
+		return { role: name, selector: `mock/${name}`, model: priced(name, 1, 1), tier, usage: usageShare };
+	}
+
+	it("returns the role in the asked tier", () => {
+		const roles = [role("cheap", 1), role("mid", 2), role("best", 4)];
+		expect(pickRoleForTier(2, roles)?.role).toBe("mid");
+		expect(pickRoleForTier(4, roles)?.role).toBe("best");
+	});
+
+	it("falls back to the nearest tier, and the cheaper side wins a tie", () => {
+		const roles = [role("cheap", 1), role("dear", 3)];
+		expect(pickRoleForTier(2, roles)?.role).toBe("cheap");
+		expect(pickRoleForTier(4, roles)?.role).toBe("dear");
+	});
+
+	it("takes the most used role within a tier, then the name", () => {
+		expect(pickRoleForTier(2, [role("a", 2, 0.1), role("b", 2, 0.5)])?.role).toBe("b");
+		expect(pickRoleForTier(2, [role("b", 2, 0.3), role("a", 2, 0.3)])?.role).toBe("a");
+	});
+
+	it("ignores roles with no known price, and returns nothing when none has one", () => {
+		expect(pickRoleForTier(1, [role("free", undefined, 0.9), role("paid", 3)])?.role).toBe("paid");
+		expect(pickRoleForTier(1, [role("free", undefined)])).toBeUndefined();
+		expect(pickRoleForTier(1, [])).toBeUndefined();
+	});
+});
+
+describe("advertised role tiers", () => {
+	const advertisement: PerCallModelAdvertisement = {
+		roles: [
+			{ role: "haiku", patterns: ["mock/m1"] },
+			{ role: "opus", patterns: ["mock/m8:high"] },
+			{ role: "local", patterns: ["mock/free"] },
+			{ role: "ghost", patterns: ["mock/missing"] },
+		],
+		allowlist: [],
+		parentModelWithheld: false,
+	};
+	const models = [1, 2, 3, 4, 5, 6, 7, 8].map(step => priced(`m${step}`, step, step)).concat(priced("free", 0, 0));
+
+	it("adds a tier only to roles whose model has a price, ignoring a thinking level", () => {
+		const out = tierAdvertisedRoles(advertisement, { getAll: () => models });
+		expect(out.roles.map(entry => [entry.role, entry.tier])).toEqual([
+			["haiku", "$"],
+			["opus", "$$$$"],
+			["local", undefined],
+			["ghost", undefined],
+		]);
+	});
+
+	it("never changes which roles or patterns are advertised", () => {
+		const out = tierAdvertisedRoles(advertisement, { getAll: () => models });
+		expect(out.roles.map(({ role, patterns }) => ({ role, patterns }))).toEqual(advertisement.roles);
+		expect(tierAdvertisedRoles(advertisement, undefined)).toBe(advertisement);
+	});
+
+	it("splits across every loaded chat model, not only the ones you have credentials for", () => {
+		// Eight cheap models you can use and eight dearer ones you cannot: against the whole set, m8 is only mid-range.
+		const unusable = [20, 30, 40, 50, 60, 70, 80, 90].map(step => priced(`far${step}`, step, step, "elsewhere"));
+		const usable = models.slice(0, 8);
+		const out = tierAdvertisedRoles(advertisement, {
+			getAll: () => [...usable, ...unusable],
+			getAvailable: () => usable,
+		} as Parameters<typeof tierAdvertisedRoles>[1]);
+		expect(out.roles.find(entry => entry.role === "opus")?.tier).toBe("$$");
+	});
+
+	it("leaves image and other non-chat models out of the scale", () => {
+		const images = [100, 200, 300, 400].map(step => ({
+			...priced(`image${step}`, step, step),
+			kind: "image" as const,
+		}));
+		const out = tierAdvertisedRoles(advertisement, { getAll: () => [...models, ...images] });
+		expect(out.roles.find(entry => entry.role === "opus")?.tier).toBe("$$$$");
+	});
+});
