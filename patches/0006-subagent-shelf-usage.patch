+/** Columns between a shelf row's title and its usage, and the least title width worth sharing a row with it. */
+const SUBAGENT_USAGE_GAP = 2;
+const SUBAGENT_USAGE_MIN_TITLE_WIDTH = 24;
+
+/**
+ * Total tokens and API cost of one subagent, e.g. `1.4M tok · $0.42`. Tokens are everything the model
+ * processed, cache reads included, so the figure matches what the provider counts. Cost shows only once it is
+ * above zero, because a subscription or unpriced model reports zero and `$0.00` would read as free. Empty until
+ * the subagent has used either.
+ */
+export function formatSubagentUsage(progress: AgentProgress | undefined): string {
+	if (!progress) return "";
+	const parts: string[] = [];
+	const tokens = progress.tokens + (progress.cacheReadTokens ?? 0);
+	if (tokens > 0) parts.push(`${formatNumber(tokens)} tok`);
+	if (progress.cost > 0) parts.push(formatCost(progress.cost));
+	return parts.join(theme.sep.dot);
+}
