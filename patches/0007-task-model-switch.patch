+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.pendingModelSwitch).toBeUndefined();
+		} finally {
+			harness.releaseFirstRequest();
+			await harness.run;
+			harness.close();
+		}
+	}, 15_000);
+
+	it("changes nothing when the control URL is only read", async () => {
+		const harness = await startSubagent();
+		try {
+			await expect(
+				new ProcProtocolHandler().resolve(parseInternalUrl(`proc://${CHILD_ID}/model`), {
+					session: harness.parent,
+				}),
+			).rejects.toThrow(/write-only/);
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.pendingModelSwitch).toBeUndefined();
+		} finally {
+			harness.releaseFirstRequest();
+			await harness.run;
+			harness.close();
+		}
+	}, 15_000);
+
+	it("is refused while task.perCallModel is off", async () => {
+		const harness = await startSubagent({ settings: { "task.perCallModel": "off" } });
+		try {
+			await expect(writeModel(harness, CHILD_ID, "@haiku")).rejects.toThrow(/task\.perCallModel/);
+			harness.releaseFirstRequest();
+			await harness.run;
+			expect(loopRequests(harness.models.haiku)).toBe(0);
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("refuses an unknown agent id", async () => {
+		const harness = await startSubagent();
+		try {
+			await expect(writeModel(harness, "NoSuchAgent", "@haiku")).rejects.toThrow(/not found/);
+		} finally {
+			harness.releaseFirstRequest();
+			await harness.run;
+			harness.close();
+		}
+	}, 15_000);
+
+	it("refuses an agent this caller did not spawn", async () => {
+		const harness = await startSubagent();
+		try {
+			const stranger = { ...harness.parent, getAgentId: () => "Stranger" } as ToolSession;
+			await expect(
+				new ProcProtocolHandler().write(parseInternalUrl(`proc://${CHILD_ID}/model`), "@haiku", {
+					session: stranger,
+				}),
+			).rejects.toThrow(/not spawned by you/);
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.pendingModelSwitch).toBeUndefined();
+		} finally {
+			harness.releaseFirstRequest();
+			await harness.run;
+			harness.close();
+		}
+	}, 15_000);
+
+	it("refuses a subagent that has already finished, leaving its model alone", async () => {
+		const harness = await startSubagent();
+		try {
+			harness.releaseFirstRequest();
+			await harness.run;
+			const ref = AgentRegistry.global().get(CHILD_ID);
+			expect(ref?.status).not.toBe("running");
+			const before = ref?.session?.model?.id;
+			await expect(writeModel(harness, CHILD_ID, "@haiku")).rejects.toThrow(/not running/);
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.model?.id).toBe(before);
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.pendingModelSwitch).toBeUndefined();
