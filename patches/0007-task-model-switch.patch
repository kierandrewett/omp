@@ -0,0 +1,461 @@
+/**
+ * A running subagent's model changes mid-run without restarting it: the request in flight finishes
+ * on its current model and the next one uses the new model, with the subagent's context intact.
+ *
+ * The parent agent's route (`write proc://<id>/model`) is held to the approval a task `model` passes;
+ * the user's route (the subagent's own view) is not.
+ *
+ * Failure mode if this regresses: a switch lands on the wrong agent, aborts the turn, is silently
+ * ignored by the next request, lets the model-facing route reach a model the operator never granted,
+ * or leaves a per-call worker failing its own dispatch gate on a model the user chose.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import type { Context, Model } from "@oh-my-pi/pi-ai";
+import { unregisterCustomApis } from "@oh-my-pi/pi-ai/api-registry";
+import { createMockModel, type MockModel, type MockResponse, registerMockApi } from "@oh-my-pi/pi-ai/providers/mock";
+import { closeModelCache } from "@oh-my-pi/pi-catalog/model-cache";
+import { AsyncJobManager } from "@oh-my-pi/pi-coding-agent/async/job-manager";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { getModelMatchPreferences } from "@oh-my-pi/pi-coding-agent/config/model-resolver";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { parseInternalUrl } from "@oh-my-pi/pi-coding-agent/internal-urls/parse";
+import { ProcProtocolHandler } from "@oh-my-pi/pi-coding-agent/internal-urls/proc-protocol";
+import { IrcBus } from "@oh-my-pi/pi-coding-agent/irc/bus";
+import { AgentLifecycleManager } from "@oh-my-pi/pi-coding-agent/registry/agent-lifecycle";
+import { AgentRegistry } from "@oh-my-pi/pi-coding-agent/registry/agent-registry";
+import { AgentStorage } from "@oh-my-pi/pi-coding-agent/session/agent-storage";
+import { extractSessionInit } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { runSubprocess } from "@oh-my-pi/pi-coding-agent/task/executor";
+import type { PerCallModelGrants } from "@oh-my-pi/pi-coding-agent/task/model-approval";
+import * as modelUsageModule from "@oh-my-pi/pi-coding-agent/task/model-usage";
+import { switchSubagentModelAsOperator } from "@oh-my-pi/pi-coding-agent/task/subagent-model-policy";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import { __resetDirsFromEnvForTests, removeWithRetries, setAgentDir } from "@oh-my-pi/pi-utils";
+import { createInMemoryAuthStorage } from "../helpers/agent-session-setup";
+
+const CHILD_ID = "RefactorWork";
+const PARENT_ID = "Main";
+const MOCK_API_SOURCE = "test/subagent-model-switch";
+const ENV_KEYS = ["HOME", "PI_CODING_AGENT_DIR", "OMP_PROFILE", "PI_PROFILE"] as const;
+
+let savedEnv: Record<string, string | undefined> = {};
+let root: string;
+let manager: AsyncJobManager;
+
+function restoreEnvValue(key: string, value: string | undefined): void {
+	if (value === undefined) {
+		delete process.env[key];
+		delete Bun.env[key];
+		return;
+	}
+	process.env[key] = value;
+	Bun.env[key] = value;
+}
+
+beforeEach(async () => {
+	savedEnv = Object.fromEntries(ENV_KEYS.map(key => [key, process.env[key]]));
+	root = await fs.mkdtemp(path.join(os.tmpdir(), "omp-subagent-model-switch-"));
+	const home = path.join(root, "home");
+	await fs.mkdir(home, { recursive: true });
+	restoreEnvValue("HOME", home);
+	vi.spyOn(os, "homedir").mockReturnValue(home);
+	setAgentDir(path.join(home, ".omp", "agent"));
+	AgentRegistry.resetGlobalForTests();
+	AgentLifecycleManager.resetGlobalForTests();
+	IrcBus.resetGlobalForTests();
+	registerMockApi(MOCK_API_SOURCE);
+	manager = new AsyncJobManager({ maxRunningJobs: 4 });
+	AsyncJobManager.setInstance(manager);
+});
+
+afterEach(async () => {
+	await AgentLifecycleManager.global().dispose();
+	AgentLifecycleManager.resetGlobalForTests();
+	AgentRegistry.resetGlobalForTests();
+	IrcBus.resetGlobalForTests();
+	AsyncJobManager.setInstance(undefined);
+	await manager.dispose({ timeoutMs: 1_000 });
+	unregisterCustomApis(MOCK_API_SOURCE);
+	vi.restoreAllMocks();
+	for (const key of ENV_KEYS) restoreEnvValue(key, savedEnv[key]);
+	__resetDirsFromEnvForTests();
+	AgentStorage.close();
+	closeModelCache();
+	await removeWithRetries(root);
+});
+
+/** Side requests (titles) carry no `yield` tool; only the agent loop's own requests do. */
+function isLoopRequest(context: Context): boolean {
+	return (context.tools ?? []).some(tool => tool.name === "yield");
+}
+
+function yieldResult(data: string): (context: Context) => MockResponse {
+	return context => {
+		if (!isLoopRequest(context)) return { content: ["label"] };
+		if (context.messages.at(-1)?.role === "toolResult") return { content: ["ok"] };
+		return { content: [{ type: "toolCall", name: "yield", arguments: { type: "result", data } }] };
+	};
+}
+
+interface Harness {
+	/** Models the subagent can run on; `primary` is where it starts. */
+	models: { primary: MockModel; haiku: MockModel; other: MockModel };
+	/** Resolves once the subagent's first loop request is being served by `primary`. */
+	firstRequestServing: Promise<void>;
+	/** Lets `primary` finish that first request (it then asks for one more turn). */
+	releaseFirstRequest(): void;
+	/** The subagent's run: settles when it yields. */
+	run: Promise<unknown>;
+	/** The tool session of the agent that spawned the subagent. */
+	parent: ToolSession;
+	settings: Settings;
+	modelRegistry: ModelRegistry;
+	close(): void;
+}
+
+/**
+ * Starts the subagent on `primary`, whose first loop request blocks and then asks for another turn,
+ * so the subagent is demonstrably mid-run when the test switches its model.
+ */
+async function startSubagent(
+	options: {
+		perCall?: boolean;
+		settings?: Record<string, unknown>;
+		/** A price for `haiku`, so a price tier can name it. Mock models are free, and a free model has no tier. */
+		haikuCost?: Model["cost"];
+	} = {},
+): Promise<Harness> {
+	const cwd = path.join(root, "home", "work");
+	const artifactsDir = path.join(root, "artifacts");
+	await fs.mkdir(cwd, { recursive: true });
+	await fs.mkdir(artifactsDir, { recursive: true });
+
+	const authStorage = createInMemoryAuthStorage();
+	authStorage.keys.setRuntime("mock", "test-key");
+	const modelRegistry = new ModelRegistry(authStorage);
+	const firstRequestServing = Promise.withResolvers<void>();
+	const releaseFirst = Promise.withResolvers<void>();
+	let loopRequests = 0;
+	const primary = createMockModel({
+		id: "primary",
+		handler: async context => {
+			if (!isLoopRequest(context)) return { content: ["label"] };
+			loopRequests++;
+			if (loopRequests === 1) {
+				firstRequestServing.resolve();
+				await releaseFirst.promise;
+				return { content: [{ type: "toolCall", name: "read", arguments: { path: "missing.txt" } }] };
+			}
+			return yieldResult("finished on primary")(context);
+		},
+	});
+	const haiku = createMockModel({
+		id: "haiku",
+		handler: yieldResult("finished on haiku"),
+		...(options.haikuCost ? { cost: options.haikuCost } : {}),
+	});
+	const other = createMockModel({ id: "other", handler: yieldResult("finished on other") });
+	const mocks = [primary, haiku, other];
+	const catalogAvailable = modelRegistry.getAvailable.bind(modelRegistry);
+	vi.spyOn(modelRegistry, "getAvailable").mockImplementation(kind => [...mocks, ...catalogAvailable(kind)]);
+	const catalogAll = modelRegistry.getAll.bind(modelRegistry);
+	vi.spyOn(modelRegistry, "getAll").mockImplementation(() => [...mocks, ...catalogAll()]);
+
+	// `other` is deliberately not a configured role: the operator has not granted it.
+	const settings = Settings.isolated({
+		"task.perCallModel": "on",
+		"task.agentIdleTtlMs": 0,
+		"compaction.enabled": false,
+		"retry.enabled": false,
+		"todo.enabled": false,
+		"todo.reminders": false,
+		"advisor.enabled": false,
+		modelRoles: { default: "mock/primary", haiku: "mock/haiku" },
+		...options.settings,
+	});
+	const perCallModelGrants: PerCallModelGrants | undefined = options.perCall
+		? {
+				settings,
+				agentName: "task",
+				agentSource: "bundled",
+				matchPreferences: structuredClone(getModelMatchPreferences(settings.grantAuthority())),
+			}
+		: undefined;
+	const run = runSubprocess({
+		cwd,
+		artifactsDir,
+		agent: { name: "task", description: "test", systemPrompt: "test", tools: ["read"], source: "bundled" },
+		task: "refactor",
+		index: 0,
+		id: CHILD_ID,
+		parentAgentId: PARENT_ID,
+		asyncJobManager: manager,
+		modelOverride: "mock/primary",
+		...(perCallModelGrants ? { perCallModelGrants } : {}),
+		authStorage,
+		modelRegistry,
+		settings,
+		enableLsp: false,
+		enableMCP: false,
+		enableIrc: false,
+	});
+	const parent = {
+		cwd,
+		hasUI: false,
+		getAgentId: () => PARENT_ID,
+		getSessionId: () => PARENT_ID,
+		getSessionFile: () => null,
+		asyncJobManager: manager,
+		agentRegistry: AgentRegistry.global(),
+		modelRegistry,
+		settings,
+	} as unknown as ToolSession;
+	await firstRequestServing.promise;
+	return {
+		models: { primary, haiku, other },
+		firstRequestServing: firstRequestServing.promise,
+		releaseFirstRequest: () => releaseFirst.resolve(),
+		run,
+		parent,
+		settings,
+		modelRegistry,
+		close: () => authStorage.close(),
+	};
+}
+
+/** Loop requests a mock model served; side requests such as titles are excluded. */
+function loopRequests(mock: MockModel): number {
+	return mock.calls.filter(call => isLoopRequest(call.context)).length;
+}
+
+function writeModel(harness: Harness, id: string, selector: string) {
+	return new ProcProtocolHandler().write(parseInternalUrl(`proc://${id}/model`), selector, {
+		session: harness.parent,
+	});
+}
+
+describe("the parent agent switching a running subagent's model", () => {
+	it("accepts a price tier and switches to the configured role in that tier", async () => {
+		vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue(modelUsageModule.EMPTY_MODEL_USAGE);
+		// Far below every priced catalog model, so `haiku` sits in the cheapest tier.
+		const harness = await startSubagent({ haikuCost: { input: 0.0001, output: 0.0001, cacheRead: 0, cacheWrite: 0 } });
+		try {
+			const result = await writeModel(harness, CHILD_ID, "$");
+			expect(result?.details?.proc).toMatchObject({
+				action: "model",
+				agent: CHILD_ID,
+				model: "mock/haiku",
+				state: "queued",
+			});
+			harness.releaseFirstRequest();
+			expect(await harness.run).toMatchObject({ exitCode: 0 });
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.model?.id).toBe("haiku");
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("serves the next request on the new model, keeping the turn and context", async () => {
+		const harness = await startSubagent();
+		try {
+			const result = await writeModel(harness, CHILD_ID, "@haiku");
+			expect(result?.details?.proc).toMatchObject({
+				action: "model",
+				agent: CHILD_ID,
+				model: "mock/haiku",
+				state: "queued",
+			});
+			// Nothing changed for the request in flight.
+			const session = AgentRegistry.global().get(CHILD_ID)?.session;
+			expect(session?.model?.id).toBe("primary");
+			expect(session?.pendingModelSwitch?.id).toBe("haiku");
+
+			harness.releaseFirstRequest();
+			const outcome = await harness.run;
+			expect(outcome).toMatchObject({ exitCode: 0 });
+
+			expect(loopRequests(harness.models.primary)).toBe(1);
+			expect(loopRequests(harness.models.haiku)).toBeGreaterThan(0);
+			// The second request carries the first request's turn: same transcript, new model.
+			const second = harness.models.haiku.calls.find(call => isLoopRequest(call.context));
+			expect(second?.context.messages.some(message => message.role === "assistant")).toBe(true);
+			expect(AgentRegistry.global().get(CHILD_ID)?.session?.model?.id).toBe("haiku");
+			expect(await Bun.file(path.join(root, "artifacts", `${CHILD_ID}.md`)).text()).toContain("finished on haiku");
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("records the switch in the subagent's transcript", async () => {
+		const harness = await startSubagent();
+		try {
+			await writeModel(harness, CHILD_ID, "mock/haiku");
+			harness.releaseFirstRequest();
+			await harness.run;
+			const entries = AgentRegistry.global().get(CHILD_ID)?.session?.sessionManager.getEntries() ?? [];
+			const changes = entries.filter(entry => entry.type === "model_change");
+			expect(changes.at(-1)).toMatchObject({ model: "mock/haiku" });
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("refuses a model the operator has not granted, and the subagent carries on unchanged", async () => {
+		const harness = await startSubagent();
+		try {
+			await expect(writeModel(harness, CHILD_ID, "mock/other")).rejects.toThrow(/not approved/);
