+
+describe("the user switching a subagent from its view", () => {
+	it("applies to that subagent at its next request, with no approval gate", async () => {
+		const harness = await startSubagent();
+		try {
+			const session = AgentRegistry.global().get(CHILD_ID)?.session;
+			if (!session) throw new Error("subagent has no live session");
+			// `other` is not granted to the model-facing route, yet the user may pick it.
+			expect(await switchSubagentModelAsOperator(session, harness.models.other)).toBe("queued");
+			expect(session.model?.id).toBe("primary");
+			harness.releaseFirstRequest();
+			await harness.run;
+			expect(loopRequests(harness.models.other)).toBeGreaterThan(0);
+			expect(session.model?.id).toBe("other");
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("keeps a per-call worker's dispatch gate open for the user's choice, and its revival on that model", async () => {
+		const harness = await startSubagent({ perCall: true });
+		try {
+			const session = AgentRegistry.global().get(CHILD_ID)?.session;
+			if (!session) throw new Error("subagent has no live session");
+			// The model-facing route still cannot reach it...
+			await expect(writeModel(harness, CHILD_ID, "mock/other")).rejects.toThrow(/not approved/);
+			// ...the user's choice is the operator's.
+			await switchSubagentModelAsOperator(session, harness.models.other);
+			harness.releaseFirstRequest();
+			expect(await harness.run).toMatchObject({ exitCode: 0 });
+			expect(loopRequests(harness.models.other)).toBeGreaterThan(0);
+			// Revival restores a per-call worker on the exact model it last ran on.
+			const init = extractSessionInit(session.sessionManager.getEntries());
+			expect(init?.perCallModelIdentity).toBe("mock/other");
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+
+	it("keeps refusing an unapproved model for a per-call worker's next request when nobody chose it", async () => {
+		const harness = await startSubagent({ perCall: true });
+		try {
+			await writeModel(harness, CHILD_ID, "@haiku");
+			harness.releaseFirstRequest();
+			expect(await harness.run).toMatchObject({ exitCode: 0 });
+			expect(loopRequests(harness.models.haiku)).toBeGreaterThan(0);
+		} finally {
+			harness.releaseFirstRequest();
+			harness.close();
+		}
+	}, 15_000);
+});
