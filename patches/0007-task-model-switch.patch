--- /dev/null
+++ b/packages/coding-agent/src/task/model-switch.ts
@@ -0,0 +1,133 @@
+/**
+ * The parent agent's switch of a running subagent's model (`write proc://<id>/model`).
+ *
+ * A model-facing caller is held to the approval a task `model` passes: `task.perCallModel` must be
+ * `on` for task calls, the selector is one configured `@role` or one exact `provider/model-id[:level]`,
+ * and the model must be an available chat model the operator's configuration grants
+ * ({@link assertPerCallModelApproved}, including `task.perCallModelAllow` and `task.maxEffort`). Only the
+ * agent that spawned the subagent may switch it, and only while it runs. The switch itself applies at
+ * the subagent's next model request ({@link AgentSession.switchModelAtNextRequest}); the user's own
+ * switch in the subagent's view is ungated ({@link switchSubagentModelAsOperator}).
+ */
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import { modelKind } from "@oh-my-pi/pi-catalog/types";
+import {
+	AUTO_THINKING,
+	assertModelSupportsEffortCeiling,
+	type ConfiguredThinkingLevel,
+	clampThinkingLevelToCeiling,
+} from "@oh-my-pi/pi-tui/thinking";
+import { getModelMatchPreferences, resolveModelOverride } from "../config/model-resolver";
+import type { ToolSession } from "../tools";
+import { assertPerCallModelApproved, parentModelGrantPattern, type PerCallModelGrants } from "./model-approval";
+import { cfgTaskMaxEffort, cfgTaskPerCallModel, perCallModelEnabled } from "./settings";
+import {
+	callerModelRole,
+	callerModelTier,
+	invalidModelSelectorReason,
+	resolveCallerRoleSelector,
+	resolveCallerTierSelector,
+} from "./structured-subagent";
+import { subagentModelPolicy } from "./subagent-model-policy";
+
+export interface SubagentModelSwitchOutcome {
+	id: string;
+	model: Model<Api>;
+	/** `applied`: the subagent was between requests and changed now; `queued`: it changes at its next request. */
+	state: "applied" | "queued";
+}
+
+/**
+ * Switch the running subagent `id`, spawned by `caller`, to the model `selector` names.
+ * Throws with a message for the caller when the request is refused; nothing changes then.
+ */
+export async function switchSubagentModelAsCaller(
+	caller: ToolSession,
+	id: string,
+	selector: string,
+): Promise<SubagentModelSwitchOutcome> {
+	const { settings, modelRegistry, agentRegistry: registry } = caller;
+	const ref = registry?.get(id);
+	if (ref?.kind !== "sub") throw new Error(`Subagent not found: ${id}`);
+	const ownerId = caller.getAgentId?.() ?? undefined;
+	if (ref.parentId !== ownerId) {
+		throw new Error(`Agent ${id} was not spawned by you; its model cannot be changed.`);
+	}
+	const session = ref.session;
+	if (ref.status !== "running" || !session) {
+		throw new Error(
+			`Agent ${id} is ${ref.status}, not running; its model was not changed. A model change applies to a running agent.`,
+		);
+	}
+	if (!perCallModelEnabled(settings, "task")) {
+		const operatorMode = cfgTaskPerCallModel.get(settings.grantAuthority());
+		const mode = cfgTaskPerCallModel.get(settings);
+		throw new Error(
+			`Changing a running agent's model is disabled (task.perCallModel: ${mode === operatorMode ? mode : `${operatorMode}, project: ${mode}`}); it takes the same approval as a task \`model\`.`,
+		);
+	}
+	const requested = selector.trim();
+	if (!requested) {
+		throw new Error(
+			"Give the model as content: one configured role such as @haiku, a price tier from $ to $$$$, or one exact provider/model-id[:level].",
+		);
+	}
+	const problem = invalidModelSelectorReason(requested, "The model", { settings, invocationKind: "task" });
+	if (problem) throw new Error(problem);
+	if (!modelRegistry) throw new Error("Cannot resolve a model without a model registry.");
+	if (modelRegistry.isBackgroundRefreshPending()) await modelRegistry.awaitBackgroundRefresh();
+	const tier = callerModelTier(requested, "task");
+	const exactSelector =
+		tier !== undefined
+			? await resolveCallerTierSelector({ session: caller }, tier)
+			: callerModelRole(requested, settings, "task")
+				? await resolveCallerRoleSelector({ session: caller }, requested)
+				: requested;
+	const available = modelRegistry.getAvailable("all");
+	const resolved = resolveModelOverride([exactSelector], { getAvailable: () => available }, settings, {
+		exactOnly: true,
+	});
+	const model = resolved.model;
+	if (!model) {
+		throw new Error(
+			`No available model matches ${JSON.stringify(exactSelector)}. Use an exact provider/model-id and a supported thinking level; do not substitute another model.`,
+		);
+	}
+	if (modelKind(model) !== "chat") {
+		throw new Error(`${model.provider}/${model.id} is a ${modelKind(model)} model; a subagent needs a chat model.`);
+	}
+
+	// The same grants a task `model` is checked against; a per-call child keeps the ones its dispatch gate holds.
+	const policy = subagentModelPolicy(session);
+	const callerModel = caller.getActiveModel?.();
+	const grants: PerCallModelGrants = policy?.perCallGrants ?? {
+		settings,
+		agentName: policy?.agent.name ?? ref.history?.agent ?? ref.displayName,
+		agentSource: policy?.agent.source,
+		agentModel: policy?.agent.model,
+		// Without a tracked definition (none was recorded) the agent's own frontmatter grants nothing.
+		agentRemoved: policy?.agent.removed ?? policy === undefined,
+		parentModelPattern: callerModel ? parentModelGrantPattern(callerModel) : caller.getActiveModelString?.(),
+		matchPreferences: structuredClone(getModelMatchPreferences(settings.grantAuthority())),
+	};
+	assertPerCallModelApproved(model, grants, modelRegistry);
+
+	// A caller-chosen model is held to `task.maxEffort` like a per-call spawn, and so is its thinking level.
+	let thinkingLevel: ConfiguredThinkingLevel | undefined = resolved.explicitThinkingLevel
+		? resolved.thinkingLevel
+		: undefined;
+	const ceiling = cfgTaskMaxEffort.get(settings);
+	if (ceiling) {
+		assertModelSupportsEffortCeiling(model, ceiling);
+		const base = thinkingLevel ?? session.configuredThinkingLevel();
+		if (base !== undefined && base !== AUTO_THINKING) {
+			thinkingLevel = clampThinkingLevelToCeiling(model, base, ceiling);
+		}
+	}
+
+	// Resolving the selector awaited the model registry; the run may have finished meanwhile.
+	if (registry?.get(id) !== ref || ref.status !== "running" || ref.session !== session) {
+		throw new Error(`Agent ${id} finished before its model could change; its model was not changed.`);
+	}
+	return { id, model, state: await session.switchModelAtNextRequest(model, thinkingLevel) };
+}
