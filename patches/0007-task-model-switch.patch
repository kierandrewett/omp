index 0000000000..40b960a5cf
--- /dev/null
+++ b/packages/coding-agent/src/task/subagent-model-policy.ts
@@ -0,0 +1,100 @@
+/**
+ * What may change a running subagent's model, held per live session.
+ *
+ * Two parties switch a running subagent's model. The operator (the user typing `/switch` or picking a
+ * model in the subagent's view) is not gated: the choice is theirs, so the child's per-call dispatch
+ * gate admits it. The parent agent acts for a model-facing caller and must pass the approval a task
+ * `model` passes ({@link switchSubagentModelAsCaller}). Both reach the session's
+ * {@link AgentSession.switchModelAtNextRequest}, so a switch never interrupts the request in flight.
+ */
+import type { Api, Effort, Model } from "@oh-my-pi/pi-ai";
+import { assertModelSupportsEffortCeiling, type ConfiguredThinkingLevel } from "@oh-my-pi/pi-tui/thinking";
+import type { AgentSource } from "@oh-my-pi/pi-tui/tools/task";
+import { formatModelStringWithRouting } from "../config/model-resolver";
+import type { AgentSession } from "../session/agent-session";
+import type { PerCallModelGrants } from "./model-approval";
+
+/** The agent definition a child runs, as far as model grants read it. */
+export interface SubagentAgentIdentity {
+	name: string;
+	source?: AgentSource;
+	/** The definition's frontmatter `model`; it grants only for bundled and user-level agents. */
+	model?: string | string[];
+	/** The definition is no longer discovered (cold revival): its frontmatter grants nothing. */
+	removed?: boolean;
+}
+
+export interface SubagentModelPolicyOptions {
+	agent: SubagentAgentIdentity;
+	/** Set for a per-call worker: the spawn's grants, which its dispatch gate already holds every request to. */
+	perCallGrants?: PerCallModelGrants;
+	/** The spawn's `task.maxEffort` ceiling, when the child runs under one. */
+	effortCeiling?: Effort;
+}
+
+/** Per-child state shared by a running subagent's dispatch gate and both switch routes. */
+export class SubagentModelPolicy {
+	readonly agent: SubagentAgentIdentity;
+	readonly perCallGrants: PerCallModelGrants | undefined;
+	readonly effortCeiling: Effort | undefined;
+	/** Identities the operator chose in the child's view; the dispatch gate admits them without a grant. */
+	readonly #operatorModels = new Set<string>();
+
+	constructor(options: SubagentModelPolicyOptions) {
+		this.agent = options.agent;
+		this.perCallGrants = options.perCallGrants;
+		this.effortCeiling = options.effortCeiling;
+	}
+
+	/** Whether the operator chose `model` for this child, so its dispatch needs no grant. */
+	admitsOperatorModel(model: Model<Api>): boolean {
+		return this.#operatorModels.has(formatModelStringWithRouting(model));
+	}
+
+	/** Records the operator's choice; returns whether it is new. */
+	approveOperatorModel(model: Model<Api>): boolean {
+		const identity = formatModelStringWithRouting(model);
+		if (this.#operatorModels.has(identity)) return false;
+		this.#operatorModels.add(identity);
+		return true;
+	}
+
+	revokeOperatorModel(model: Model<Api>): void {
+		this.#operatorModels.delete(formatModelStringWithRouting(model));
+	}
+}
+
+const policies = new WeakMap<AgentSession, SubagentModelPolicy>();
+
+/** Binds `policy` to a live child session; spawn and both revival paths call it for every session they build. */
+export function trackSubagentModelPolicy(session: AgentSession, policy: SubagentModelPolicy): void {
+	policies.set(session, policy);
+}
+
+export function subagentModelPolicy(session: AgentSession): SubagentModelPolicy | undefined {
+	return policies.get(session);
+}
+
+/**
+ * The operator's switch: the user chose `model` for `session` in its view. Nothing but the model's own
+ * requirements apply, so `task.perCallModel`, grants and `task.perCallModelAllow` are not consulted; a
+ * child held to a `task.maxEffort` ceiling still refuses a model that cannot run at or below it. The
+ * model applies at the session's next request ({@link AgentSession.switchModelAtNextRequest}).
+ * @returns `"applied"` when the model changed now, `"queued"` when it waits for the next request
+ */
+export async function switchSubagentModelAsOperator(
+	session: AgentSession,
+	model: Model<Api>,
+	thinkingLevel?: ConfiguredThinkingLevel,
+): Promise<"applied" | "queued"> {
+	const policy = subagentModelPolicy(session);
+	if (policy?.effortCeiling) assertModelSupportsEffortCeiling(model, policy.effortCeiling);
+	// The dispatch gate must admit the model before the request that uses it.
+	const added = policy?.approveOperatorModel(model) ?? false;
+	try {
+		return await session.switchModelAtNextRequest(model, thinkingLevel);
+	} catch (error) {
+		if (added) policy?.revokeOperatorModel(model);
+		throw error;
+	}
+}
