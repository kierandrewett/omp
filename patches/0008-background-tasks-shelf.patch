+/**
+ * Contract: the pinned Background tasks shelf sits directly above the Subagents
+ * shelf, lists every running background job (bash commands, eval cells) and service
+ * but no job that merely runs a subagent, and clears itself once nothing runs. It
+ * follows `display.pinnedJobs`, collapses a long list like the Subagents shelf, and
+ * repaints elapsed times only while something runs.
+ */
+import { afterEach, beforeAll, beforeEach, describe, expect, it, setSystemTime, vi } from "bun:test";
+import * as path from "node:path";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import { AsyncJobManager } from "@oh-my-pi/pi-coding-agent/async/job-manager";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { clearLiveServices, recordLiveService } from "@oh-my-pi/pi-coding-agent/launch/live-services";
+import {
+	backgroundTaskRows,
+	InteractiveMode,
+	isHudBackgroundJob,
+	nextBackgroundTasksTickMs,
+	renderBackgroundJobsHudLines,
+	SubagentHudComponent,
+} from "@oh-my-pi/pi-coding-agent/modes/interactive-mode";
+import { cfgDisplayPinnedJobs } from "@oh-my-pi/pi-coding-agent/modes/settings";
+import { type AsyncJobSnapshotItem, AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { type SubagentLifecyclePayload, TASK_SUBAGENT_LIFECYCLE_CHANNEL } from "@oh-my-pi/pi-coding-agent/task";
+import { PINNED_JOBS_TOGGLE_ID } from "@oh-my-pi/pi-coding-agent/task/output-manager";
+import { EventBus } from "@oh-my-pi/pi-coding-agent/utils/event-bus";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+import type { DaemonSnapshot } from "@oh-my-pi/pi-tui/tools/daemon";
+import { visibleWidth } from "@oh-my-pi/pi-tui/utils";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const NOW = 1_000_000;
+
+function job(overrides: Partial<AsyncJobSnapshotItem> & { id: string }): AsyncJobSnapshotItem {
+	return {
+		type: "bash",
+		status: "running",
+		label: overrides.id,
+		startTime: NOW - 5_000,
+		...overrides,
+	};
+}
+
+function shelfText(jobs: AsyncJobSnapshotItem[], columns = 120, expanded = false, now = NOW): string {
+	const rows = backgroundTaskRows(jobs, []);
+	return Bun.stripANSI(renderBackgroundJobsHudLines(rows, columns, expanded, now).join("\n"));
+}
+
+describe("Background tasks shelf lines", () => {
+	beforeAll(async () => {
+		await initTheme();
+	});
+
+	it("shows a running job's id, command preview and elapsed time", () => {
+		const text = shelfText([
+			job({
+				id: "bg_1099",
+				command: "cargo build --release",
+				label: "cargo build...",
+				startTime: NOW - 125_000,
+			}),
+		]);
+		expect(text).toContain("bg_1099");
+		expect(text).toContain("cargo build --release");
+		expect(text).toContain("2m5s");
+	});
+
+	it("falls back to the label when the job runs no process", () => {
+		expect(shelfText([job({ id: "eval_1", type: "eval", label: "load fixtures" })])).toContain("load fixtures");
+	});
+
+	it("collapses newlines, strips control sequences and shortens home paths in the preview", () => {
+		const home = process.env.HOME ?? "/home/user";
+		const command = `\x1b[31mecho one\x1b[0m\n\necho two ${home}/project/file.txt`;
+		const lines = renderBackgroundJobsHudLines(
+			backgroundTaskRows([job({ id: "bg_1", command })], []),
+			160,
+			false,
+			NOW,
+		);
+		const text = Bun.stripANSI(lines.join("\n"));
+		expect(lines.every(line => !line.includes("\n"))).toBe(true);
+		expect(text).toContain("echo one");
+		expect(text).toContain("echo two");
+		expect(text).not.toContain("\x1b[31m");
+		expect(text).not.toContain(home);
+	});
+
