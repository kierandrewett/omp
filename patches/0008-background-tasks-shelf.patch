+		const jobs = [
+			job({ id: "Scout", type: "task", agentId: "Scout" }),
+			job({ id: "bg_2", command: "sleep 60" }),
+			job({ id: "batch-1", type: "task", label: "work pool batch" }),
+			job({ id: "eval_3", type: "eval", label: "warm cache" }),
+		];
+		expect(jobs.map(isHudBackgroundJob)).toEqual([false, true, false, true]);
+		const text = shelfText(jobs);
+		expect(text).toContain("bg_2");
+		expect(text).toContain("eval_3");
+		expect(text).not.toContain("Scout");
+		expect(text).not.toContain("batch-1");
+	});
+
+	it("does not list settled jobs", () => {
+		expect(isHudBackgroundJob(job({ id: "bg_3", status: "completed" }))).toBe(false);
+		expect(isHudBackgroundJob(job({ id: "bg_4", status: "failed" }))).toBe(false);
+		expect(isHudBackgroundJob(job({ id: "bg_5", status: "cancelled" }))).toBe(false);
+	});
+
+	it("renders nothing when no task runs", () => {
+		expect(renderBackgroundJobsHudLines(backgroundTaskRows([], []), 120, false, NOW)).toEqual([]);
+		expect(
+			renderBackgroundJobsHudLines(backgroundTaskRows([job({ id: "bg_6", status: "completed" })], []), 120),
+		).toEqual([]);
+	});
+
+	it("lists jobs and services oldest first", () => {
+		const rows = backgroundTaskRows(
+			[job({ id: "bg_late", startTime: NOW - 1_000 }), job({ id: "bg_early", startTime: NOW - 9_000 })],
