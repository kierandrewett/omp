diff --git a/packages/coding-agent/src/launch/live-services.ts b/packages/coding-agent/src/launch/live-services.ts
new file mode 100644
index 0000000000..ca7cb57a71
--- /dev/null
+++ b/packages/coding-agent/src/launch/live-services.ts
@@ -0,0 +1,109 @@
+/**
+ * Running services of this process's sessions, kept so the TUI's Background tasks
+ * shelf can list them without asking the daemon broker. `services.ts` feeds it from
+ * every broker reply and completion notice it already handles, so it is as current as
+ * the session's own view of its services, and it never wakes an idle UI.
+ */
+import { TERMINAL_STATES } from "@oh-my-pi/pi-tui/apps/ps-data";
+import type { DaemonSnapshot, DaemonState } from "@oh-my-pi/pi-tui/tools/daemon";
+
+/** A running service as the Background tasks shelf lists it. */
+export interface LiveService {
+	/** Session that owns the service. */
+	readonly owner: string;
+	readonly name: string;
+	/** Daemon instance id; a restart under the same name is a new instance. */
+	readonly id: string;
+	readonly startedAt: number;
+	readonly state: DaemonState;
+	readonly pid?: number;
+	/** The shell command the session launched it with, known only for services it started itself. */
+	readonly command?: string;
+}
+
+/** Owner session id -> service name -> its latest known state. */
+const liveByOwner = new Map<string, Map<string, LiveService>>();
+const listeners = new Set<() => void>();
+
+function notify(): void {
+	for (const listener of listeners) listener();
+}
+
+/** Store `daemon` into `owned` without notifying; true when that changed the owner's services. */
+function storeService(
+	owned: Map<string, LiveService>,
+	owner: string,
+	daemon: DaemonSnapshot,
+	command: string | undefined,
+): boolean {
+	if (TERMINAL_STATES[daemon.state]) return owned.delete(daemon.name);
+	const previous = owned.get(daemon.name);
+	const next: LiveService = {
+		owner,
+		name: daemon.name,
+		id: daemon.id,
+		startedAt: daemon.startedAt,
+		state: daemon.state,
+		pid: daemon.pid,
+		// A later reply for the same instance carries no command; keep the one the launch recorded.
+		command: command ?? (previous?.id === daemon.id ? previous.command : undefined),
+	};
+	if (
+		previous &&
+		previous.id === next.id &&
+		previous.startedAt === next.startedAt &&
+		previous.state === next.state &&
+		previous.pid === next.pid &&
+		previous.command === next.command
+	) {
+		return false;
+	}
+	owned.set(daemon.name, next);
+	return true;
+}
+
+function ownedServices(owner: string): Map<string, LiveService> {
+	let owned = liveByOwner.get(owner);
+	if (!owned) {
+		owned = new Map();
+		liveByOwner.set(owner, owned);
+	}
+	return owned;
+}
+
+/** Record `daemon` as `owner`'s latest state for that service; a settled one is dropped. */
+export function recordLiveService(owner: string, daemon: DaemonSnapshot, command?: string): void {
+	if (storeService(ownedServices(owner), owner, daemon, command)) notify();
+}
+
+/** Replace `owner`'s services with the broker's list of them, dropping any the broker no longer knows. */
+export function replaceLiveServices(owner: string, daemons: readonly DaemonSnapshot[]): void {
+	const owned = ownedServices(owner);
+	let changed = false;
+	const listed = new Set(daemons.map(daemon => daemon.name));
+	for (const name of owned.keys()) {
+		if (!listed.has(name)) changed = owned.delete(name) || changed;
+	}
+	for (const daemon of daemons) changed = storeService(owned, owner, daemon, undefined) || changed;
+	if (changed) notify();
+}
+
+/** Forget every service of `owner`, e.g. when its session ends or switches. */
+export function clearLiveServices(owner: string): void {
+	const hadServices = (liveByOwner.get(owner)?.size ?? 0) > 0;
+	liveByOwner.delete(owner);
+	if (hadServices) notify();
+}
+
+/** Running services `owner` has, oldest first. */
+export function listLiveServices(owner: string): LiveService[] {
+	return [...(liveByOwner.get(owner)?.values() ?? [])].sort((a, b) => a.startedAt - b.startedAt);
+}
+
+/** Calls `listener` whenever a service starts, changes state or ends. Returns the unsubscribe. */
+export function onLiveServicesChanged(listener: () => void): () => void {
+	listeners.add(listener);
+	return () => {
+		listeners.delete(listener);
+	};
+}
