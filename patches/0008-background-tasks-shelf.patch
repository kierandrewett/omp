+		const jobs = [
+			job({
+				id: "bg_1099",
+				command: "cd /var/tmp/wt-yaml && cargo build 2>&1 | tail -1; ".repeat(6),
+				startTime: NOW - 400_000,
+			}),
+			job({ id: "a-rather-long-service-name-for-a-row", command: "x", startTime: NOW - 2_000 }),
+			job({ id: "bg_3", command: "sleep 9" }),
+			job({ id: "bg_4", command: "sleep 9" }),
+		];
+		for (const columns of [60, 40, 24, 14, 8]) {
+			for (const expanded of [false, true]) {
+				const rows = renderBackgroundJobsHudLines(backgroundTaskRows(jobs, []), columns, expanded, NOW);
+				const painted = new SubagentHudComponent(rows, [], undefined, PINNED_JOBS_TOGGLE_ID).render(columns);
+				for (const row of painted) expect(visibleWidth(row)).toBeLessThanOrEqual(columns);
+			}
+		}
+	});
+
+	it("keeps the id and drops the elapsed time when a row is too narrow for both", () => {
+		const text = shelfText([job({ id: "bg_1099", command: "sleep 5", startTime: NOW - 61_000 })], 16);
+		expect(text).toContain("bg_1099");
+		expect(text).not.toContain("1m1s");
+	});
+
+	it("collapses a long list behind an expander and lists everything when expanded", () => {
+		const jobs = Array.from({ length: 5 }, (_, index) =>
+			job({ id: `bg_${index + 1}`, command: `job ${index}`, startTime: NOW - (10 - index) * 1_000 }),
+		);
