+/** Columns between a Background tasks row's preview and its elapsed time. */
+const BACKGROUND_TASK_ELAPSED_GAP = 2;
+
+/** Most of a command or label read into a row's one-line preview; the row cuts it to width anyway. */
+const BACKGROUND_TASK_PREVIEW_MAX_CHARS = 512;
+
+/** One row of the Background tasks shelf: a running async job or service. */
+export interface BackgroundTaskRow {
+	/** Job id (`bg_12`) or service name. */
+	id: string;
+	/** Epoch ms the task started; the row's elapsed time counts from it. */
+	startTime: number;
+	/** Command or label the row previews. */
+	text: string;
+}
+
+/**
+ * Whether the Background tasks shelf lists `job`: a running backgrounded bash command
+ * or eval cell. Every `task` job is agent work (a subagent, a work-pool batch of
+ * them, a security scan, a `/tan` clone) that the Subagents shelf and the agent hub
+ * already show, so none is listed here.
+ */
+export function isHudBackgroundJob(job: AsyncJobSnapshotItem): boolean {
+	return job.status === "running" && job.type !== "task";
+}
+
+/** The shelf's rows, oldest first: the listed running jobs, then the running services, merged by start time. */
+export function backgroundTaskRows(
+	jobs: readonly AsyncJobSnapshotItem[],
+	services: readonly LiveService[],
+): BackgroundTaskRow[] {
+	const rows: BackgroundTaskRow[] = [];
+	for (const job of jobs) {
+		if (isHudBackgroundJob(job)) rows.push({ id: job.id, startTime: job.startTime, text: job.command ?? job.label });
+	}
+	for (const service of services) {
+		rows.push({
+			id: service.name,
+			startTime: service.startedAt,
+			text: service.command ?? `service ${service.state}`,
+		});
+	}
+	return rows.sort((a, b) => a.startTime - b.startTime);
+}
+
+/**
+ * Delay until the Background tasks shelf next needs a repaint with no job event to
+ * trigger it: a second (the Subagents live preview's cadence) while any row shows an
+ * elapsed time, none when nothing is listed so an idle UI arms no timer.
+ */
+export function nextBackgroundTasksTickMs(rowCount: number): number | undefined {
+	return rowCount > 0 ? SUBAGENT_PREVIEW_TICK_MS : undefined;
+}
+
+/**
+ * Build the anchored Background tasks shelf, which sits directly above the
+ * Subagents shelf and shares its look: a bold accent "Background tasks" header with
+ * a dim `· N running`, then tree rows shifted right by one space. A row is a dot,
+ * the task id in bold accent, a muted one-line preview of its command (newlines
+ * collapsed, control sequences stripped, home paths shortened) and its elapsed time,
+ * right-aligned and dim. Density follows `layoutPinnedHud`, so a long list collapses
+ * behind an expander. Returns an empty array when nothing is running so the
+ * container can clear.
+ */
+export function renderBackgroundJobsHudLines(
+	rows: readonly BackgroundTaskRow[],
+	columns: number,
+	expanded = false,
+	now = Date.now(),
+): string[] {
+	if (rows.length === 0) return [];
+	// `SubagentHudComponent` paints through `Text` with horizontal padding, so
+	// rows budgeted to the full terminal width would wrap.
+	const contentColumns = Math.max(0, columns - getPaddingX(1) * 2);
+	const layout = layoutPinnedHud(rows.length, expanded);
+	const dot = theme.styledSymbol("status.done", "accent");
+	const outerIndent = " ";
+	const treeRows = renderTreeList(
