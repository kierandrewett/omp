diff --git a/packages/ai/test/auth-storage-anthropic-sequential.test.ts b/packages/ai/test/auth-storage-anthropic-sequential.test.ts
new file mode 100644
index 0000000000..4a7bd8a2f9
--- /dev/null
+++ b/packages/ai/test/auth-storage-anthropic-sequential.test.ts
@@ -0,0 +1,267 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "bun:test";
+import {
+	type AuthCredential,
+	type AuthCredentialStore,
+	AuthStorage,
+	type StoredAuthCredential,
+} from "@oh-my-pi/pi-ai/auth-storage";
+import type { UsageReport } from "@oh-my-pi/pi-ai/usage";
+import * as claudeUsage from "@oh-my-pi/pi-ai/usage/claude";
+
+// Sequential account mode for Anthropic: every session follows ONE stored account until it is
+// blocked or spent. The failure modes behind these scenarios are listed in the commit body.
+
+const HOUR_MS = 3_600_000;
+const ACTIVE_KEY = "account:active:anthropic";
+
+interface ObservableStore extends AuthCredentialStore {
+	cache: Map<string, { value: string; expiresAtSec: number }>;
+}
+
+function makeStore(rows: StoredAuthCredential[]): ObservableStore {
+	const cache = new Map<string, { value: string; expiresAtSec: number }>();
+	return {
+		cache,
+		close() {},
+		listAuthCredentials() {
+			return rows;
+		},
+		updateAuthCredential() {},
+		async deleteAuthCredential() {
+			return false;
+		},
+		tryDisableAuthCredentialIfMatches() {
+			return false;
+		},
+		async replaceAuthCredentials() {
+			return rows;
+		},
+		async upsertAuthCredential() {
+			return rows;
+		},
+		async deleteAuthCredentials() {},
+		getCache(key) {
+			const entry = cache.get(key);
+			if (!entry) return null;
+			if (entry.expiresAtSec * 1000 <= Date.now()) return null;
+			return entry.value;
+		},
+		setCache(key, value, expiresAtSec) {
+			cache.set(key, { value, expiresAtSec });
+		},
+		cleanExpiredCache() {},
+	};
+}
+
+function oauthRow(id: number, email: string): StoredAuthCredential {
+	const credential: AuthCredential = {
+		type: "oauth",
+		access: `oat-${id}`,
+		refresh: `refresh-${id}`,
+		expires: Date.now() + HOUR_MS,
+		accountId: `account-${id}`,
+		email,
+	};
+	return { id, provider: "anthropic", credential, disabledCause: null };
+}
+
+interface Window {
+	used: number;
+	resetsInMs?: number;
+}
+
+function report(email: string, fiveHour: Window, sevenDay: Window): UsageReport {
+	const limit = (id: "5h" | "7d", window: Window): UsageReport["limits"][number] => ({
+		id: `anthropic:${id}`,
+		label: id === "5h" ? "Claude 5 Hour" : "Claude 7 Day",
+		scope: { provider: "anthropic", windowId: id, shared: true },
+		window: {
+			id,
+			label: id === "5h" ? "5 Hour" : "7 Day",
+			...(window.resetsInMs === undefined ? {} : { resetsAt: Date.now() + window.resetsInMs }),
+		},
+		amount: { used: window.used * 100, limit: 100, usedFraction: window.used, unit: "percent" },
+		status: window.used >= 1 ? "exhausted" : "ok",
+	});
+	return {
+		provider: "anthropic",
+		fetchedAt: Date.now(),
+		limits: [limit("5h", fiveHour), limit("7d", sevenDay)],
+		metadata: { email, accountId: email },
+	};
+}
+
+const FRESH: Window = { used: 0, resetsInMs: 5 * HOUR_MS };
+const SPENT_WEEK: Window = { used: 1, resetsInMs: 70 * HOUR_MS };
+
+describe("AuthStorage Anthropic sequential accounts", () => {
+	let store: ObservableStore;
+	let storage: AuthStorage;
+	let reports: Record<string, UsageReport | null>;
+
+	const openStorage = async (accountMode: "sequential" | "balanced" = "sequential"): Promise<AuthStorage> => {
+		const opened = new AuthStorage(store, {
+			usageProviderResolver: provider => (provider === "anthropic" ? claudeUsage.claudeUsageProvider : undefined),
+			accountMode,
+		});
+		await opened.credentials.reload();
+		return opened;
+	};
+
+	/** Forget cached usage so the next resolve reads the current `reports`, keeping the active account row. */
+	const refreshUsage = async (): Promise<void> => {
+		storage.close();
+		for (const key of [...store.cache.keys()]) {
+			if (key !== ACTIVE_KEY) store.cache.delete(key);
+		}
+		storage = await openStorage();
+	};
+
+	beforeEach(async () => {
+		store = makeStore([oauthRow(1, "a@example.com"), oauthRow(2, "b@example.com")]);
+		reports = {
+			"oat-1": report("a@example.com", FRESH, { used: 0.2, resetsInMs: 70 * HOUR_MS }),
+			"oat-2": report("b@example.com", FRESH, { used: 0.2, resetsInMs: 70 * HOUR_MS }),
+		};
+		vi.spyOn(claudeUsage.claudeUsageProvider, "fetchUsage").mockImplementation(async params => {
+			const access = params.credential.type === "oauth" ? params.credential.accessToken : undefined;
+			return access ? (reports[access] ?? null) : null;
+		});
+		storage = await openStorage();
+	});
+
+	afterEach(() => {
+		storage.close();
+		vi.restoreAllMocks();
+	});
+
+	it("sends every session to the same account when none is active yet", async () => {
+		const keys = await Promise.all(["s1", "s2", "s3", "s4", "s5", "s6"].map(id => storage.keys.get("anthropic", id)));
+		expect(new Set(keys).size).toBe(1);
+		expect(keys[0]).toBe("oat-1");
+		expect(store.cache.get(ACTIVE_KEY)?.value).toBe("1");
+	});
+
+	it("keeps the active account while its 5 hour window is hot and a sibling is idle", async () => {
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		reports["oat-1"] = report(
+			"a@example.com",
+			{ used: 0.93, resetsInMs: HOUR_MS },
+			{ used: 0.4, resetsInMs: 70 * HOUR_MS },
+		);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		expect(await storage.keys.get("anthropic", "s2")).toBe("oat-1");
+	});
+
+	it("serves the account up to 99% used without a reserve switch", async () => {
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		reports["oat-1"] = report(
+			"a@example.com",
+			{ used: 0.99, resetsInMs: HOUR_MS },
+			{ used: 0.5, resetsInMs: 70 * HOUR_MS },
+		);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+	});
+
+	it("moves every session to the sibling once the active account is spent, and stays there after a reset", async () => {
+		expect(await storage.keys.get("anthropic", "pinned")).toBe("oat-1");
+
+		reports["oat-1"] = report("a@example.com", FRESH, SPENT_WEEK);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "other")).toBe("oat-2");
+		expect(store.cache.get(ACTIVE_KEY)?.value).toBe("2");
+		// A session that was pinned to the first account follows the shared active account.
+		expect(await storage.keys.get("anthropic", "pinned")).toBe("oat-2");
+
+		// The first account resets. Nothing hands back while the second still has allowance.
+		reports["oat-1"] = report("a@example.com", FRESH, { used: 0, resetsInMs: 160 * HOUR_MS });
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "pinned")).toBe("oat-2");
+		expect(await storage.keys.get("anthropic", "new-session")).toBe("oat-2");
+	});
+
+	it("returns to the first account only when the second is spent", async () => {
+		reports["oat-1"] = report("a@example.com", FRESH, SPENT_WEEK);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-2");
+
+		reports["oat-1"] = report("a@example.com", FRESH, { used: 0, resetsInMs: 160 * HOUR_MS });
+		reports["oat-2"] = report(
+			"b@example.com",
+			{ used: 1, resetsInMs: 2 * HOUR_MS },
+			{ used: 0.6, resetsInMs: 40 * HOUR_MS },
+		);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		expect(store.cache.get(ACTIVE_KEY)?.value).toBe("1");
+	});
+
+	it("rotates to the sibling after a 429 even when no usage report is available", async () => {
+		reports["oat-1"] = null;
+		reports["oat-2"] = null;
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+
+		const marked = await storage.limits.markReached("anthropic", "s1", {
+			retryAfterMs: 70 * HOUR_MS,
+			providerTimed: true,
+		});
+		expect(marked.switched).toBe(true);
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-2");
+		expect(await storage.keys.get("anthropic", "s2")).toBe("oat-2");
+		expect(store.cache.get(ACTIVE_KEY)?.value).toBe("2");
+	});
+
+	it("still resolves a key when both accounts are spent, choosing the one that frees first", async () => {
+		reports["oat-1"] = report("a@example.com", FRESH, { used: 1, resetsInMs: 70 * HOUR_MS });
+		reports["oat-2"] = report("b@example.com", FRESH, { used: 1, resetsInMs: 20 * HOUR_MS });
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-2");
+	});
+
+	it("shares the active account with a second AuthStorage on the same store", async () => {
+		reports["oat-1"] = report("a@example.com", FRESH, SPENT_WEEK);
+		await refreshUsage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-2");
+
+		// Another omp process opens the same database while the first account looks healthy again.
+		reports["oat-1"] = report("a@example.com", FRESH, { used: 0, resetsInMs: 160 * HOUR_MS });
+		const peer = await openStorage();
+		try {
+			for (const key of [...store.cache.keys()]) {
+				if (key !== ACTIVE_KEY) store.cache.delete(key);
+			}
+			expect(await peer.keys.get("anthropic", "peer-session")).toBe("oat-2");
+		} finally {
+			peer.close();
+		}
+	});
+
+	it("falls back to stored order when the recorded active account no longer exists", async () => {
+		store.cache.set(ACTIVE_KEY, { value: "999", expiresAtSec: Math.floor(Date.now() / 1000) + 3600 });
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		expect(store.cache.get(ACTIVE_KEY)?.value).toBe("1");
+	});
+
+	it("keeps usage-balanced ranking when the account mode is balanced", async () => {
+		storage.close();
+		storage = await openStorage("balanced");
+		reports["oat-1"] = report(
+			"a@example.com",
+			{ used: 0.93, resetsInMs: HOUR_MS },
+			{ used: 0.4, resetsInMs: 70 * HOUR_MS },
+		);
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-2");
+		expect(store.cache.has(ACTIVE_KEY)).toBe(false);
+	});
+
+	it("leaves a single stored account alone", async () => {
+		storage.close();
+		store = makeStore([oauthRow(1, "a@example.com")]);
+		storage = await openStorage();
+		expect(await storage.keys.get("anthropic", "s1")).toBe("oat-1");
+		expect(store.cache.has(ACTIVE_KEY)).toBe(false);
+	});
+});
