diff --git a/packages/coding-agent/src/modes/model-account-label.ts b/packages/coding-agent/src/modes/model-account-label.ts
new file mode 100644
index 0000000000..b435a85194
--- /dev/null
+++ b/packages/coding-agent/src/modes/model-account-label.ts
@@ -0,0 +1,33 @@
+import type { OAuthAccountSummary } from "@oh-my-pi/pi-ai";
+import { formatProviderName } from "@oh-my-pi/pi-tui/chrome/format";
+import type { StatusModelAccount } from "@oh-my-pi/pi-tui/status-line/host";
+
+/** Letter of the account at 0-based `index` in the credential pool: A, B, ... Z, AA, AB, ... */
+export function accountLetter(index: number): string {
+	let letter = "";
+	for (let rest = index + 1; rest > 0; rest = Math.floor((rest - 1) / 26)) {
+		letter = String.fromCharCode(65 + ((rest - 1) % 26)) + letter;
+	}
+	return letter;
+}
+
+/**
+ * Qualifier that tells a provider's stored OAuth accounts apart in model displays:
+ * `Anthropic (B)` before the model name, `anthropic-b` before the raw model id.
+ *
+ * `accounts` is `authStorage.oauth.accounts(provider, sessionId)`: stored credential-pool
+ * order, the order `omp usage accounts` prints, with the session's sticky account marked
+ * `active`. The letter is the active account's index in that order (A is the first). A
+ * provider with fewer than two stored accounts, or a session that has not resolved one yet,
+ * gets no qualifier, so single-account displays stay as they were.
+ */
+export function resolveModelAccount(
+	provider: string,
+	accounts: readonly Pick<OAuthAccountSummary, "active">[],
+): StatusModelAccount | undefined {
+	if (accounts.length < 2) return undefined;
+	const index = accounts.findIndex(account => account.active);
+	if (index === -1) return undefined;
+	const letter = accountLetter(index);
+	return { label: `${formatProviderName(provider)} (${letter})`, rawProvider: `${provider}-${letter.toLowerCase()}` };
+}
