diff --git a/packages/coding-agent/test/model-account-label.test.ts b/packages/coding-agent/test/model-account-label.test.ts
new file mode 100644
index 0000000000..c1ae0fed21
--- /dev/null
+++ b/packages/coding-agent/test/model-account-label.test.ts
@@ -0,0 +1,208 @@
+/**
+ * A provider with two or more stored OAuth accounts qualifies its model in the status line
+ * (`Anthropic (B) > Sonnet 5.5`, raw `anthropic-b/claude-sonnet-5-5`) so the account a
+ * session is burning is visible; a single-account provider reads exactly as before.
+ */
+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { accountLetter, resolveModelAccount } from "@oh-my-pi/pi-coding-agent/modes/model-account-label";
+import { statusLineHost } from "@oh-my-pi/pi-coding-agent/modes/status-line-host";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { StatusLineComponent } from "@oh-my-pi/pi-tui/status-line";
+import { FooterComponent } from "@oh-my-pi/pi-tui/status-line/footer";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+import { StatusLineTestComponents } from "./helpers/status-line";
+
+const SESSION_ID = "model-account-session";
+const statusLines = new StatusLineTestComponents();
+
+beforeAll(async () => {
+	resetSettingsForTest();
+	await Settings.init({ inMemory: true });
+	await initTheme();
+});
+
+afterAll(() => {
+	statusLines.dispose();
+	resetSettingsForTest();
+});
+
+function oauthCredential(suffix: string) {
+	return {
+		type: "oauth" as const,
+		access: `access-${suffix}`,
+		refresh: `refresh-${suffix}`,
+		expires: Date.now() + 60 * 60_000,
+		accountId: `acc-${suffix}`,
+		email: `${suffix}@example.com`,
+	};
+}
+
+/** Auth storage holding `suffixes` as stored Anthropic OAuth accounts, in that order. */
+async function authStorageWith(...suffixes: string[]): Promise<AuthStorage> {
+	const authStorage = await AuthStorage.create(":memory:");
+	await authStorage.credentials.set("anthropic", suffixes.map(oauthCredential));
+	return authStorage;
+}
+
+/** Make the session's sticky account the stored account with `email`. */
+function pinAccount(authStorage: AuthStorage, email: string): void {
+	const account = authStorage.oauth.accounts("anthropic", SESSION_ID).find(candidate => candidate.email === email);
+	if (!account || !authStorage.sessions.pin("anthropic", SESSION_ID, account.credentialId)) {
+		throw new Error(`could not pin ${email}`);
+	}
+}
+
+const SONNET = { provider: "anthropic", id: "claude-sonnet-5-5", name: "Claude Sonnet 5.5", contextWindow: 1000 };
+
+function makeSession(authStorage: AuthStorage) {
+	return {
+		state: { messages: [], model: SONNET },
+		model: SONNET,
+		sessionId: SESSION_ID,
+		messages: [],
+		systemPrompt: [],
+		agent: { state: { tools: [] } },
+		skills: [],
+		isStreaming: false,
+		isAutoThinking: false,
+		autoResolvedThinkingLevel: () => undefined,
+		isFastModeActive: () => false,
+		getContextUsage: () => undefined,
+		getAsyncJobSnapshot: () => ({ running: [] }),
+		modelRegistry: { authStorage, isUsingOAuth: () => true },
+		sessionManager: {
+			getSessionName: () => undefined,
+			getSessionId: () => SESSION_ID,
+			getEntries: () => [],
+			getUsageStatistics: () => ({
+				input: 0,
+				output: 0,
+				cacheRead: 0,
+				cacheWrite: 0,
+				totalTokens: 0,
+				orchestrationInput: 0,
+				orchestrationOutput: 0,
+				orchestrationCacheRead: 0,
+				premiumRequests: 0,
+				cost: 0,
+			}),
+		},
+	};
+}
+
+function modelBorder(component: StatusLineComponent): string {
+	return Bun.stripANSI(component.getTopBorder(200).content);
+}
+
+function makeStatusLine(authStorage: AuthStorage): StatusLineComponent {
+	const component = statusLines.track(
+		new StatusLineComponent(
+			makeSession(authStorage) as unknown as ConstructorParameters<typeof StatusLineComponent>[0],
+			statusLineHost,
+		),
+	);
+	component.updateSettings({ preset: "custom", leftSegments: [], rightSegments: ["model"], sessionAccent: false });
+	return component;
+}
+
+describe("account letters", () => {
+	it("number accounts in stored order, continuing past Z", () => {
+		expect([0, 1, 2, 25, 26, 27, 51, 52].map(accountLetter)).toEqual(["A", "B", "C", "Z", "AA", "AB", "AZ", "BA"]);
+	});
+});
+
+describe("resolveModelAccount", () => {
+	it("names the session's account by its stored position among two or more", async () => {
+		const authStorage = await authStorageWith("a", "b", "c");
+		try {
+			pinAccount(authStorage, "b@example.com");
+			expect(resolveModelAccount("anthropic", authStorage.oauth.accounts("anthropic", SESSION_ID))).toEqual({
+				label: "Anthropic (B)",
+				rawProvider: "anthropic-b",
+			});
+			pinAccount(authStorage, "c@example.com");
+			expect(
+				resolveModelAccount("anthropic", authStorage.oauth.accounts("anthropic", SESSION_ID))?.rawProvider,
+			).toBe("anthropic-c");
+		} finally {
+			authStorage.close();
+		}
+	});
+
+	it("adds no qualifier for one account or before the session resolved an account", async () => {
+		const single = await authStorageWith("a");
+		const pair = await authStorageWith("a", "b");
+		try {
+			pinAccount(single, "a@example.com");
+			expect(resolveModelAccount("anthropic", single.oauth.accounts("anthropic", SESSION_ID))).toBeUndefined();
+			expect(resolveModelAccount("anthropic", pair.oauth.accounts("anthropic", SESSION_ID))).toBeUndefined();
+		} finally {
+			single.close();
+			pair.close();
+		}
+	});
+});
+
+describe("account-qualified model display", () => {
+	it("labels the model segment with the session's account and follows a mid-session account change", async () => {
+		const authStorage = await authStorageWith("a", "b");
+		try {
+			const component = makeStatusLine(authStorage);
+			pinAccount(authStorage, "b@example.com");
+			expect(modelBorder(component)).toContain("Anthropic (B) > Sonnet 5.5");
+
+			// The same component re-renders for the new account instead of serving the cached label.
+			pinAccount(authStorage, "a@example.com");
+			const border = modelBorder(component);
+			expect(border).toContain("Anthropic (A) > Sonnet 5.5");
+			expect(border).not.toContain("(B)");
+		} finally {
+			authStorage.close();
+		}
+	});
+
+	it("shows the raw provider-qualified model id in the footer", async () => {
+		const authStorage = await authStorageWith("a", "b");
+		try {
+			const footer = new FooterComponent(
+				makeSession(authStorage) as unknown as ConstructorParameters<typeof FooterComponent>[0],
+				statusLineHost,
+			);
+			try {
+				pinAccount(authStorage, "b@example.com");
+				expect(Bun.stripANSI(footer.render(200).join("\n"))).toContain("anthropic-b/claude-sonnet-5-5");
+				pinAccount(authStorage, "a@example.com");
+				expect(Bun.stripANSI(footer.render(200).join("\n"))).toContain("anthropic-a/claude-sonnet-5-5");
+			} finally {
+				footer.dispose();
+			}
+		} finally {
+			authStorage.close();
+		}
+	});
+
+	it("leaves a single-account provider's model display unchanged", async () => {
+		const authStorage = await authStorageWith("a");
+		try {
+			pinAccount(authStorage, "a@example.com");
+			const border = modelBorder(makeStatusLine(authStorage));
+			expect(border).toContain("Sonnet 5.5");
+			expect(border).not.toContain("Anthropic");
+
+			const footer = new FooterComponent(
+				makeSession(authStorage) as unknown as ConstructorParameters<typeof FooterComponent>[0],
+				statusLineHost,
+			);
+			try {
+				const line = Bun.stripANSI(footer.render(200).join("\n"));
+				expect(line).toContain("claude-sonnet-5-5");
+				expect(line).not.toContain("anthropic");
+			} finally {
+				footer.dispose();
+			}
+		} finally {
+			authStorage.close();
+		}
+	});
+});
