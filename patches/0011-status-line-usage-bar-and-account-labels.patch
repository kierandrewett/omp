+/** Cells in the `usage_bar` progress bar. */
+const USAGE_BAR_CELLS = 5;
+
+interface UsageBarWindow {
+	/** Window tag; the 5-hour default is shown without one. */
+	tag: "5h" | "1d" | "7d" | "mo";
+	/** Tooltip name of the window. */
+	name: string;
+	/** Used share, clamped to 0-100. */
+	percent: number;
+}
+
+/**
+ * The window the `usage_bar` segment draws: the most constraining quota window
+ * of the active account of the active provider, i.e. the highest used percent
+ * among its 5 Hour, daily, 7 Day and monthly windows (`ctx.usage` is already
+ * scoped to that account and model). The 5 Hour window wins a tie, so it is the
+ * default; when the 7 Day window (or a daily/monthly one on providers without
+ * a 5 Hour window) is higher, that window is drawn instead and tagged (`7d`).
+ * Null when the provider reports none of these windows.
+ */
+function usageBarWindow(ctx: SegmentContext): UsageBarWindow | null {
+	const u = ctx.usage;
+	if (!u) return null;
+	const candidates: readonly (UsageBarWindow | null)[] = [
+		u.fiveHour ? { tag: "5h", name: "5 Hour", percent: u.fiveHour.percent } : null,
+		u.daily ? { tag: "1d", name: "Daily", percent: u.daily.percent } : null,
+		u.sevenDay ? { tag: "7d", name: "7 Day", percent: u.sevenDay.percent } : null,
+		u.monthly ? { tag: "mo", name: "Monthly", percent: u.monthly.percent } : null,
+	];
+	let binding: UsageBarWindow | null = null;
+	for (const candidate of candidates) {
+		if (!candidate || !Number.isFinite(candidate.percent)) continue;
+		const percent = Math.min(100, Math.max(0, candidate.percent));
+		if (!binding || percent > binding.percent) binding = { ...candidate, percent };
+	}
+	return binding;
+}
+
+const usageBarSegment: StatusLineSegment = {
+	id: "usage_bar",
+	render(ctx) {
+		const window = usageBarWindow(ctx);
+		if (!window) return { content: "", visible: false };
+		const color = pickUsageColor(window.percent);
+		const bar = renderProgressBar(window.percent, USAGE_BAR_CELLS, {
+			max: 100,
+			style: {
+				filled: theme.progress.filled,
+				empty: theme.progress.empty,
+				styleFilled: text => theme.fg(color, text),
+				styleEmpty: text => theme.fg("dim", text),
+			},
+		});
+		const tag = window.tag === "5h" ? "" : theme.fg("muted", ` ${window.tag}`);
+		const text = `${bar} ${theme.fg(color, `${Math.round(window.percent)}%`)}${tag}`;
+		return { content: withIcon(theme.icon.time, text), visible: true };
+	},
+	describe(ctx) {
+		const window = usageBarWindow(ctx);
+		if (!window) return null;
+		const color = pickUsageColor(window.percent);
+		const whole = Math.round(window.percent);
+		const filled = Math.round((progressFraction(window.percent, 0, 100) ?? 0) * USAGE_BAR_CELLS);
+		const spans: TspSpan[] = [
+			span(theme.progress.filled.repeat(filled), color),
+			span(theme.progress.empty.repeat(USAGE_BAR_CELLS - filled), "dim"),
+			span(` ${whole}%`, color),
+		];
+		if (window.tag !== "5h") spans.push(span(` ${window.tag}`, "muted"));
+		return { ...segView(spans, "time", toneOf(color)), title: `${window.name} window: ${whole}% used` };
+	},
+};
