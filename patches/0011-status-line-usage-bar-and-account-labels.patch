diff --git a/packages/tui/test/status-line-usage-bar.test.ts b/packages/tui/test/status-line-usage-bar.test.ts
new file mode 100644
index 0000000000..1bef8e929a
--- /dev/null
+++ b/packages/tui/test/status-line-usage-bar.test.ts
@@ -0,0 +1,85 @@
+import { beforeAll, describe, expect, it } from "bun:test";
+import { stripVTControlCharacters } from "node:util";
+import { describeSegment, renderSegment } from "../src/status-line/segments";
+import type { SegmentContext } from "../src/status-line/types";
+import { initTheme, theme } from "../src/theme";
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+function ctxWith(usage: SegmentContext["usage"]): SegmentContext {
+	return { usage } as unknown as SegmentContext;
+}
+
+function plain(ctx: SegmentContext): string {
+	return stripVTControlCharacters(renderSegment("usage_bar", ctx).content);
+}
+
+/** The bar cells for `filled` of five, in the theme's progress glyphs. */
+function bar(filled: number): string {
+	return theme.progress.filled.repeat(filled) + theme.progress.empty.repeat(5 - filled);
+}
+
+describe("usage_bar status-line segment", () => {
+	it("draws the 5 Hour window as a bar and a percent, untagged", () => {
+		const text = plain(ctxWith({ fiveHour: { percent: 42, resetMinutes: 30 }, sevenDay: { percent: 8 } }));
+
+		expect(text).toContain(`${bar(2)} 42%`);
+		expect(text).not.toContain("7d");
+	});
+
+	it("draws the 7 Day window, tagged, when it is the more constraining one", () => {
+		const text = plain(ctxWith({ fiveHour: { percent: 24 }, sevenDay: { percent: 91 } }));
+
+		expect(text).toContain(`${bar(5)} 91%`);
+		expect(text).toContain("7d");
+		expect(text).not.toContain("24%");
+	});
+
+	it("keeps the 5 Hour window when both windows are equally used", () => {
+		const text = plain(ctxWith({ fiveHour: { percent: 60 }, sevenDay: { percent: 60 } }));
+
+		expect(text).toContain("60%");
+		expect(text).not.toContain("7d");
+	});
+
+	it("draws the only window a provider reports, tagged", () => {
+		expect(plain(ctxWith({ sevenDay: { percent: 8 } }))).toContain(`${bar(0)} 8% 7d`);
+		expect(plain(ctxWith({ monthly: { percent: 77 } }))).toContain("77% mo");
+	});
+
+	it("clamps an over-quota window to a full bar", () => {
+		expect(plain(ctxWith({ fiveHour: { percent: 140 } }))).toContain(`${bar(5)} 100%`);
+	});
+
+	it("warns from 50% and errors from 80% like the usage segment", () => {
+		expect(renderSegment("usage_bar", ctxWith({ fiveHour: { percent: 30 } })).content).toContain(
+			theme.fg("muted", "30%"),
+		);
+		expect(renderSegment("usage_bar", ctxWith({ fiveHour: { percent: 65 } })).content).toContain(
+			theme.fg("warning", "65%"),
+		);
+		expect(renderSegment("usage_bar", ctxWith({ fiveHour: { percent: 92 } })).content).toContain(
+			theme.fg("error", "92%"),
+		);
+	});
+
+	it("collapses when the provider has no usage windows", () => {
+		const hidden = { content: "", visible: false };
+
+		expect(renderSegment("usage_bar", ctxWith(null))).toEqual(hidden);
+		expect(renderSegment("usage_bar", ctxWith({ tier: "Pro" }))).toEqual(hidden);
+		expect(renderSegment("usage_bar", ctxWith({ resetCredits: { bankedCount: 2, redeemableCount: 2 } }))).toEqual(
+			hidden,
+		);
+		expect(describeSegment("usage_bar", ctxWith(null))).toBeNull();
+	});
+
+	it("describes the same window natively", () => {
+		const view = describeSegment("usage_bar", ctxWith({ fiveHour: { percent: 42 }, sevenDay: { percent: 91 } }));
+
+		expect(view?.spans.map(part => part.t).join("")).toBe(`${bar(5)} 91% 7d`);
+		expect(view?.title).toBe("7 Day window: 91% used");
+	});
+});
