+import type { StatusModelAccount } from "./host";
+
+/** Separator between the account-qualified provider and the model name. */
+const MODEL_LABEL_SEPARATOR = " > ";
+
+/** `Sonnet 5.5`, or `Anthropic (B) > Sonnet 5.5` when the provider is account-qualified. */
+export function qualifiedModelName(name: string, account: StatusModelAccount | undefined): string {
+	return account ? `${account.label}${MODEL_LABEL_SEPARATOR}${name}` : name;
+}
+
+/**
+ * Raw model indicator: `claude-sonnet-5-5`, or `anthropic-b/claude-sonnet-5-5` when the
+ * provider is account-qualified. Display only; the catalog id is never rewritten.
+ */
+export function qualifiedModelId(id: string, account: StatusModelAccount | undefined): string {
+	return account ? `${account.rawProvider}/${id}` : id;
+}
