@@ -0,0 +1,201 @@
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "bun:test";
+import * as path from "node:path";
+import { scheduler } from "node:timers/promises";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+import type { MockResponse } from "@oh-my-pi/pi-ai/providers/mock";
+import { unregisterCustomApis } from "@oh-my-pi/pi-ai/api-registry";
+import * as envApiKey from "@oh-my-pi/pi-ai/env-api-key";
+import { createMockModel, registerMockApi } from "@oh-my-pi/pi-ai/providers/mock";
+import * as aiStream from "@oh-my-pi/pi-ai/stream";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentSession, type AgentSessionEvent } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+type AutoRetryEndEvent = Extract<AgentSessionEvent, { type: "auto_retry_end" }>;
+type AutoRetryStartEvent = Extract<AgentSessionEvent, { type: "auto_retry_start" }>;
+
+const HINT_MS = 141_023_000;
+const MOCK_API_SOURCE = "agent-session-retry-long-429-test";
+const PROVIDER_SESSION_ID = "long-429-session";
+/** Anthropic's account rate-limit body: classified as a usage limit, and the shape Kieran's subagent hit. */
+const ACCOUNT_RATE_LIMIT_429 =
+	'429 {"type":"error","error":{"type":"rate_limit_error","message":"This request would exceed your account\'s rate limit. Please try again later."},"request_id":"req_011CZ"} ' +
+	`retry-after-ms=${HINT_MS}`;
+/** The same hint on a plain 429 the classifier calls transient only, never a usage limit. */
+const TRANSIENT_429 = `429 Too Many Requests retry-after-ms=${HINT_MS}`;
+
+/**
+ * Contract: a 429 that carries a retry hint of ~39 hours (classified as a transient rate limit, not a usage
+ * limit) never leaves the session wedged. Past `retry.maxDelayMs` the saga ends cleanly: `auto_retry_end`
+ * reports the failure, `prompt()` settles, the session is neither retrying nor streaming, and a later message
+ * is accepted. With a sibling stored credential that is not blocked, the failing credential is blocked until
+ * its hint and the turn retries on the sibling at once.
+ */
+describe("AgentSession long transient 429 recovery", () => {
+	let tempDir: TempDir;
+	let authStorage: AuthStorage;
+	let modelRegistry: ModelRegistry;
+	let session: AgentSession | undefined;
+
+	beforeAll(async () => {
+		tempDir = TempDir.createSync("@pi-retry-long-429-");
+		authStorage = await AuthStorage.create(path.join(tempDir.path(), "testauth.db"));
+		modelRegistry = new ModelRegistry(authStorage, path.join(tempDir.path(), "models.yml"));
+	});
+
+	beforeEach(async () => {
+		vi.spyOn(envApiKey, "getEnvApiKey").mockReturnValue(undefined);
+		await authStorage.credentials.remove("anthropic");
+		authStorage.keys.removeRuntime("anthropic");
+		modelRegistry.clearSuppressedSelectors();
+	});
+
+	afterEach(async () => {
+		if (session) {
+			session.abortRetry();
+			await session.dispose();
+			session = undefined;
+		}
+		unregisterCustomApis(MOCK_API_SOURCE);
+		vi.restoreAllMocks();
+	});
+
+	afterAll(() => {
+		authStorage.close();
+		tempDir.removeSync();
+	});
+
+	/** Parks any timer of an hour or more; the saga must never reach one. */
+	function parkLongSleeps(): { longSleeps: number[] } {
+		const longSleeps: number[] = [];
+		const realWait = scheduler.wait.bind(scheduler);
+		vi.spyOn(scheduler, "wait").mockImplementation((delayMs, options) => {
+			if (delayMs < 60 * 60 * 1000) return realWait(delayMs, options);
+			longSleeps.push(delayMs);
+			const parked = Promise.withResolvers<void>();
+			const signal = options?.signal;
+			const abort = () => parked.reject(signal?.reason ?? new Error("Aborted"));
+			if (signal?.aborted) abort();
+			else signal?.addEventListener("abort", abort, { once: true });
+			return parked.promise;
+		});
+		return { longSleeps };
+	}
+
+	/** Session on a mock model whose handler sees the API key each request resolved; `handler` picks the response. */
+	function createSession(handler: (apiKey: string, call: number) => MockResponse) {
+		const model = getBundledModel("anthropic", "claude-sonnet-4-5");
+		if (!model) throw new Error("Expected bundled Anthropic test model to exist");
+		registerMockApi(MOCK_API_SOURCE);
+		const apiKeys: string[] = [];
+		const mock = createMockModel({
+			id: model.id,
+			provider: model.provider,
+			handler: (_context, options) => {
+				const apiKey = typeof options?.apiKey === "string" ? options.apiKey : undefined;
+				if (!apiKey) throw new Error("Expected streamSimple to pass a resolved string API key");
+				apiKeys.push(apiKey);
+				return handler(apiKey, apiKeys.length);
+			},
+		});
+		const agent = new Agent({
+			getApiKey: requestedModel => modelRegistry.resolver(requestedModel, PROVIDER_SESSION_ID),
+			sessionId: PROVIDER_SESSION_ID,
+			initialState: { model, systemPrompt: ["Test"], tools: [], messages: [] },
+			streamFn: (_requestedModel, context, options) => aiStream.streamSimple(mock.model, context, options),
+		});
+		const settings = Settings.isolated({
+			"compaction.enabled": false,
+			"retry.enabled": true,
+			"retry.baseDelayMs": 5,
+			"retry.maxRetries": 5,
+			"retry.maxDelayMs": 60_000,
+			"retry.waitForUsageReset": true,
+			"retry.modelFallback": true,
+		});
+		settings.setModelRole("default", `${model.provider}/${model.id}`);
+		const created = new AgentSession({
+			agent,
+			sessionManager: SessionManager.inMemory(),
+			settings,
+			modelRegistry,
+			providerSessionId: PROVIDER_SESSION_ID,
+		});
+		session = created;
+		const retryStarts: AutoRetryStartEvent[] = [];
+		const retryEnds: AutoRetryEndEvent[] = [];
+		created.subscribe(event => {
+			if (event.type === "auto_retry_start") retryStarts.push(event);
+			if (event.type === "auto_retry_end") retryEnds.push(event);
+		});
+		return { created, mock, retryStarts, retryEnds, apiKeys };
+	}
+
+	for (const [label, error] of [
+		["an account rate-limit 429 (usage limit)", ACCOUNT_RATE_LIMIT_429],
+		["a transient-only 429", TRANSIENT_429],
+	] as const) {
+		describe(label, () => {
+			it("ends the saga cleanly when no other credential exists, and accepts input afterwards", async () => {
+				await authStorage.credentials.set("anthropic", [{ type: "api_key", key: "only-key" }]);
+				const { longSleeps } = parkLongSleeps();
+				const { created, mock, retryStarts, retryEnds } = createSession((_key, call) =>
+					call === 1 ? { throw: error } : { content: ["answered after the failure"], stopReason: "stop" },
+				);
+
+				await created.prompt("first");
+				await created.waitForIdle();
+
+				expect(longSleeps).toEqual([]);
+				expect(retryStarts).toHaveLength(0);
+				expect(retryEnds).toHaveLength(1);
+				expect(retryEnds[0]).toMatchObject({ success: false });
+				expect(retryEnds[0].finalError).toContain("retry-after-ms");
+				expect(created.isRetrying).toBe(false);
+				expect(created.isStreaming).toBe(false);
+				expect(mock.calls).toHaveLength(1);
+				expect((created.agent.state.messages.at(-1) as AssistantMessage).stopReason).toBe("error");
+				// A later message runs instead of being refused as busy.
+				await created.prompt("second");
+				await created.waitForIdle();
+				expect(mock.calls).toHaveLength(2);
+				expect((created.agent.state.messages.at(-1) as AssistantMessage).stopReason).toBe("stop");
+			});
+
+			it("retries on a free sibling credential at once and leaves the failing one blocked", async () => {
+				await authStorage.credentials.set("anthropic", [
+					{ type: "api_key", key: "key-a" },
+					{ type: "api_key", key: "key-b" },
+				]);
+				const { longSleeps } = parkLongSleeps();
+				let failedKey: string | undefined;
+				const { created, mock, retryStarts, retryEnds, apiKeys } = createSession(key => {
+					failedKey ??= key;
+					return key === failedKey
+						? { throw: error }
+						: { content: ["answered on the sibling"], stopReason: "stop" };
+				});
+
+				await created.prompt("first");
+				await created.waitForIdle();
+
+				expect(longSleeps).toEqual([]);
+				expect(mock.calls).toHaveLength(2);
+				expect(new Set(apiKeys).size).toBe(2);
+				expect(retryEnds.every(event => event.success)).toBe(true);
+				expect(retryStarts.every(event => event.delayMs === 0)).toBe(true);
+				expect((created.agent.state.messages.at(-1) as AssistantMessage).stopReason).toBe("stop");
+				expect(created.isRetrying).toBe(false);
+				expect(created.isStreaming).toBe(false);
+				// The failing key stays out of rotation until its hint: a fresh session never picks it first.
+				const next = await modelRegistry.getApiKey(created.model!, "another-session");
+				expect(next).not.toBe(failedKey);
+			});
+		});
+	}
+});
