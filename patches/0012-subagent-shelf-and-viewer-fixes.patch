+
+/**
+ * Contract: a retry back-off that sleeps for hours (a provider usage-limit reset) must not hold a message the
+ * operator types meanwhile. A user-attributed steer ends the sleep as if the delay had run out, so the retry
+ * runs now and the steer reaches the model on that request. Anything else (a non-user steer, a follow-up) keeps
+ * the back-off, `abortRetry()` still cancels the retry and closes the saga, and `wakeRetryWait()` reports
+ * whether a sleep was waiting.
+ *
+ * The back-off's timer is replaced by one that never fires on its own and only rejects when its signal aborts,
+ * so the five-hour wait costs no real time and a retry that runs proves the sleep was cut short.
+ */
+describe("AgentSession retry back-off wake-up", () => {
+	let tempDir: TempDir;
+	let authStorage: AuthStorage;
+	let modelRegistry: ModelRegistry;
+	let session: AgentSession | undefined;
+
+	beforeAll(async () => {
+		tempDir = TempDir.createSync("@pi-retry-wake-");
+		authStorage = await AuthStorage.create(path.join(tempDir.path(), "testauth.db"));
+		authStorage.keys.setRuntime("anthropic", "anthropic-test-key");
+		modelRegistry = new ModelRegistry(authStorage, path.join(tempDir.path(), "models.yml"));
+	});
+
+	afterAll(() => {
+		authStorage.close();
+		tempDir.removeSync();
+	});
+
+	beforeEach(() => {
+		modelRegistry.clearSuppressedSelectors();
+	});
+
+	afterEach(async () => {
+		if (session) {
+			// Drop any sleep a failing assertion left behind before disposing.
+			session.abortRetry();
+			await session.dispose();
+			session = undefined;
+		}
+		vi.restoreAllMocks();
+	});
+
+	interface Sleeping {
+		session: AgentSession;
+		mock: MockModel;
+		/** The `prompt()` call that entered the back-off; settles when the saga does. */
+		run: Promise<unknown>;
+		/** The signal of the hours-long back-off timer: aborted once the sleep is woken or cancelled. */
+		sleepSignal: AbortSignal;
+		retryStarts: AutoRetryStartEvent[];
+		retryEnds: AutoRetryEndEvent[];
+	}
+
+	/** A session whose first request fails with a five-hour usage-limit reset and is now sleeping in the back-off. */
+	async function enterBackoff(): Promise<Sleeping> {
+		const model = getBundledModel("anthropic", "claude-sonnet-4-5");
+		if (!model) throw new Error("Expected bundled Anthropic test model to exist");
