diff --git a/packages/coding-agent/test/background-completion-line.test.ts b/packages/coding-agent/test/background-completion-line.test.ts
new file mode 100644
index 0000000000..80978cf61e
--- /dev/null
+++ b/packages/coding-agent/test/background-completion-line.test.ts
@@ -0,0 +1,106 @@
+/**
+ * Contract: the "Background job completed" line of a finished task job carries what its subagent used beside the
+ * elapsed time, `(8m3s · 11M tok · $2.25)`, coloured like the pinned shelf's counter. A job with no usage keeps its
+ * plain duration, and the line never shows an empty separator.
+ */
+import { beforeAll, describe, expect, it } from "bun:test";
+import type { AsyncJob } from "@oh-my-pi/pi-coding-agent/async/job-manager";
+import {
+	type AsyncResultEntry,
+	buildAsyncResultBatchMessage,
+} from "@oh-my-pi/pi-coding-agent/session/async-job-delivery";
+import { buildAsyncResultBlock } from "@oh-my-pi/pi-tui/chat/transcript-render-helpers";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+
+const ESCAPE = String.fromCharCode(27);
+const SGR = new RegExp(`${ESCAPE}\\[[0-9;]*m`, "g");
+
+function taskEntry(progress: Record<string, unknown> | undefined, durationMs: number | undefined): AsyncResultEntry {
+	const job: AsyncJob = {
+		id: "StatusLineModels",
+		type: "task",
+		status: "completed",
+		startTime: Date.now(),
+		label: "StatusLineModels",
+		agentId: "StatusLineModels",
+		abortController: new AbortController(),
+		promise: Promise.resolve(),
+		resultText: "done",
+		latestDetails: progress ? { progress: [{ id: "Other", tokens: 1, cost: 9 }, progress] } : undefined,
+	};
+	return { jobId: "StatusLineModels", result: "done", job, durationMs, epoch: 0 };
+}
+
+function renderLine(entry: AsyncResultEntry, persisted = false, raw = false): string {
+	const built = buildAsyncResultBatchMessage([entry]);
+	if (!built) throw new Error("Expected an async-result message");
+	const message = persisted ? (JSON.parse(JSON.stringify(built)) as typeof built) : built;
+	const lines = buildAsyncResultBlock(message).render(200);
+	return lines.map(line => (raw ? line : Bun.stripANSI(line))).join("\n");
+}
+
+/** The SGR escapes in force right before `text` in `raw`. */
+function styleBefore(raw: string, text: string): string {
+	const at = raw.indexOf(text);
+	if (at < 0) throw new Error(`${text} not found in ${JSON.stringify(raw)}`);
+	return raw.slice(0, at).match(SGR)?.at(-1) ?? "";
+}
+
+describe("background job completion line", () => {
+	beforeAll(async () => {
+		await initTheme(false, undefined, undefined, "dark", "light");
+	});
+
+	it("shows elapsed time, total tokens with cache reads, and cost after the job id", () => {
+		const entry = taskEntry(
+			{ id: "StatusLineModels", tokens: 1_000_000, cacheReadTokens: 10_000_000, cost: 2.25 },
+			483_000,
+		);
+		for (const persisted of [false, true]) {
+			const line = renderLine(entry, persisted);
+			expect(line).toContain("Background job completed");
+			expect(line).toContain("[task]");
+			expect(line).toContain("StatusLineModels (8m3s · 11M tok · $2.25)");
+		}
+	});
+
+	it("leaves out the cost while it is zero and the tokens while none were used, with no empty separator", () => {
+		expect(renderLine(taskEntry({ id: "StatusLineModels", tokens: 2_000, cost: 0 }, 61_000))).toContain(
+			"(1m1s · 2K tok)",
+		);
+		expect(renderLine(taskEntry({ id: "StatusLineModels", tokens: 0, cost: 0.5 }, 61_000))).toContain(
+			"(1m1s · $0.500)",
+		);
+		for (const line of [
+			renderLine(taskEntry({ id: "StatusLineModels", tokens: 2_000, cost: 0 }, undefined)),
+			renderLine(taskEntry({ id: "StatusLineModels", tokens: 0, cost: 0 }, 61_000)),
+			renderLine(taskEntry(undefined, 61_000)),
+		]) {
+			expect(line).not.toMatch(/·\s*\)|\(\s*·|·\s*·/);
+		}
+	});
+
+	it("keeps the plain duration for a job that reports no usage", () => {
+		expect(renderLine(taskEntry({ id: "StatusLineModels", tokens: 0, cost: 0 }, 61_000))).toContain(
+			"StatusLineModels (1m1s)",
+		);
+		expect(renderLine(taskEntry(undefined, 61_000))).toContain("StatusLineModels (1m1s)");
+	});
+
+	it("reads usage for the job's own agent from a batch's progress list", () => {
+		const line = renderLine(taskEntry({ id: "StatusLineModels", tokens: 5_000, cost: 0.2 }, 61_000));
+		expect(line).toContain("5K tok");
+		expect(line).not.toContain("$9");
+	});
+
+	it("colours the elapsed time, tokens and cost differently and keeps the separators muted", () => {
+		const raw = renderLine(taskEntry({ id: "StatusLineModels", tokens: 5_000, cost: 0.2 }, 600_000), false, true);
+		const elapsed = styleBefore(raw, "10m");
+		const tokens = styleBefore(raw, "5K tok");
+		const cost = styleBefore(raw, "$0.200");
+		expect(new Set([elapsed, tokens, cost]).size).toBe(3);
+		// The dots between the figures stay muted, like the brackets around them.
+		expect(styleBefore(raw, "·")).toBe(styleBefore(raw, "("));
+		expect(styleBefore(raw, "·")).not.toBe(elapsed);
+	});
+});
