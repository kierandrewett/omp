+		// Park timers of an hour or more until their signal aborts; every other wait runs as usual.
+		const entered = Promise.withResolvers<AbortSignal>();
+		const realWait = scheduler.wait.bind(scheduler);
+		vi.spyOn(scheduler, "wait").mockImplementation((delayMs, options) => {
+			const signal = options?.signal;
+			if (delayMs < 60 * 60 * 1000 || !signal) return realWait(delayMs, options);
+			entered.resolve(signal);
+			const parked = Promise.withResolvers<void>();
+			const abort = () => parked.reject(signal.reason ?? new Error("Aborted"));
+			if (signal.aborted) abort();
