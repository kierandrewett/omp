diff --git a/packages/tui/src/chrome/usage-counter.ts b/packages/tui/src/chrome/usage-counter.ts
new file mode 100644
index 0000000000..6900378503
--- /dev/null
+++ b/packages/tui/src/chrome/usage-counter.ts
@@ -0,0 +1,59 @@
+import { formatDuration, formatNumber } from "@oh-my-pi/pi-utils";
+import { formatCost } from "../overlays/agent-hub-renderer";
+import { type ThemeColor, theme } from "../theme/theme";
+
+/** What a subagent or background task consumed: the elapsed time, its total tokens and its API cost. */
+export interface UsageCounterInput {
+	/** Elapsed run time in ms. Left out below a second, where a clock only adds noise. */
+	elapsedMs?: number;
+	/** Total tokens the model processed, cache reads included. Left out at zero. */
+	tokens?: number;
+	/** API cost in USD. Left out while zero, because a subscription or unpriced model reports zero and `$0.00` would read as free. */
+	cost?: number;
+}
+
+/** Elapsed times from which the clock turns from green to warning, then to error. */
+const ELAPSED_WARNING_MS = 3 * 60_000;
+const ELAPSED_ERROR_MS = 20 * 60_000;
+
+/** Costs, in USD, from which the figure turns from green to warning, then to error. */
+const COST_WARNING = 1;
+const COST_ERROR = 10;
+
+/** Elapsed time runs hotter the longer it gets. */
+export function elapsedColor(elapsedMs: number): ThemeColor {
+	if (elapsedMs >= ELAPSED_ERROR_MS) return "error";
+	if (elapsedMs >= ELAPSED_WARNING_MS) return "warning";
+	return "success";
+}
+
+/** Cost runs hotter the more it grows. */
+export function costColor(cost: number): ThemeColor {
+	if (cost >= COST_ERROR) return "error";
+	if (cost >= COST_WARNING) return "warning";
+	return "success";
+}
+
+/**
+ * The counter shown beside a subagent or finished background task, longest form first, for example
+ * `2m5s · 1.4M tok · $0.42`, then the elapsed time alone for a row too narrow for the lot. The three figures each
+ * take their own theme colour and the dots between them stay muted, so the text is the same on a theme that
+ * paints nothing. Empty when there is nothing to show.
+ */
+export function usageCounterForms(input: UsageCounterInput): string[] {
+	const dot = theme.fg("muted", theme.sep.dot);
+	const elapsed =
+		input.elapsedMs !== undefined && input.elapsedMs >= 1000
+			? theme.fg(elapsedColor(input.elapsedMs), formatDuration(input.elapsedMs))
+			: undefined;
+	const usage: string[] = [];
+	if (input.tokens !== undefined && input.tokens > 0) {
+		usage.push(theme.fg("statusLineSpend", `${formatNumber(input.tokens)} tok`));
+	}
+	if (input.cost !== undefined && input.cost > 0) {
+		usage.push(theme.fg(costColor(input.cost), formatCost(input.cost)));
+	}
+	const full = [...(elapsed ? [elapsed] : []), ...usage].join(dot);
+	if (!full) return [];
+	return elapsed && usage.length > 0 ? [full, elapsed] : [full];
+}
