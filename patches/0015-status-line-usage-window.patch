diff --git a/packages/coding-agent/test/status-line-usage-bar.test.ts b/packages/coding-agent/test/status-line-usage-bar.test.ts
new file mode 100644
index 0000000000..f15f50f88b
--- /dev/null
+++ b/packages/coding-agent/test/status-line-usage-bar.test.ts
@@ -0,0 +1,201 @@
+/**
+ * The `usage_bar` segment reads the cached usage reports the status line already fetches. These tests feed it
+ * reports shaped like `omp usage --json` for two Anthropic accounts: one over its weekly cap with no 5 Hour row,
+ * one with a busy session and a quiet week.
+ */
+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { resetSettingsForTest, Settings, settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { statusLineHost } from "@oh-my-pi/pi-coding-agent/modes/status-line-host";
+import { cfgStatusLineUsageWindow } from "@oh-my-pi/pi-coding-agent/modes/settings";
+import { StatusLineComponent } from "@oh-my-pi/pi-tui/status-line";
+import { initTheme, theme } from "@oh-my-pi/pi-tui/theme";
+import { StatusLineTestComponents } from "./helpers/status-line";
+
+const statusLines = new StatusLineTestComponents();
+
+beforeAll(async () => {
+	resetSettingsForTest();
+	await Settings.init({ inMemory: true });
+	await initTheme();
+});
+
+afterAll(() => {
+	statusLines.dispose();
+	resetSettingsForTest();
+});
+
+const RESET_AT = Date.now() + 48 * 3_600_000;
+
+interface FixtureLimit {
+	windowId: "5h" | "7d";
+	used: number;
+	tier?: string;
+}
+
+function report(account: { email: string; accountId: string; orgId: string }, limits: FixtureLimit[]) {
+	return {
+		provider: "anthropic",
+		fetchedAt: Date.now(),
+		metadata: { ...account },
+		limits: limits.map(limit => ({
+			id: `anthropic:${limit.windowId}${limit.tier ? `:${limit.tier}` : ""}`,
+			label: limit.windowId,
+			scope: {
+				provider: "anthropic",
+				windowId: limit.windowId,
+				...(limit.tier ? { tier: limit.tier } : { shared: true }),
+			},
+			window: { id: limit.windowId, resetsAt: RESET_AT },
+			amount: { usedFraction: limit.used },
+		})),
+	};
+}
+
+const ACCOUNT_A = { email: "a@example.com", accountId: "acc-a", orgId: "org-a" };
+const ACCOUNT_B = { email: "b@example.com", accountId: "acc-b", orgId: "org-b" };
+
+/** A: weekly cap reached, no 5 Hour row reported; Fable counter far lower. B: busy session, quiet week, hot Fable counter. */
+const REPORTS = [
+	report(ACCOUNT_A, [
+		{ windowId: "7d", used: 1 },
+		{ windowId: "7d", used: 0.14, tier: "fable" },
+	]),
+	report(ACCOUNT_B, [
+		{ windowId: "5h", used: 0.29 },
+		{ windowId: "7d", used: 0.08 },
+		{ windowId: "7d", used: 0.9, tier: "fable" },
+	]),
+];
+
+function bar(filled: number): string {
+	return theme.progress.filled.repeat(filled) + theme.progress.empty.repeat(5 - filled);
+}
+
+async function flush(): Promise<void> {
+	const timer = Promise.withResolvers<void>();
+	setTimeout(timer.resolve, 0);
+	await timer.promise;
+	for (let i = 0; i < 4; i++) await Promise.resolve();
+}
+
+/** A status line whose session is on `account` (undefined: no resolved identity), with usage already fetched. */
+async function makeBar(
+	account: typeof ACCOUNT_A | undefined,
+	modelId = "claude-sonnet-5-5",
+	reports: unknown = REPORTS,
+): Promise<StatusLineComponent> {
+	const model = { id: modelId, contextWindow: 1000, provider: "anthropic" };
+	const component = statusLines.track(
+		new StatusLineComponent(
+			{
+				state: { messages: [], model },
+				model,
+				sessionManager: {
+					getUsageStatistics: () => ({
+						input: 0,
+						output: 0,
+						cacheRead: 0,
+						cacheWrite: 0,
+						totalTokens: 0,
+						orchestrationInput: 0,
+						orchestrationOutput: 0,
+						orchestrationCacheRead: 0,
+						premiumRequests: 0,
+						cost: 0,
+					}),
+				},
+				fetchUsageReports: async () => reports,
+				modelRegistry: { authStorage: { oauth: { identity: () => account } } },
+				getAsyncJobSnapshot: () => ({ running: [] }),
+				getContextUsage: () => undefined,
+			} as unknown as ConstructorParameters<typeof StatusLineComponent>[0],
+			statusLineHost,
+		),
+	);
+	component.updateSettings({ preset: "custom", leftSegments: [], rightSegments: ["usage_bar"], sessionAccent: false });
+	component.refreshUsageInBackground();
+	await flush();
+	return component;
+}
+
+function barText(component: StatusLineComponent): string {
+	return Bun.stripANSI(component.getTopBorder(200).content).replace(/[─]{6,}/g, "");
+}
+
+async function renderBar(account: typeof ACCOUNT_A | undefined, modelId?: string, reports?: unknown): Promise<string> {
+	return barText(await makeBar(account, modelId, reports)).trim();
+}
+
+describe("usage_bar reads the active account's report", () => {
+	it("draws a full weekly bar for an account whose 7 Day row is 100% used", async () => {
+		expect(await renderBar(ACCOUNT_A)).toContain(`${bar(5)} 100% 7d`);
+	});
+
+	it("draws the second account's own windows, not the first report's", async () => {
+		const b = await renderBar(ACCOUNT_B);
+
+		expect(b).toContain(`${bar(0)} 8% 7d`);
+		expect(b).not.toContain("100%");
+	});
+
+	it("follows the session account's 5 Hour row under `session`, and falls back to 7d when it has none", async () => {
+		cfgStatusLineUsageWindow.override(settings, "session");
+		try {
+			expect(await renderBar(ACCOUNT_B)).toContain(`${bar(1)} 29% 5h`);
+			expect(await renderBar(ACCOUNT_A)).toContain("100% 7d");
+		} finally {
+			cfgStatusLineUsageWindow.clearOverride(settings);
+		}
+	});
+
+	it("shows the most used window under `worst`", async () => {
+		cfgStatusLineUsageWindow.override(settings, "worst");
+		try {
+			expect(await renderBar(ACCOUNT_B)).toContain("29% 5h");
+		} finally {
+			cfgStatusLineUsageWindow.clearOverride(settings);
+		}
+	});
+
+	it("uses the Fable weekly row for a Fable model when it is the more used one", async () => {
+		expect(await renderBar(ACCOUNT_B, "claude-fable-5")).toContain("90% 7d fable");
+		// A's shared weekly row (100%) outranks its Fable row (14%), as credential ranking sees it.
+		expect(await renderBar(ACCOUNT_A, "claude-fable-5")).toContain("100% 7d");
+		expect(await renderBar(ACCOUNT_A, "claude-fable-5")).not.toContain("fable");
+		// A non-Fable model ignores the Fable counter.
+		expect(await renderBar(ACCOUNT_B, "claude-sonnet-5-5")).toContain("8% 7d");
+	});
+
+	it("shows nothing rather than a mixed account when no account identity is resolved", async () => {
+		expect(await renderBar(undefined)).not.toContain("%");
+	});
+
+	it("still shows the only report's windows when the session has no resolved identity", async () => {
+		expect(await renderBar(undefined, "claude-sonnet-5-5", [REPORTS[1]])).toContain("8% 7d");
+	});
+});
+
+describe("statusLine.usageWindow", () => {
+	it("defaults to weekly and is read live by the status-line host", () => {
+		expect(statusLineHost.usageWindow?.()).toBe("weekly");
+		cfgStatusLineUsageWindow.override(settings, "session");
+		try {
+			expect(statusLineHost.usageWindow?.()).toBe("session");
+		} finally {
+			cfgStatusLineUsageWindow.clearOverride(settings);
+		}
+		expect(statusLineHost.usageWindow?.()).toBe("weekly");
+	});
+
+	it("repaints an already rendered bar when the setting changes", async () => {
+		const component = await makeBar(ACCOUNT_B);
+		expect(barText(component)).toContain("8% 7d");
+
+		cfgStatusLineUsageWindow.override(settings, "session");
+		try {
+			expect(barText(component)).toContain("29% 5h");
+		} finally {
+			cfgStatusLineUsageWindow.clearOverride(settings);
+		}
+	});
+});
