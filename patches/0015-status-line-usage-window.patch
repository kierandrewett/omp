+/**
+ * Weekly tier counter the active model answers to: Claude's model-scoped 7 Day rows (Fable, Mythos,
+ * Opus, Sonnet) apply only to their own family, the same mapping `findClaudeSecondaryLimit` in
+ * `packages/ai/src/usage/claude.ts` uses when ranking credentials. Undefined for every other model.
+ */
+function modelWeeklyTier(provider: string | undefined, modelId: string | undefined): string | undefined {
+	if (provider !== "anthropic" || !modelId) return undefined;
+	const { family } = classifyModel(provider, modelId, { lenient: true });
+	return family === "opus" || family === "sonnet" || family === "fable" || family === "mythos" ? family : undefined;
+}
+
+/** Reports of `provider` (any provider when undefined) that carry a limit list. */
+function countProviderUsageReports(reports: readonly unknown[], provider: string | undefined): number {
+	let count = 0;
+	for (const report of reports) {
+		if (!report || typeof report !== "object" || !("limits" in report) || !Array.isArray(report.limits)) continue;
+		if (provider && (!("provider" in report) || report.provider !== provider)) continue;
+		count++;
+	}
+	return count;
+}
+
