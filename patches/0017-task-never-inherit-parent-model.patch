diff --git a/packages/coding-agent/test/task/task-never-inherit-parent-model.test.ts b/packages/coding-agent/test/task/task-never-inherit-parent-model.test.ts
new file mode 100644
index 0000000000..28cf576c3f
--- /dev/null
+++ b/packages/coding-agent/test/task/task-never-inherit-parent-model.test.ts
@@ -0,0 +1,377 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import type { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import * as judgmentModule from "@oh-my-pi/pi-coding-agent/judgment";
+import { resetRegisteredArtifactDirsForTests } from "@oh-my-pi/pi-coding-agent/internal-urls/registry-helpers";
+import * as autoModelModule from "@oh-my-pi/pi-coding-agent/task/auto-model";
+import * as discoveryModule from "@oh-my-pi/pi-coding-agent/task/discovery";
+import * as executorModule from "@oh-my-pi/pi-coding-agent/task/executor";
+import { formatTaskResultSummary } from "@oh-my-pi/pi-coding-agent/task/result-summary";
+import {
+	resolveEffectiveSubagentPolicy,
+	runStructuredSubagent,
+	StructuredSubagentError,
+	type StructuredSubagentRequest,
+} from "@oh-my-pi/pi-coding-agent/task/structured-subagent";
+import type { AgentDefinition } from "@oh-my-pi/pi-coding-agent/task/types";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import type { SingleResult } from "@oh-my-pi/pi-tui/tools/task";
+
+/**
+ * A subagent never defaults to the parent's model. Every spawn without a per-call, host or seance model goes
+ * through classification. These tests run the real preflight and dispatch path (policy, classifier, artifact
+ * lease) with the judge stubbed and the child process mocked, so what they show is what a spawn would start.
+ */
+
+const PARENT = "mock/parent-model";
+const MODELS = [1, 2, 3].map(step =>
+	createMockModel({ id: `m${step}`, cost: { input: step, output: step, cacheRead: 0, cacheWrite: 0 } }),
+);
+const registry = { getAll: () => MODELS, getAvailable: () => MODELS } as unknown as ModelRegistry;
+
+/** A worker with no model of its own, so only classification, an override or nothing can choose one. */
+const BARE_AGENT: AgentDefinition = {
+	name: "worker",
+	description: "Test worker",
+	systemPrompt: "Do the assigned work.",
+	source: "bundled",
+};
+
+type Notice = { level: string; message: string; source?: string };
+
+interface Harness {
+	childSession: ToolSession;
+	notices: Notice[];
+	dispatched: executorModule.ExecutorOptions[];
+}
+
+function harness(settings: Record<string, unknown> = {}, agent: AgentDefinition = BARE_AGENT): Harness {
+	vi.spyOn(discoveryModule, "discoverAgents").mockResolvedValue({ agents: [agent], projectAgentsDir: null });
+	const notices: Notice[] = [];
+	const dispatched: executorModule.ExecutorOptions[] = [];
+	vi.spyOn(executorModule, "runSubprocess").mockImplementation(async options => {
+		dispatched.push(options);
+		return result();
+	});
+	const childSession = {
+		cwd: "/tmp",
+		hasUI: false,
+		settings: Settings.isolated({ "task.maxRecursionDepth": 2, "task.isolation.enabled": false, ...settings }),
+		getSessionFile: () => null,
+		getSessionSpawns: () => "*",
+		getSessionAgents: () => [],
+		getPlanModeState: () => undefined,
+		modelRegistry: registry,
+		// The parent runs on PARENT; nothing below may ever hand it to a child.
+		getActiveModelString: () => PARENT,
+		getModelString: () => PARENT,
+		emitNotice: (level: string, message: string, source?: string) => notices.push({ level, message, source }),
+	} as unknown as ToolSession;
+	return { childSession, notices, dispatched };
+}
+
+function request(session: ToolSession, overrides: Partial<StructuredSubagentRequest> = {}): StructuredSubagentRequest {
+	return { session, invocationKind: "task", assignment: "Inspect the target.", agent: "worker", ...overrides };
+}
+
+function result(): SingleResult {
+	return {
+		index: 0,
+		id: "Worker",
+		agent: "worker",
+		agentSource: "bundled",
+		task: "Inspect the target.",
+		exitCode: 0,
+		output: "ok",
+		stderr: "",
+		truncated: false,
+		durationMs: 1,
+		tokens: 0,
+		requests: 1,
+	};
+}
+
+/**
+ * Stand in for the native judge: `answer` is the judge's reply, a thrown error is its failure, and
+ * `"timeout"` is a judge that outlives its deadline (the deadline signal is already aborted, so no real timer runs).
+ */
+function stubJudge(answer: { choice: string; confident: boolean } | Error | "timeout"): { calls: () => number } {
+	let calls = 0;
+	if (answer === "timeout") {
+		vi.spyOn(AbortSignal, "timeout").mockImplementation(() => {
+			const controller = new AbortController();
+			controller.abort(new DOMException("The operation timed out.", "TimeoutError"));
+			return controller.signal;
+		});
+	}
+	vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(true);
+	vi.spyOn(judgmentModule, "resolveJudge").mockReturnValue({
+		withCandidate: async (run: (candidate: unknown, kind: string) => Promise<unknown>) =>
+			run(
+				{
+					judge: async (_input: unknown, options?: { signal?: AbortSignal }) => {
+						calls += 1;
+						if (answer === "timeout") {
+							options?.signal?.throwIfAborted();
+							throw new Error("the judge was expected to outlive its deadline");
+						}
+						if (answer instanceof Error) throw answer;
+						const other = answer.choice === "haiku" ? "sonnet" : "haiku";
+						const high = answer.confident ? 0.95 : 0.4;
+						return {
+							answers: {
+								model: {
+									choice: answer.choice,
+									confidence: high,
+									probabilities: { [answer.choice]: high, [other]: 1 - high },
+								},
+							},
+						};
+					},
+				},
+				"native",
+			),
+	} as never);
+	return { calls: () => calls };
+}
+
+function noNativeJudge(): void {
+	vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(false);
+	vi.spyOn(judgmentModule, "resolveJudge").mockImplementation(() => {
+		throw new Error("the judge must not run without a native judge");
+	});
+}
+
+afterEach(() => {
+	vi.restoreAllMocks();
+	resetRegisteredArtifactDirsForTests();
+});
+
+describe("a subagent never defaults to the parent model", () => {
+	it.each(["task", "eval"] as const)(
+		"fails a %s spawn before anything starts when no alias and no explicit model exist",
+		async invocationKind => {
+			const { childSession, dispatched, notices } = harness();
+			const classify = vi.spyOn(autoModelModule, "classifyAutoTaskModel");
+
+			const failure = await runStructuredSubagent(request(childSession, { invocationKind })).catch(error => error);
+
+			expect(failure).toBeInstanceOf(StructuredSubagentError);
+			expect((failure as StructuredSubagentError).kind).toBe("preflight");
+			const message = (failure as StructuredSubagentError).message;
+			expect(message).toContain("Subagent not started");
+			expect(message).toContain("no usable role alias exists (0 configured, 0 usable)");
+			expect(message).toContain("the user must add at least two role aliases to modelRoles, or fix the judge.");
+			expect(message).toContain("The parent agent must stop and report this to the user.");
+			expect(message).toContain("must not change settings and must not choose a model");
+			// The error never offers the parent's model, and never invites the parent to edit settings itself.
+			expect(message).not.toContain(PARENT);
+			expect(message).not.toMatch(/\bedit\b/i);
+			expect(message).not.toMatch(/(?<!not )\bchange (the )?(config|settings)\b/i);
+			expect(dispatched).toHaveLength(0);
+			expect(notices).toHaveLength(0);
+			// Preflight knows from settings alone that nothing can be chosen, so the judge is never consulted.
+			expect(classify).not.toHaveBeenCalled();
+		},
+	);
+
+	it("counts configured and usable aliases separately in the reason", async () => {
+		const { childSession, dispatched } = harness({ modelRoles: { worker: "mock/missing" } });
+
+		const failure = await runStructuredSubagent(request(childSession)).catch(error => error);
+
+		expect(failure).toBeInstanceOf(StructuredSubagentError);
+		expect((failure as StructuredSubagentError).message).toContain(
+			"no usable role alias exists (1 configured, 0 usable)",
+		);
+		expect(dispatched).toHaveLength(0);
+	});
+
+	it.each(["@default", "default", "@task"])(
+		"does not treat an agent model of %s as an explicit source, because it names the session model",
+		async inherited => {
+			const { childSession, dispatched } = harness(
+				{ modelRoles: { default: PARENT } },
+				{ ...BARE_AGENT, model: [inherited] },
+			);
+
+			await expect(runStructuredSubagent(request(childSession))).rejects.toThrow("Subagent not started");
+			expect(dispatched).toHaveLength(0);
+		},
+	);
+
+	it("fails preflight, not only dispatch, when nothing can choose a model", async () => {
+		const { childSession } = harness();
+
+		await expect(resolveEffectiveSubagentPolicy(request(childSession))).rejects.toThrow("Subagent not started");
+	});
+
+	it.each(["task", "eval"] as const)(
+		"chooses the only configured alias for a %s spawn without calling the judge",
+		async invocationKind => {
+			const { childSession, dispatched, notices } = harness({ modelRoles: { worker: "mock/m1" } });
+			const judge = stubJudge(new Error("the judge must not run for one alias"));
+
+			const settled = await runStructuredSubagent(request(childSession, { invocationKind, retainArtifacts: true }));
+
+			expect(judge.calls()).toBe(0);
+			expect(judgmentModule.resolveJudge).not.toHaveBeenCalled();
+			expect(dispatched[0]?.modelOverride).toEqual(["mock/m1"]);
+			expect(dispatched[0]?.modelRole).toBe("worker");
+			expect(dispatched[0]?.modelRoute).toBe("Automatic model selection: @worker (only one configured alias).");
+			expect(dispatched[0]?.modelWarning).toBeUndefined();
+			expect(notices).toHaveLength(0);
+			expect(Object.hasOwn(dispatched[0] ?? {}, "parentActiveModelPattern")).toBe(false);
+			await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+		},
+	);
+
+	it("keeps the judge path for two aliases", async () => {
+		const { childSession, dispatched } = harness({ modelRoles: { haiku: "mock/m1", sonnet: "mock/m3" } });
+		const judge = stubJudge({ choice: "haiku", confident: true });
+
+		const settled = await runStructuredSubagent(request(childSession, { retainArtifacts: true }));
+
+		expect(judge.calls()).toBe(1);
+		expect(dispatched[0]?.modelOverride).toEqual(["mock/m1"]);
+		expect(dispatched[0]?.modelRoute).toBe("Automatic model selection: @haiku.");
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("fails with the judge reason when two aliases exist, no judge is available and nothing explicit exists", async () => {
+		const { childSession, dispatched } = harness({ modelRoles: { haiku: "mock/m1", opus: "mock/m3" } });
+		noNativeJudge();
+
+		const failure = await runStructuredSubagent(request(childSession)).catch(error => error);
+
+		expect(failure).toBeInstanceOf(StructuredSubagentError);
+		const message = (failure as StructuredSubagentError).message;
+		expect(message).toContain("no native judge is available");
+		expect(message).not.toMatch(/sonnet|conservative|fallback/i);
+		expect(message).toContain("The parent agent must stop and report this to the user.");
+		expect(dispatched).toHaveLength(0);
+	});
+
+	it("runs the agent's own model, never the parent's, and warns visibly when two aliases exist and no judge does", async () => {
+		const { childSession, dispatched, notices } = harness(
+			{ modelRoles: { haiku: "mock/m1", opus: "mock/m3" } },
+			{ ...BARE_AGENT, model: ["mock/m2"] },
+		);
+		noNativeJudge();
+
+		const settled = await runStructuredSubagent(request(childSession, { retainArtifacts: true }));
+
+		expect(dispatched[0]?.modelOverride).toEqual(["mock/m2"]);
+		expect(dispatched[0]?.modelOverride).not.toContain(PARENT);
+		const warning = dispatched[0]?.modelWarning ?? "";
+		expect(warning).toContain("Warning: automatic model selection failed: no native judge is available");
+		expect(warning).toContain('the model of the "worker" agent definition (mock/m2)');
+		expect(warning).toContain("The parent agent must stop and report this to the user.");
+		expect(dispatched[0]?.modelRoute).toContain("Automatic model selection failed; using the model of");
+		// The user sees the same text in the interface, not only the model route.
+		expect(notices).toEqual([{ level: "warning", message: warning, source: "task-model" }]);
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("runs the task.agentModelOverrides entry and warns when classification fails", async () => {
+		const { childSession, dispatched, notices } = harness({
+			modelRoles: { haiku: "mock/m1", opus: "mock/m3" },
+			"task.agentModelOverrides": { worker: "mock/m2" },
+		});
+		noNativeJudge();
+
+		const settled = await runStructuredSubagent(request(childSession, { retainArtifacts: true }));
+
+		expect(dispatched[0]?.modelOverride).toEqual(["mock/m2"]);
+		expect(dispatched[0]?.modelWarning).toContain('the task.agentModelOverrides entry for "worker" (mock/m2)');
+		expect(notices).toHaveLength(1);
+		expect(notices[0]?.level).toBe("warning");
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it.each([
+		["the judge fails", new Error("boom"), "the judge failed (boom)"],
+		["the judge times out", "timeout", "the judge timed out after 4 seconds"],
+		["the judge is unsure", { choice: "haiku", confident: false }, "the judge gave no confident answer"],
+	] as const)(
+		"fails the spawn with the reason, and starts no child, when %s even though a @sonnet alias exists",
+		async (_name, answer, reason) => {
+			const { childSession, dispatched, notices } = harness({
+				modelRoles: { haiku: "mock/m1", sonnet: "mock/m3" },
+			});
+			const judge = stubJudge(answer);
+
+			const failure = await runStructuredSubagent(request(childSession)).catch(error => error);
+
+			// Classification ran, and nothing stood in for it.
+			expect(judge.calls()).toBe(1);
+			expect(failure).toBeInstanceOf(StructuredSubagentError);
+			expect((failure as StructuredSubagentError).kind).toBe("preflight");
+			const message = (failure as StructuredSubagentError).message;
+			expect(message).toBe(autoModelModule.autoModelFailureMessage(reason));
+			expect(message).toContain(`Automatic model selection failed: ${reason}.`);
+			expect(message).not.toMatch(/conservative|fallback/i);
+			expect(message).toContain("The parent agent must stop and report this to the user.");
+			expect(dispatched).toHaveLength(0);
+			expect(notices).toHaveLength(0);
+		},
+	);
+
+	it.each([
+		["the judge fails", new Error("boom"), "the judge failed (boom)"],
+		["the judge times out", "timeout", "the judge timed out after 4 seconds"],
+		["the judge is unsure", { choice: "haiku", confident: false }, "the judge gave no confident answer"],
+	] as const)("runs the agent's own model with the reason as a warning when %s", async (_name, answer, reason) => {
+		const { childSession, dispatched, notices } = harness(
+			{ modelRoles: { haiku: "mock/m1", sonnet: "mock/m3" } },
+			{ ...BARE_AGENT, model: ["mock/m2"] },
+		);
+		stubJudge(answer);
+
+		const settled = await runStructuredSubagent(request(childSession, { retainArtifacts: true }));
+
+		expect(dispatched[0]?.modelOverride).toEqual(["mock/m2"]);
+		expect(dispatched[0]?.modelWarning).toBe(
+			autoModelModule.autoModelWarning(reason, 'the model of the "worker" agent definition (mock/m2)'),
+		);
+		expect(notices).toHaveLength(1);
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("never classifies a per-call, host or seance model", async () => {
+		const { childSession, dispatched } = harness({
+			"task.perCallModel": "on",
+			modelRoles: { review: "mock/m1" },
+		});
+		const classify = vi.spyOn(autoModelModule, "classifyAutoTaskModel");
+
+		const perCall = await runStructuredSubagent(
+			request(childSession, { perCallModel: "mock/m1", retainArtifacts: true }),
+		);
+		const host = await runStructuredSubagent(request(childSession, { model: "mock/m2", retainArtifacts: true }));
+
+		expect(classify).not.toHaveBeenCalled();
+		expect(dispatched.map(options => options.modelOverride)).toEqual([["mock/m1"], ["mock/m2"]]);
+		expect(dispatched.map(options => options.modelWarning)).toEqual([undefined, undefined]);
+		await fs.rm(perCall.artifactsDir, { recursive: true, force: true });
+		await fs.rm(host.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("shows the user's warning in the result the parent reads", () => {
+		const summary = formatTaskResultSummary(
+			{
+				...result(),
+				resolvedModel: "mock/m2",
+				resolvedModelWarning: "Warning: the subagent started on mock/m2 but its model changed to mock/m1.",
+			},
+			{ totalDurationMs: 5 },
+		);
+
+		expect(summary).toContain("<model>mock/m2</model>");
+		expect(summary).toContain(
+			"<model-warning>Warning: the subagent started on mock/m2 but its model changed to mock/m1.</model-warning>",
+		);
+	});
+});
