+/**
+ * Pins a subagent to the one model it started on. The only fallback chain it may keep is one the user wrote
+ * under that exact model's own `provider/id` key in `retry.fallbackChains`. Role chains, the `default` chain,
+ * provider wildcards and the other entries of an agent's model list would move the child to a model nobody
+ * chose for it, so every other configured chain is emptied for this session. Settings layers merge by key, so
+ * a dropped chain is an explicit empty one, which means "no fallbacks". Nothing is written to the user's
+ * config. Returns the user's own chain for `model`; empty when there is none.
+ */
+export function pinSubagentRetryChains(
+	settings: Settings,
+	role: string,
+	primary: string,
+	model: Pick<Model, "provider" | "id">,
+): string[] {
+	const configured = cfgRetryFallbackChains.get(settings);
+	const key = `${model.provider}/${model.id}`;
+	const own = configured && typeof configured === "object" ? configured[key] : undefined;
+	const chain = Array.isArray(own) && own.every(entry => typeof entry === "string") ? [...own] : [];
+	const pinned: RetryFallbackChains = { [role]: chain };
+	if (configured && typeof configured === "object") {
+		for (const configuredKey in configured) {
+			if (configuredKey !== role) pinned[configuredKey] = configuredKey === key ? chain : [];
+		}
+	}
+	installRetryFallbackRole(settings, role, { primary, chain });
+	cfgRetryFallbackChains.override(settings, pinned);
+	return chain;
+}
