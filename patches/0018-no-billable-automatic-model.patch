+import { afterEach, describe, expect, it, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { resolveModelRoleValue } from "@oh-my-pi/pi-coding-agent/config/model-resolver";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { resetRegisteredArtifactDirsForTests } from "@oh-my-pi/pi-coding-agent/internal-urls/registry-helpers";
+import * as judgmentModule from "@oh-my-pi/pi-coding-agent/judgment";
+import { autoTaskModelFailed, classifyAutoTaskModel } from "@oh-my-pi/pi-coding-agent/task/auto-model";
+import * as discoveryModule from "@oh-my-pi/pi-coding-agent/task/discovery";
+import * as executorModule from "@oh-my-pi/pi-coding-agent/task/executor";
+import {
+	automaticRolePool,
+	billingVerdict,
+	isBillableModel,
+	warmPlanEvidence,
+} from "@oh-my-pi/pi-coding-agent/task/model-economy";
+import * as modelUsageModule from "@oh-my-pi/pi-coding-agent/task/model-usage";
+import {
+	resolveCallerRoleSelector,
+	resolveCallerTierSelector,
+	runStructuredSubagent,
+	StructuredSubagentError,
+	type StructuredSubagentRequest,
+} from "@oh-my-pi/pi-coding-agent/task/structured-subagent";
+import type { AgentDefinition } from "@oh-my-pi/pi-coding-agent/task/types";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import type { SingleResult } from "@oh-my-pi/pi-tui/tools/task";
+import { billingRegistry } from "../helpers/billing-registry";
+
+/**
+ * Automatic model selection never picks a model that bills real money. "Automatic" is any model omp chose
+ * and the user or caller did not name for this call: the classifier's aliases,
+ * price tiers, the judge, helper roles and their defaults. A model named for the call is always allowed.
+ *
+ * The failure list these tests are written against:
+ * - a billable alias still reaches the classifier
+ * - a price tier still resolves to a billable model
+ * - the judge resolves to a billable model (its role chain, its session fallback)
+ * - a helper-role default (smol, tiny) resolves to a billable model
+ * - the exclusion is silent: no note naming the alias, or no failure text when nothing is left
+ * - every candidate excluded falls back to a billable model or to the parent
+ * - an explicit selection is blocked by mistake (a per-call alias, an agent model, a configured role)
+ * - OAuth-only logic calls a plan-backed API-key provider billable
+ * - an undecided provider (no usage endpoint, endpoint down, balance only) is treated as free
+ */
+
+/** A mock model of one provider, priced per million tokens. */
+function model(provider: string, id: string, price: number, extra: Record<string, unknown> = {}): Model<Api> {
+	const made = createMockModel({ provider, id, cost: { input: price, output: price, cacheRead: 0, cacheWrite: 0 } });
+	return Object.assign(made, extra) as unknown as Model<Api>;
+}
+
+// An OAuth subscription, a flat-rate plan on an API key, and an OpenRouter-style pay-per-token key.
+const SUB_FAST = model("sub", "sub-fast", 1);
+const SUB_SLOW = model("sub", "sub-slow", 6);
+const PLAN_FLASH = model("plan", "plan-flash", 2);
+const PAYG_PRO = model("payg", "payg-pro", 15);
+const PAYG_MINI = model("payg", "payg-mini", 1);
+const PREPAID = model("prepaid", "prepaid-x", 3);
+const FLAKY = model("flaky", "flaky-x", 4);
+const ALL = [SUB_FAST, SUB_SLOW, PLAN_FLASH, PAYG_PRO, PAYG_MINI, PREPAID, FLAKY];
+const FIXTURE = {
+	oauth: ["sub"],
+	usage: { plan: "windows", prepaid: "balance", flaky: "down" },
+} as const;
+
+function registry(models: readonly Model<Api>[] = ALL, extra: Record<string, unknown> = {}) {
+	return billingRegistry(models, FIXTURE, extra);
+}
+
+/** The reason of a failed classification; a decision is a test error. */
+function failureOf(outcome: Awaited<ReturnType<typeof classifyAutoTaskModel>>): string {
+	if (!autoTaskModelFailed(outcome)) throw new Error(`expected a failure, got ${outcome.role}`);
+	return outcome.failure;
+}
+
+/** The message of a preflight error; anything else is a test error. */
+function messageOf(error: unknown): string {
+	if (!(error instanceof StructuredSubagentError)) throw new Error(`expected a preflight error, got ${error}`);
+	expect(error.kind).toBe("preflight");
+	return error.message;
+}
+
+afterEach(() => {
+	vi.restoreAllMocks();
+	resetRegisteredArtifactDirsForTests();
+});
+
+describe("what costs real money", () => {
+	it("calls an OAuth login a subscription and never asks its usage endpoint", async () => {
+		const reg = registry();
+		expect(billingVerdict(SUB_FAST, reg)).toEqual({
+			billable: false,
+			basis: "sub is signed in with OAuth, a subscription",
+		});
+		await warmPlanEvidence(reg);
+		expect(reg.asked).not.toContain("sub");
+	});
+
+	it("calls a flat-rate plan on an API key plan-backed once its usage endpoint reports limit windows", async () => {
+		const reg = registry();
+		// Before anything asked, the evidence is missing and the answer fails closed.
+		expect(isBillableModel(PLAN_FLASH, reg)).toBe(true);
+
+		await warmPlanEvidence(reg);
+
+		expect(billingVerdict(PLAN_FLASH, reg)).toEqual({
+			billable: false,
+			basis: "plan reports plan limit windows for this account",
+		});
+		expect(reg.asked.sort()).toEqual(["flaky", "plan", "prepaid"]);
+	});
+
+	it("keeps a pay-per-token API key billable and says there is no plan to find", async () => {
+		const reg = registry();
+		await warmPlanEvidence(reg);
+		expect(billingVerdict(PAYG_PRO, reg)).toEqual({
+			billable: true,
+			basis: "no OAuth login, no free price, and payg has no usage endpoint that could show a plan",
+		});
+	});
+
+	it.each([
+		["a balance-only usage endpoint", PREPAID, "prepaid reported no plan limit windows"],
+		["a usage endpoint that is down", FLAKY, "flaky has not reported plan limit windows"],
+	] as const)("treats %s as undecided, which is billable", async (_name, subject, reason) => {
+		const reg = registry();
+		await warmPlanEvidence(reg);
+		expect(billingVerdict(subject, reg)).toEqual({
+			billable: true,
+			basis: `no OAuth login, no free price, and ${reason}`,
+		});
+	});
+
+	it("does not charge a model the catalogue declares free or that runs on this machine, and not a zero price that is merely unknown", () => {
+		const reg = registry();
+		const free = model("payg", "payg-free", 0, { pricingStatus: "free" });
+		const included = model("payg", "payg-included", 0, { pricingStatus: "included" });
+		const onDevice = model("local", "tiny", 0, { api: "local-inference" });
+		const unknown = model("payg", "payg-unknown", 0);
+		expect(billingVerdict(free, reg).basis).toBe("the catalogue lists its price as free");
+		expect(isBillableModel(free, reg)).toBe(false);
+		expect(isBillableModel(included, reg)).toBe(false);
+		expect(billingVerdict(onDevice, reg).basis).toBe("it runs on this machine");
+		expect(isBillableModel(unknown, reg)).toBe(true);
+	});
+
+	it("keeps a model billable when the registry cannot answer", () => {
+		const broken = billingRegistry(ALL, FIXTURE, {
+			isUsingOAuth: () => {
+				throw new Error("credential store closed");
+			},
+		});
+		expect(isBillableModel(SUB_FAST, broken)).toBe(true);
+	});
+});
+
+describe("the classifier's aliases", () => {
+	function stubJudge(choice: string): { shown: () => Record<string, string>; ran: () => number } {
+		let state: Record<string, string> = {};
+		let ran = 0;
+		vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue(modelUsageModule.EMPTY_MODEL_USAGE);
+		vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(true);
+		vi.spyOn(judgmentModule, "resolveJudge").mockReturnValue({
+			withCandidate: async (run: (candidate: unknown, kind: string) => Promise<unknown>) =>
+				run(
+					{
+						judge: async (input: { state: Record<string, string> }) => {
+							ran += 1;
+							state = input.state;
+							const others = Object.keys(JSON.parse(input.state.role_selectors)).filter(role => role !== choice);
+							const rest = others.length === 0 ? 0 : 0.1 / others.length;
+							return {
+								answers: {
+									model: {
+										choice,
+										confidence: 0.9,
+										probabilities: {
+											[choice]: others.length === 0 ? 1 : 0.9,
+											...Object.fromEntries(others.map(role => [role, rest])),
+										},
+									},
+								},
+							};
+						},
+					},
+					"native",
+				),
+		} as never);
+		return { shown: () => state, ran: () => ran };
+	}
+
+	it("never offers a billable alias to the judge, and names it in the decision", async () => {
+		const judge = stubJudge("fast");
+		const decision = await classifyAutoTaskModel({
+			settings: Settings.isolated({
+				modelRoles: { fast: "sub/sub-fast", cheap: "plan/plan-flash", dear: "payg/payg-pro" },
+			}),
+			registry: registry(),
+			task: "Rename a variable across three files.",
+		});
+
+		expect(Object.keys(JSON.parse(judge.shown().role_selectors))).toEqual(["fast", "cheap"]);
+		expect(decision).toMatchObject({ role: "@fast" });
+		expect(decision.role === undefined ? undefined : decision.excluded).toEqual([
+			{
+				name: "@dear",
+				model: "payg/payg-pro",
+				basis: "no OAuth login, no free price, and payg has no usage endpoint that could show a plan",
+			},
+		]);
+	});
+
+	it("chooses the one usable alias without the judge when the others bill real money", async () => {
+		const judge = stubJudge("cheap");
+		const decision = await classifyAutoTaskModel({
+			settings: Settings.isolated({ modelRoles: { cheap: "plan/plan-flash", dear: "payg/payg-pro" } }),
+			registry: registry(),
+			task: "Summarise the log.",
+		});
+
+		expect(judge.ran()).toBe(0);
+		expect(decision).toMatchObject({ role: "@cheap", onlyAlias: true });
+		expect(decision.role === undefined ? undefined : decision.excluded?.map(entry => entry.name)).toEqual(["@dear"]);
+	});
+
+	it("fails with the aliases named, and never falls back to a billable one or the parent, when every alias bills real money", async () => {
+		const judge = stubJudge("sonnet");
+		const outcome = await classifyAutoTaskModel({
+			settings: Settings.isolated({
+				modelRoles: { sonnet: "payg/payg-pro", dear: "prepaid/prepaid-x", flaky: "flaky/flaky-x" },
+			}),
+			registry: registry(),
+			sessionModel: PAYG_PRO,
+			task: "Plan a migration.",
+		});
+
+		expect(outcome).toMatchObject({ billable: true });
+		const failure = failureOf(outcome);
+		expect(failure).toContain("every usable one bills real money");
+		expect(failure).toContain("@sonnet (payg/payg-pro:");
+		expect(failure).toContain(
+			"@dear (prepaid/prepaid-x: no OAuth login, no free price, and prepaid reported no plan limit windows)",
+		);
+		expect(failure).toContain(
+			"@flaky (flaky/flaky-x: no OAuth login, no free price, and flaky has not reported plan limit windows)",
+		);
+		expect(judge.ran()).toBe(0);
+	});
+
+	it("fails with the judge's reason, and offers no fallback role, when the judge cannot choose among the aliases left", async () => {
+		vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue(modelUsageModule.EMPTY_MODEL_USAGE);
+		vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(false);
+		const outcome = await classifyAutoTaskModel({
+			settings: Settings.isolated({
+				modelRoles: { sonnet: "payg/payg-pro", haiku: "sub/sub-fast", opus: "plan/plan-flash" },
+			}),
+			registry: registry(),
+			task: "Plan a migration.",
+		});
+
+		expect(failureOf(outcome)).toStartWith("no native judge is available.");
+		expect(failureOf(outcome)).not.toMatch(/sonnet|conservative|fallback/i);
+	});
+});
+
+/** A task spawn through the real preflight and dispatch, with the judge stubbed and the child process mocked. */
+const WORKER: AgentDefinition = {
+	name: "worker",
+	description: "Test worker",
+	systemPrompt: "Do the assigned work.",
+	source: "bundled",
+};
+
+function harness(settings: Record<string, unknown>, agent: AgentDefinition = WORKER) {
+	vi.spyOn(modelUsageModule, "loadModelUsage").mockReturnValue(modelUsageModule.EMPTY_MODEL_USAGE);
+	vi.spyOn(discoveryModule, "discoverAgents").mockResolvedValue({ agents: [agent], projectAgentsDir: null });
+	const notices: { level: string; message: string; source?: string }[] = [];
+	const dispatched: executorModule.ExecutorOptions[] = [];
+	vi.spyOn(executorModule, "runSubprocess").mockImplementation(async options => {
+		dispatched.push(options);
+		return {
+			index: 0,
+			id: "Worker",
+			agent: "worker",
+			agentSource: "bundled",
+			task: "t",
+			exitCode: 0,
+			output: "ok",
+			stderr: "",
+			truncated: false,
+			durationMs: 1,
+			tokens: 0,
+			requests: 1,
+		} satisfies SingleResult;
+	});
+	const session = {
+		cwd: "/tmp",
+		hasUI: false,
+		settings: Settings.isolated({ "task.maxRecursionDepth": 2, "task.isolation.enabled": false, ...settings }),
+		getSessionFile: () => null,
+		getSessionSpawns: () => "*",
+		getSessionAgents: () => [],
+		getPlanModeState: () => undefined,
+		modelRegistry: registry(ALL, { isBackgroundRefreshPending: () => false }),
+		getActiveModelString: () => "payg/payg-pro",
+		getModelString: () => "payg/payg-pro",
+		emitNotice: (level: string, message: string, source?: string) => notices.push({ level, message, source }),
+	} as unknown as ToolSession;
+	const request = (overrides: Partial<StructuredSubagentRequest> = {}): StructuredSubagentRequest => ({
+		session,
+		invocationKind: "task",
+		assignment: "Inspect the target.",
+		agent: "worker",
+		...overrides,
+	});
+	return { session, notices, dispatched, request };
+}
+
+function noJudge(): void {
+	vi.spyOn(judgmentModule, "hasNativeJudge").mockReturnValue(false);
+	vi.spyOn(judgmentModule, "resolveJudge").mockImplementation(() => {
+		throw new Error("the judge must not run");
+	});
+}
+
+describe("a spawn nobody named a model for", () => {
+	it("starts on the one alias that does not bill real money and tells the user which it left out", async () => {
+		const { dispatched, notices, request } = harness({
+			modelRoles: { cheap: "plan/plan-flash", dear: "payg/payg-pro" },
+		});
+		noJudge();
+
+		const settled = await runStructuredSubagent(request({ retainArtifacts: true }));
+
+		expect(dispatched[0]?.modelOverride).toEqual(["plan/plan-flash"]);
+		const warning = dispatched[0]?.modelWarning ?? "";
+		expect(warning).toBe(
+			"Left out of automatic model selection because it bills real money: @dear (payg/payg-pro: no OAuth login, no free price, and payg has no usage endpoint that could show a plan). Name one explicitly with `model` to use it.",
+		);
+		expect(notices).toEqual([{ level: "warning", message: warning, source: "task-model" }]);
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("fails before a child starts, with a plain message, when every alias bills real money", async () => {
+		const { dispatched, notices, request } = harness({
+			modelRoles: { dear: "payg/payg-pro", mini: "payg/payg-mini" },
+		});
+		noJudge();
+
+		const failure = await runStructuredSubagent(request()).catch(error => error);
+
+		const message = messageOf(failure);
+		expect(message).toContain(
+			"Subagent not started. Automatic model selection failed: no role alias can be chosen automatically",
+		);
+		expect(message).toContain("@dear (payg/payg-pro:");
+		expect(message).toContain("@mini (payg/payg-mini:");
+		expect(message).toContain(
+			"No billable model is chosen automatically. To fix this, the user must name a model for this call, or add a role alias backed by a subscription or plan.",
+		);
+		expect(message).toContain("The parent agent must stop and report this to the user.");
+		expect(message).not.toContain("add at least two role aliases");
+		expect(dispatched).toHaveLength(0);
+		expect(notices).toHaveLength(0);
+	});
+
+	it("uses an agent's own billable model with the failure stated, because the agent definition named it", async () => {
+		const { dispatched, request } = harness(
+			{ modelRoles: { dear: "payg/payg-pro", mini: "payg/payg-mini" } },
+			{ ...WORKER, model: ["payg/payg-mini"] },
+		);
+		noJudge();
+
+		const settled = await runStructuredSubagent(request({ retainArtifacts: true }));
+
+		expect(dispatched[0]?.modelOverride).toEqual(["payg/payg-mini"]);
+		expect(dispatched[0]?.modelWarning).toContain("every usable one bills real money");
+		expect(dispatched[0]?.modelWarning).toContain(
+			'The subagent uses the model of the "worker" agent definition (payg/payg-mini).',
+		);
+		await fs.rm(settled.artifactsDir, { recursive: true, force: true });
+	});
+
+	it("still lets a per-call role alias name a billable model", async () => {
+		const { session } = harness({
+			"task.perCallModel": "on",
+			modelRoles: { dear: "payg/payg-pro", cheap: "plan/plan-flash" },
+		});
+
+		expect(await resolveCallerRoleSelector({ session }, "@dear")).toBe("payg/payg-pro");
+	});
+});
+
+describe("price tiers", () => {
+	it("never resolve to a billable role, and say which they left out", async () => {
+		const { session, notices } = harness({
+			modelRoles: { fast: "sub/sub-fast", deep: "sub/sub-slow", dear: "payg/payg-pro", cheap: "payg/payg-mini" },
+		});
+
+		// $$$$ is the dearest quarter of the catalogue, where only @dear sits. It bills real money.
+		const selector = await resolveCallerTierSelector({ session }, 4);
+
+		expect(selector).toBe("sub/sub-slow");
+		expect(notices).toHaveLength(1);
+		expect(notices[0]?.message).toContain("@dear (payg/payg-pro:");
+		expect(notices[0]?.message).toContain("@cheap (payg/payg-mini:");
+		expect(notices[0]?.source).toBe("task-model");
+	});
+
+	it("fail, naming the aliases, when only billable roles are left", async () => {
+		const { session } = harness({ modelRoles: { dear: "payg/payg-pro", cheap: "payg/payg-mini" } });
+
+		const failure = await resolveCallerTierSelector({ session }, 2).catch(error => error);
+
+		const message = messageOf(failure);
+		expect(message).toContain(
+			"Price tier $$ needs a configured model role with a known price that does not bill real money",
+		);
+		expect(message).toContain("@dear (payg/payg-pro:");
+		expect(message).toContain("Roles that bill real money are never picked for a price tier.");
+	});
+});
+
+describe("the judge and the helper roles", () => {
+	const native = (provider: string, id: string, price: number): Model<Api> =>
+		model(provider, id, price, { api: "typesafe", input: ["text"] });
+	const NATIVE_PAYG = native("payg", "decisions", 1);
+	const NATIVE_SUB = native("sub", "decisions", 1);
+
+	it("leaves a billable native judge out of the judge chain unless the user configured the judge role", () => {
+		const reg = registry([NATIVE_PAYG, SUB_FAST]);
+		const open = Settings.isolated({});
+		expect(automaticRolePool("judge", open, reg).map(entry => entry.provider)).toEqual(["sub"]);
+		expect(judgmentModule.hasNativeJudge(open, reg)).toBe(false);
+
+		const configured = Settings.isolated({ modelRoles: { judge: "payg/decisions" } });
+		expect(automaticRolePool("judge", configured, reg)).toContain(NATIVE_PAYG);
+		expect(judgmentModule.hasNativeJudge(configured, reg)).toBe(true);
+	});
+
+	it("keeps an OAuth native judge and, once its usage endpoint reports windows, a plan-backed one", async () => {
+		const planJudge = native("plan", "decisions", 1);
+		const reg = registry([NATIVE_SUB, planJudge]);
+		const settings = Settings.isolated({});
+		expect(automaticRolePool("judge", settings, reg)).toEqual([NATIVE_SUB]);
+
+		await warmPlanEvidence(reg);
+
+		expect(automaticRolePool("judge", settings, reg)).toEqual([NATIVE_SUB, planJudge]);
+	});
+
+	it("never stands in the session model as the judge when it bills real money", () => {
+		const settings = Settings.isolated({});
+		const billable = judgmentModule
+			.resolveJudge({ settings, registry: registry([PAYG_PRO]), sessionModel: PAYG_PRO, purpose: "test" })
+			.primaryModel();
+		const subscribed = judgmentModule
+			.resolveJudge({ settings, registry: registry([SUB_FAST]), sessionModel: SUB_FAST, purpose: "test" })
+			.primaryModel();
+		expect(billable).toBeUndefined();
+		expect(subscribed).toBe(SUB_FAST);
+	});
+
+	it("resolves a helper role's built-in default to a model that does not bill real money", () => {
+		const haikuViaPayg = model("payg", "claude-haiku-5-5", 1);
+		const haikuViaSub = model("sub", "claude-haiku-5-5", 1);
+		const reg = registry([haikuViaPayg, haikuViaSub]);
+		const settings = Settings.isolated({});
+
+		const pool = automaticRolePool("tiny", settings, reg);
+
+		expect(pool).toEqual([haikuViaSub]);
+		expect(resolveModelRoleValue("@tiny", pool, { settings }).model).toBe(haikuViaSub);
+	});
+
+	it("keeps a billable model the user configured for that helper role", () => {
+		const haikuViaPayg = model("payg", "claude-haiku-5-5", 1);
+		const reg = registry([haikuViaPayg, SUB_FAST]);
+		const settings = Settings.isolated({ modelRoles: { smol: "payg/claude-haiku-5-5" } });
+
+		expect(automaticRolePool("smol", settings, reg)).toContain(haikuViaPayg);
+		// Another role did not name it, so the same model stays out of that role's pool.
+		expect(automaticRolePool("tiny", settings, reg)).not.toContain(haikuViaPayg);
+	});
+});
diff --git a/packages/coding-agent/test/task/no-billable-helpers.test.ts b/packages/coding-agent/test/task/no-billable-helpers.test.ts
new file mode 100644
index 0000000000..4e8df60ead
--- /dev/null
+++ b/packages/coding-agent/test/task/no-billable-helpers.test.ts
@@ -0,0 +1,228 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import * as ai from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { runEvalCompletion } from "@oh-my-pi/pi-coding-agent/eval/completion-bridge";
+import { createSkillDescriptionCompressor } from "@oh-my-pi/pi-coding-agent/extensibility/skill-descriptions";
+import { SessionMaintenance, type SessionMaintenanceHost } from "@oh-my-pi/pi-coding-agent/session/session-maintenance";
+import {
+	automaticModels,
+	automaticRolePool,
+	emitBillingNoticeOnce,
+	noteBillableOnly,
+	registerBillingNoticeSink,
+} from "@oh-my-pi/pi-coding-agent/task/model-economy";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import { resolveSpeechCandidates } from "@oh-my-pi/pi-coding-agent/tools/tts";
+import { generateCommitMessage } from "@oh-my-pi/pi-coding-agent/utils/commit-message-generator";
+import { generateSessionTitle } from "@oh-my-pi/pi-coding-agent/utils/title-generator";
+import { billingRegistry } from "../helpers/billing-registry";
+
+/**
+ * The gaps after the first pass: the image, speech, dictation and web roles, compaction and the eval tiers
+ * skip models that bill real money unless you configured the role; and a helper left without a model
+ * because of that says so once per session.
+ *
+ * The failure list these tests are written against:
+ * - an unconfigured image, speech, dictation or web role resolves to a billable default
+ * - the compaction summary model, or an eval completion tier, is a billable model omp picked
+ * - a helper does nothing and says nothing (silent), or says it on every call
+ * - a role or tier you configured is blocked by mistake
+ */
+
+function model(provider: string, id: string, extra: Record<string, unknown> = {}): Model<Api> {
+	const made = createMockModel({ provider, id, cost: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0 } });
+	return Object.assign(made, extra) as unknown as Model<Api>;
+}
+
+const PAYG_HAIKU = model("payg", "claude-haiku-5-5");
+const SUB_HAIKU = model("sub", "claude-haiku-5-5");
+const FIXTURE = { oauth: ["sub"] } as const;
+
+afterEach(() => {
+	vi.restoreAllMocks();
+});
+
+describe("image, speech, dictation and web roles", () => {
+	const kinds = [
+		["image", "image"],
+		["speech", "tts"],
+		["dictation", "stt"],
+		["web", "search"],
+	] as const;
+
+	it.each(kinds)("never choose a billable %s model by themselves", (role, kind) => {
+		const billable = model("payg", `${role}-model`, { kind });
+		const subscribed = model("sub", `${role}-model`, { kind });
+		const reg = billingRegistry([billable, subscribed], FIXTURE);
+
+		expect(automaticRolePool(role, Settings.isolated({}), reg)).toEqual([subscribed]);
+	});
+
+	it.each(kinds)("keep a billable %s model you configured for the role", (role, kind) => {
+		const billable = model("payg", `${role}-model`, { kind });
+		const reg = billingRegistry([billable], FIXTURE);
+		const settings = Settings.isolated({ modelRoles: { [role]: `payg/${role}-model` } });
+
+		expect(automaticRolePool(role, settings, reg)).toEqual([billable]);
+	});
+
+	it("leave the speech tool without a model, rather than a billable one, when nothing else exists", () => {
+		// `xai/grok-tts` is in the speech role's built-in defaults; here xai is a pay-per-token key.
+		const billable = model("xai", "grok-tts", { kind: "tts", api: "xai-tts" });
+		const reg = billingRegistry([billable], FIXTURE);
+
+		expect(resolveSpeechCandidates(Settings.isolated({}), reg, false)).toEqual([]);
+		expect(
+			resolveSpeechCandidates(Settings.isolated({ modelRoles: { speech: "xai/grok-tts" } }), reg, false).map(
+				candidate => candidate.model,
+			),
+		).toEqual([billable]);
+	});
+});
+
+describe("eval completion tiers", () => {
+	function session(models: Model<Api>[], settings: Record<string, unknown>): ToolSession {
+		return {
+			settings: Settings.isolated(settings),
+			modelRegistry: billingRegistry(models, FIXTURE),
+			getActiveModelString: () => undefined,
+			getModelString: () => undefined,
+		} as unknown as ToolSession;
+	}
+
+	it("does not run the smol tier on a billable model it would pick by default, and says why", async () => {
+		const failure = await runEvalCompletion(
+			{ prompt: "hi", model: "smol" },
+			{ session: session([PAYG_HAIKU], {}) },
+		).catch(error => error);
+
+		expect(failure).toBeInstanceOf(Error);
+		expect(failure.message).toContain('could not resolve a model for the "smol" tier.');
+		expect(failure.message).toContain("The smol tier has no model: payg/claude-haiku-5-5 bills real money");
+		expect(failure.message).toContain("Configure modelRoles.smol");
+	});
+
+	it("runs a smol tier you configured, even when it bills real money", async () => {
+		const handle = await runEvalCompletion(
+			{ prompt: "hi", model: "smol" },
+			{ session: session([PAYG_HAIKU], { modelRoles: { smol: "payg/claude-haiku-5-5" } }) },
+		);
+		expect(handle).toBeDefined();
+	});
+
+	it("runs the smol tier on a model that does not bill real money", async () => {
+		const handle = await runEvalCompletion(
+			{ prompt: "hi", model: "smol" },
+			{ session: session([PAYG_HAIKU, SUB_HAIKU], {}) },
+		);
+		expect(handle).toBeDefined();
+	});
+});
+
+describe("compaction candidates", () => {
+	function maintenance(models: Model<Api>[], settings: Record<string, unknown>) {
+		const notices: { level: string; message: string; source?: string }[] = [];
+		const registry = billingRegistry(models, FIXTURE, { fitContextWindow: (candidate: Model<Api>) => candidate });
+		const host = {
+			settings: Settings.isolated(settings),
+			modelRegistry: registry,
+			emitNotice: (level: string, message: string, source?: string) => notices.push({ level, message, source }),
+		} as unknown as SessionMaintenanceHost;
+		return { maintenance: new SessionMaintenance(host), notices };
+	}
+
+	it("leaves the largest billable model out of the fallback chain and says so once", () => {
+		const big = model("payg", "huge", { contextWindow: 2_000_000 });
+		const sub = model("sub", "mid", { contextWindow: 500_000 });
+		const active = model("sub", "active", { contextWindow: 100_000 });
+		const { maintenance: m, notices } = maintenance([big, sub, active], {});
+
+		const first = m.resolveCompactionModelCandidates(active, [big, sub, active]);
+		m.resolveCompactionModelCandidates(active, [big, sub, active]);
+
+		expect(first.map(candidate => candidate.id)).toEqual(["active", "mid"]);
+		expect(notices).toHaveLength(1);
+		expect(notices[0]?.level).toBe("warning");
+		expect(notices[0]?.message).toContain(
+			"Compaction does not use models that bill real money unless you chose them: payg/huge.",
+		);
+	});
+
+	it("keeps the session's own model even when it bills real money", () => {
+		const active = model("payg", "active", { contextWindow: 100_000 });
+		const { maintenance: m, notices } = maintenance([active], {});
+
+		expect(m.resolveCompactionModelCandidates(active, [active]).map(candidate => candidate.id)).toEqual(["active"]);
+		expect(notices).toHaveLength(0);
+	});
+});
+
+describe("a helper with no model says so once per session", () => {
+	function noticeSink(reg: object): string[] {
+		const notices: string[] = [];
+		registerBillingNoticeSink(reg, message => notices.push(message));
+		return notices;
+	}
+
+	it("tells the title generator's user once, not on every title", async () => {
+		const reg = billingRegistry([PAYG_HAIKU], FIXTURE, {
+			getApiKey: async () => "key",
+			getApiKeyForProvider: async () => "key",
+			resolver: () => async () => "key",
+		});
+		const notices = noticeSink(reg);
+		const complete = vi.spyOn(ai, "completeSimple");
+
+		expect(await generateSessionTitle("Fix the build", reg, Settings.isolated({}))).toBeNull();
+		expect(await generateSessionTitle("Fix the tests", reg, Settings.isolated({}))).toBeNull();
+
+		expect(complete).not.toHaveBeenCalled();
+		expect(notices).toEqual([
+			"Title generation has no model: payg/claude-haiku-5-5 bills real money, and omp never chooses such a model by itself. Set modelRoles.tiny (for example with /model) to use one.",
+		]);
+	});
+
+	it("tells the commit-message generator's user, and skill-description compression's, once each", async () => {
+		const reg = billingRegistry([PAYG_HAIKU], FIXTURE, { getApiKey: async () => "key" });
+		const notices = noticeSink(reg);
+		const settings = Settings.isolated({});
+
+		expect(await generateCommitMessage("diff --git a/x b/x\n+1", reg, settings)).toBeNull();
+		expect(await generateCommitMessage("diff --git a/x b/x\n+2", reg, settings)).toBeNull();
+		const compressor = createSkillDescriptionCompressor(reg, settings);
+		expect(compressor.modelKey()).toBeUndefined();
+		expect(compressor.modelKey()).toBeUndefined();
+
+		expect(notices).toHaveLength(2);
+		expect(notices[0]).toStartWith("Commit message generation has no model: payg/claude-haiku-5-5 bills real money");
+		expect(notices[1]).toStartWith(
+			"Skill description compression has no model: payg/claude-haiku-5-5 bills real money",
+		);
+	});
+
+	it("stays quiet when the helper has a model, or its role is configured", async () => {
+		const reg = billingRegistry([PAYG_HAIKU, SUB_HAIKU], FIXTURE);
+		const notices = noticeSink(reg);
+		expect(automaticModels(["smol"], Settings.isolated({}), reg)).toEqual([SUB_HAIKU]);
+		expect(
+			noteBillableOnly(
+				"Title generation",
+				["tiny"],
+				Settings.isolated({ modelRoles: { tiny: "payg/claude-haiku-5-5" } }),
+				reg,
+			),
+		).toBeUndefined();
+		expect(notices).toEqual([]);
+	});
+
+	it("shows one message once per registry and key", () => {
+		const reg = billingRegistry([], FIXTURE);
+		const shown: string[] = [];
+		expect(emitBillingNoticeOnce(reg, "a", "first", m => shown.push(m))).toBe(true);
+		expect(emitBillingNoticeOnce(reg, "a", "again", m => shown.push(m))).toBe(false);
+		expect(emitBillingNoticeOnce(reg, "b", "other", m => shown.push(m))).toBe(true);
+		expect(shown).toEqual(["first", "other"]);
+	});
+});
