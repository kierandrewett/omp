diff --git a/packages/coding-agent/test/no-billable-startup.test.ts b/packages/coding-agent/test/no-billable-startup.test.ts
new file mode 100644
index 0000000000..2c399f8cfc
--- /dev/null
+++ b/packages/coding-agent/test/no-billable-startup.test.ts
@@ -0,0 +1,131 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { getBundledModel, getBundledModels } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentStorage } from "@oh-my-pi/pi-coding-agent/session/agent-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import type { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { createAgentSession } from "@oh-my-pi/pi-coding-agent/sdk";
+import { removeSyncWithRetries, Snowflake } from "@oh-my-pi/pi-utils";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+/**
+ * The main session never starts on a model omp picked by itself when that model bills real money.
+ * A default you configured, or a model you passed, is always yours.
+ *
+ * The failure list these tests are written against:
+ * - the startup fallback picks a billable model (no default, a stale default, catalogue first-available)
+ * - nothing says why no model was chosen, or which models were left out
+ * - a configured default or an explicit model is blocked by mistake
+ * - a subscription login is treated as billable, so a subscriber gets no startup model
+ */
+
+const OPENROUTER =
+	getBundledModels("openrouter").find(model => model.id.includes("claude")) ?? getBundledModels("openrouter")[0];
+const dirs: string[] = [];
+
+afterEach(() => {
+	vi.restoreAllMocks();
+	resetSettingsForTest();
+	AgentStorage.close();
+	for (const dir of dirs.splice(0)) removeSyncWithRetries(dir);
+});
+
+async function start(
+	provider: string,
+	settings: Record<string, unknown> = {},
+	options: Record<string, unknown> = {},
+): Promise<{ session: AgentSession; modelFallbackMessage: string | undefined }> {
+	const dir = path.join(os.tmpdir(), `pi-no-billable-startup-${Snowflake.next()}`);
+	fs.mkdirSync(dir, { recursive: true });
+	dirs.push(dir);
+	const authStorage = createInMemoryAuthStorage();
+	authStorage.keys.setRuntime(provider, "test-key");
+	const modelRegistry = new ModelRegistry(authStorage, path.join(dir, "models.yml"));
+	const result = await createAgentSession({
+		cwd: dir,
+		agentDir: dir,
+		authStorage,
+		modelRegistry,
+		settings: Settings.isolated(settings),
+		sessionManager: SessionManager.inMemory(),
+		disableExtensionDiscovery: true,
+		skills: [],
+		contextFiles: [],
+		promptTemplates: [],
+		slashCommands: [],
+		enableMCP: false,
+		enableLsp: false,
+		skipPythonPreflight: true,
+		rules: [],
+		preloadedCustomToolPaths: [],
+		toolNames: ["read"],
+		...options,
+	});
+	return { session: result.session, modelFallbackMessage: result.modelFallbackMessage };
+}
+
+describe("the startup model", () => {
+	it("is not an OpenRouter model when only an OpenRouter key exists and no default is configured, and says why", async () => {
+		const { session, modelFallbackMessage } = await start("openrouter", {});
+		try {
+			expect(session.model).toBeUndefined();
+			expect(modelFallbackMessage).toContain("No default model selected.");
+			expect(modelFallbackMessage).toContain("The session has no model: ");
+			expect(modelFallbackMessage).toContain("openrouter (");
+			expect(modelFallbackMessage).toContain("bill real money, and omp never chooses such a model by itself.");
+			expect(modelFallbackMessage).toContain("Choose one with /model or --model, or set modelRoles.default.");
+		} finally {
+			await session.dispose();
+		}
+	});
+
+	it("does not replace a stale configured default with a billable model, and keeps the stale default in the message", async () => {
+		const { session, modelFallbackMessage } = await start("openrouter", {
+			modelRoles: { default: "openrouter/no-such-vendor/no-such-model" },
+		});
+		try {
+			expect(session.model).toBeUndefined();
+			expect(modelFallbackMessage).toContain("bill real money");
+		} finally {
+			await session.dispose();
+		}
+	});
+
+	it("still starts on a configured default that bills real money", async () => {
+		const { session, modelFallbackMessage } = await start("openrouter", {
+			modelRoles: { default: `openrouter/${OPENROUTER.id}` },
+		});
+		try {
+			expect(session.model?.provider).toBe("openrouter");
+			expect(session.model?.id).toBe(OPENROUTER.id);
+			expect(modelFallbackMessage).toBeUndefined();
+		} finally {
+			await session.dispose();
+		}
+	});
+
+	it("still starts on an explicit model that bills real money", async () => {
+		const { session } = await start("openrouter", {}, { model: OPENROUTER });
+		try {
+			expect(session.model?.id).toBe(OPENROUTER.id);
+		} finally {
+			await session.dispose();
+		}
+	});
+
+	it("still picks a provider default for a subscription login", async () => {
+		vi.spyOn(ModelRegistry.prototype, "isUsingOAuth").mockReturnValue(true);
+		const providerDefault = getBundledModel("anthropic", "claude-sonnet-4-5");
+		const { session } = await start("anthropic", { enabledModels: ["anthropic/*"] });
+		try {
+			expect(session.model?.provider).toBe("anthropic");
+			expect(providerDefault).toBeDefined();
+		} finally {
+			await session.dispose();
+		}
+	});
+});
