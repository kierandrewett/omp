+} from "@oh-my-pi/pi-coding-agent/task/model-economy";
+import * as modelUsageModule from "@oh-my-pi/pi-coding-agent/task/model-usage";
+import {
+	resolveCallerRoleSelector,
+	resolveCallerTierSelector,
+	runStructuredSubagent,
+	StructuredSubagentError,
+	type StructuredSubagentRequest,
+} from "@oh-my-pi/pi-coding-agent/task/structured-subagent";
+import type { AgentDefinition } from "@oh-my-pi/pi-coding-agent/task/types";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import type { SingleResult } from "@oh-my-pi/pi-tui/tools/task";
+import { billingRegistry } from "../helpers/billing-registry";
+
+/**
+ * Automatic model selection never picks a model that bills real money. "Automatic" is any model omp chose
+ * and the user or caller did not name for this call: the classifier's aliases,
+ * price tiers, the judge, helper roles and their defaults. A model named for the call is always allowed.
+ *
+ * The failure list these tests are written against:
+ * - a billable alias still reaches the classifier
+ * - a price tier still resolves to a billable model
+ * - the judge resolves to a billable model (its role chain, its session fallback)
+ * - a helper-role default (smol, tiny) resolves to a billable model
+ * - the exclusion is silent: no note naming the alias, or no failure text when nothing is left
+ * - every candidate excluded falls back to a billable model or to the parent
+ * - an explicit selection is blocked by mistake (a per-call alias, an agent model, a configured role)
+ * - OAuth-only logic calls a plan-backed API-key provider billable
+ * - an undecided provider (no usage endpoint, endpoint down, balance only) is treated as free
+ */
+
+/** A mock model of one provider, priced per million tokens. */
+function model(provider: string, id: string, price: number, extra: Record<string, unknown> = {}): Model<Api> {
+	const made = createMockModel({ provider, id, cost: { input: price, output: price, cacheRead: 0, cacheWrite: 0 } });
+	return Object.assign(made, extra) as unknown as Model<Api>;
+}
+
+// An OAuth subscription, a flat-rate plan on an API key, and an OpenRouter-style pay-per-token key.
+const SUB_FAST = model("sub", "sub-fast", 1);
+const SUB_SLOW = model("sub", "sub-slow", 6);
+const PLAN_FLASH = model("plan", "plan-flash", 2);
+const PAYG_PRO = model("payg", "payg-pro", 15);
+const PAYG_MINI = model("payg", "payg-mini", 1);
+const PREPAID = model("prepaid", "prepaid-x", 3);
+const FLAKY = model("flaky", "flaky-x", 4);
+const ALL = [SUB_FAST, SUB_SLOW, PLAN_FLASH, PAYG_PRO, PAYG_MINI, PREPAID, FLAKY];
+const FIXTURE = {
+	oauth: ["sub"],
+	usage: { plan: "windows", prepaid: "balance", flaky: "down" },
+} as const;
+
+function registry(models: readonly Model<Api>[] = ALL, extra: Record<string, unknown> = {}) {
+	return billingRegistry(models, FIXTURE, extra);
+}
+
+/** The reason of a failed classification; a decision is a test error. */
+function failureOf(outcome: Awaited<ReturnType<typeof classifyAutoTaskModel>>): string {
+	if (!autoTaskModelFailed(outcome)) throw new Error(`expected a failure, got ${outcome.role}`);
+	return outcome.failure;
+}
+
+/** The message of a preflight error; anything else is a test error. */
+function messageOf(error: unknown): string {
+	if (!(error instanceof StructuredSubagentError)) throw new Error(`expected a preflight error, got ${error}`);
+	expect(error.kind).toBe("preflight");
+	return error.message;
+}
