new file mode 100644
index 0000000000..a34d686d11
--- /dev/null
+++ b/packages/coding-agent/test/helpers/billing-registry.ts
@@ -0,0 +1,64 @@
+import type { Api, Model } from "@oh-my-pi/pi-ai";
+import type { UsageReport } from "@oh-my-pi/pi-ai/usage";
+import type { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+
+/** What a provider's usage endpoint answers for the account: plan windows, a balance only, or nothing (down). */
+export type FixtureUsage = "windows" | "balance" | "down";
+
+export interface BillingFixture {
+	/** Providers signed in with OAuth: a subscription. */
+	oauth?: readonly string[];
+	/** Providers that have a usage endpoint, and what it reports. A provider not listed has no usage endpoint. */
+	usage?: Readonly<Record<string, FixtureUsage>>;
+}
+
+function report(provider: string, usage: FixtureUsage): UsageReport | null {
+	if (usage === "down") return null;
+	const window = usage === "windows" ? { id: "5h", label: "5 Hour", durationMs: 5 * 3_600_000 } : undefined;
+	return {
+		provider,
+		fetchedAt: 0,
+		limits: [
+			{
+				id: usage === "windows" ? "rolling-5h" : "balance",
+				label: usage === "windows" ? "5 Hour limit" : "Credit balance",
+				scope: { provider },
+				...(window ? { window } : {}),
+				amount: { used: 1, unit: usage === "windows" ? "percent" : "usd" },
+			},
+		],
+	} as UsageReport;
+}
+
+/**
+ * A registry that answers the billing questions of an automatic choice the way the real one does: OAuth
+ * logins from `oauth`, and plan evidence from `usage` through the same `authStorage.usage` calls. `asked`
+ * lists the providers whose usage endpoint was asked, in order.
+ */
+export function billingRegistry(
+	models: readonly Model<Api>[],
+	fixture: BillingFixture = {},
+	extra: Record<string, unknown> = {},
+): ModelRegistry & { asked: string[] } {
+	const asked: string[] = [];
+	const registry = {
+		getAll: () => [...models],
+		getAvailable: () => [...models],
+		isUsingOAuth: (model: Pick<Model<Api>, "provider">) => fixture.oauth?.includes(model.provider) ?? false,
+		authStorage: {
+			usage: {
+				providerFor: (provider: string) => (fixture.usage?.[provider] ? { id: provider } : undefined),
+				reports: async (options: { provider?: string } = {}) => {
+					const provider = options.provider ?? "";
+					asked.push(provider);
+					const usage = fixture.usage?.[provider];
+					const answered = usage ? report(provider, usage) : null;
+					return answered ? [answered] : usage === "down" ? null : [];
+				},
+			},
+		},
+		asked,
+		...extra,
+	};
+	return registry as unknown as ModelRegistry & { asked: string[] };
+}
