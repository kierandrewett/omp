+				id: usage === "windows" ? "rolling-5h" : "balance",
+				label: usage === "windows" ? "5 Hour limit" : "Credit balance",
+				scope: { provider },
+				...(window ? { window } : {}),
+				amount: { used: 1, unit: usage === "windows" ? "percent" : "usd" },
+			},
+		],
+	} as UsageReport;
+}
+
+/**
+ * A registry that answers the billing questions of an automatic choice the way the real one does: OAuth
+ * logins from `oauth`, and plan evidence from `usage` through the same `authStorage.usage` calls. `asked`
+ * lists the providers whose usage endpoint was asked, in order.
+ */
+export function billingRegistry(
+	models: readonly Model<Api>[],
+	fixture: BillingFixture = {},
+	extra: Record<string, unknown> = {},
+): ModelRegistry & { asked: string[] } {
+	const asked: string[] = [];
+	const registry = {
+		getAll: () => [...models],
+		getAvailable: () => [...models],
+		isUsingOAuth: (model: Pick<Model<Api>, "provider">) => fixture.oauth?.includes(model.provider) ?? false,
+		authStorage: {
+			usage: {
+				providerFor: (provider: string) => (fixture.usage?.[provider] ? { id: provider } : undefined),
+				reports: async (options: { provider?: string } = {}) => {
+					const provider = options.provider ?? "";
+					asked.push(provider);
+					const usage = fixture.usage?.[provider];
+					const answered = usage ? report(provider, usage) : null;
+					return answered ? [answered] : usage === "down" ? null : [];
+				},
+			},
+		},
+		asked,
+		...extra,
+	};
+	return registry as unknown as ModelRegistry & { asked: string[] };
+}
