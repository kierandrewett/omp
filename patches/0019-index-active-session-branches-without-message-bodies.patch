+/**
+ * Index the active branch without retaining message bodies. The result uses the
+ * same replay and parent-walk rules as SessionManager.getBranch().
+ */
+export async function indexSessionBranchFromFile(
+	filePath: string,
+	storage: SessionStorage = new FileSessionStorage(),
+): Promise<string[]> {
+	const entries: Pick<SessionEntry, "id" | "parentId" | "activeLeafId">[] = [];
+	const byId = new Map<string, Pick<SessionEntry, "id" | "parentId" | "activeLeafId">>();
+	await visitEntriesFromFile(filePath, entry => {
+		if (entry.type === "session") return;
+		const item = { id: entry.id, parentId: entry.parentId, activeLeafId: entry.activeLeafId };
+		entries.push(item);
+		byId.set(item.id, item);
+	});
+	const branch: string[] = [];
+	const seen = new Set<string>();
+	const leafId = resolveSessionLeafId(entries);
+	let cursor = leafId ? byId.get(leafId) : undefined;
+	while (cursor && !seen.has(cursor.id)) {
+		seen.add(cursor.id);
+		branch.push(cursor.id);
+		cursor = cursor.parentId ? byId.get(cursor.parentId) : undefined;
+	}
+	branch.reverse();
+	return branch;
+}
+
 function hasImageUrl(value: unknown): value is { image_url: string } {
