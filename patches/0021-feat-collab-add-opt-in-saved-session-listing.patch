+	/**
+	 * History access is opt-in and requires a control link. Existing view links
+	 * must never acquire access to sessions outside their room.
+	 */
+	async #handleListSavedSessions(reqId: number, offset: number, fromPeer: number): Promise<void> {
+		const peer = this.#peers.get(fromPeer);
+		if (!Number.isSafeInteger(reqId) || reqId < 0) return;
+		if (process.env.OMP_COLLAB_SAVED_SESSIONS !== "1" || !peer?.canWrite) {
+			this.#send({ t: "saved-sessions", reqId, sessions: [], error: "unavailable" }, fromPeer);
+			return;
+		}
+		if (!Number.isSafeInteger(offset) || offset < 0) {
+			this.#send({ t: "saved-sessions", reqId, sessions: [], error: "invalid_request" }, fromPeer);
+			return;
+		}
+		try {
+			const all = await SessionManager.listAll();
+			if (!this.#guestTrafficAllowed() || this.#peers.get(fromPeer) !== peer) return;
+			const page = all.slice(offset, offset + 16);
+			const sessions = page.map(session => ({
+				id: session.id,
+				cwd: session.cwd,
+				...(session.title ? { title: session.title } : {}),
+				created: session.created.getTime(),
+				modified: session.modified.getTime(),
+			}));
+			if (Buffer.byteLength(JSON.stringify(sessions), "utf8") > 512 * 1024) {
+				this.#send({ t: "saved-sessions", reqId, sessions: [], error: "unavailable" }, fromPeer);
+				return;
+			}
+			this.#send({
+				t: "saved-sessions",
+				reqId,
+				sessions,
+				...(offset + page.length < all.length ? { nextOffset: offset + page.length } : {}),
+			}, fromPeer);
+		} catch {
+			if (this.#peers.get(fromPeer) === peer) {
+				this.#send({ t: "saved-sessions", reqId, sessions: [], error: "unavailable" }, fromPeer);
+			}
+		}
+	}
+
