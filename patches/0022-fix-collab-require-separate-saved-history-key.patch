+	/** Read the operator-provided key without following symlinks or accepting shared files. */
+	async #verifyHistoryKey(value: string): Promise<boolean> {
+		const path = process.env.OMP_COLLAB_HISTORY_KEY_FILE;
+		if (!path || !isAbsolute(path) || typeof process.getuid !== "function") return false;
+		if (typeof value !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(value)) return false;
+		const supplied = Buffer.from(value, "base64url");
+		if (supplied.length !== 32 || supplied.toString("base64url") !== value) return false;
+		let file: fs.FileHandle | undefined;
+		try {
+			file = await fs.open(path, fsConstants.O_RDONLY | fsConstants.O_NOFOLLOW);
+			const stat = await file.stat();
+			if (!stat.isFile() || stat.uid !== process.getuid() || (stat.mode & 0o077) !== 0 || stat.size !== 32) return false;
+			const expected = Buffer.alloc(33);
+			const { bytesRead } = await file.read(expected, 0, expected.length, 0);
+			return bytesRead === 32 && timingSafeEqual(expected.subarray(0, 32), supplied);
+		} catch {
+			return false;
+		} finally {
+			await file?.close().catch(() => {});
+		}
+	}
