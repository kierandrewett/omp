index 0000000000..98b250097e
--- /dev/null
+++ b/packages/coding-agent/src/collab/saved-history.ts
@@ -0,0 +1,290 @@
+import { createHash } from "node:crypto";
+import { closeSync, mkdtempSync, openSync, readSync, rmdirSync, statSync, unlinkSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { SavedHistoryErrorCode } from "@oh-my-pi/pi-wire";
+import { indexSessionBranchFromFile, visitEntriesFromFile } from "../session/session-loader";
+import { FileSessionStorage, type SessionStorage } from "../session/session-storage";
+
+/** Raw bytes per `saved-history` reply; base64url adds about a third on the wire. */
+export const SAVED_HISTORY_PAGE_BYTES = 256 * 1024;
+
+/**
+ * Snapshots kept for recently read sessions. Each holds one session's active branch in an
+ * unlinked private file, so a page read is a positioned read, not a pass over the session file.
+ * The file vanishes when its descriptor closes, including at process exit.
+ */
+const SNAPSHOT_CACHE_LIMIT = 4;
+/** A branch larger than this is refused rather than copied to disk. */
+const MAX_SNAPSHOT_BYTES = 1024 * 1024 * 1024;
+/** Total bytes kept across idle snapshots; the least recently used go first. */
+const MAX_CACHED_BYTES = 1024 * 1024 * 1024;
+/** A session that keeps changing while its snapshot is built is reported as changed after this many tries. */
+const BUILD_ATTEMPTS = 3;
+
+const storage: SessionStorage = new FileSessionStorage();
+
+/** A failure whose code is safe to send to guests. Messages never carry paths. */
+export class SavedHistoryError extends Error {
+	readonly code: SavedHistoryErrorCode;
+
+	constructor(code: SavedHistoryErrorCode) {
+		super(code);
+		this.name = "SavedHistoryError";
+		this.code = code;
+	}
+}
+
+export interface SavedHistoryPage {
+	revision: string;
+	offset: number;
+	/** Exactly `min(SAVED_HISTORY_PAGE_BYTES, total - offset)` bytes of NDJSON, split at byte boundaries. */
+	bytes: Buffer;
+	/** Offset of the next page; absent when this page reaches the end of the branch. */
+	nextOffset?: number;
+}
+
+/** One entry's serialized line inside the snapshot file, placed in branch order by `start`. */
+interface Segment {
+	/** Position of the line in the private file. */
+	fileStart: number;
+	length: number;
+	/** Offset of the line in the branch stream sent to guests. */
+	start: number;
+}
+
+interface Snapshot {
+	/** Identity of the session file when the snapshot was taken. Pages never mix revisions. */
+	revision: string;
+	total: number;
+	/** Active-branch entries in branch order; `start` values are contiguous. */
+	segments: Segment[];
+	fd: number;
+	/** Size of the private file, counted against the cache limit. */
+	bytes: number;
+	refs: number;
+	retired: boolean;
+	closed: boolean;
+}
+
+const snapshots = new Map<string, Snapshot>();
+const building = new Map<string, Promise<Snapshot>>();
+
+/** Revision of a session file: inode, size and nanosecond modify and change times. A rewrite or append changes it. */
+function currentRevision(filePath: string): string {
+	const stat = statSync(filePath, { bigint: true });
+	return createHash("sha256").update(`${stat.ino}:${stat.size}:${stat.mtimeNs}:${stat.ctimeNs}`).digest("hex");
+}
+
+/**
+ * Read one page of the active branch of a session file as newline-delimited JSON.
+ * The bytes are the canonical branch order with the session header omitted.
+ *
+ * The first request (no `expectedRevision`) snapshots the branch as the file is now. Later pages
+ * carry that revision and are served from the same snapshot even while the session keeps
+ * growing, so a running session can be read to the end. A request whose snapshot is gone fails
+ * with `changed`, and the guest starts again from offset 0.
+ */
+export async function readSavedHistoryPage(
+	filePath: string,
+	offset: number,
+	expectedRevision: string | undefined,
+): Promise<SavedHistoryPage> {
+	if (!Number.isSafeInteger(offset) || offset < 0) throw new SavedHistoryError("invalid_request");
+	const snapshot = expectedRevision === undefined ? await acquireCurrent(filePath) : acquireHeld(filePath, expectedRevision);
+	try {
+		if (offset > snapshot.total) throw new SavedHistoryError("invalid_request");
+		const end = Math.min(snapshot.total, offset + SAVED_HISTORY_PAGE_BYTES);
+		const bytes = end === offset ? Buffer.alloc(0) : readWindow(snapshot, offset, end);
+		return { revision: snapshot.revision, offset, bytes, ...(end < snapshot.total ? { nextOffset: end } : {}) };
+	} finally {
+		release(snapshot);
+	}
+}
+
+/** A cached snapshot with exactly this revision, held for one read. */
+function acquireHeld(filePath: string, revision: string): Snapshot {
+	const snapshot = snapshots.get(filePath);
+	if (!snapshot || snapshot.revision !== revision || snapshot.closed || snapshot.retired) {
+		throw new SavedHistoryError("changed");
+	}
+	return hold(filePath, snapshot);
+}
+
+function hold(filePath: string, snapshot: Snapshot): Snapshot {
+	snapshot.refs++;
+	snapshots.delete(filePath);
+	snapshots.set(filePath, snapshot);
+	prune();
+	return snapshot;
+}
+
+/** Hold a snapshot of the file as it is now, building it once for concurrent readers. */
+async function acquireCurrent(filePath: string): Promise<Snapshot> {
+	for (let attempt = 1; ; attempt++) {
+		const revision = currentRevision(filePath);
+		const existing = snapshots.get(filePath);
+		if (existing && existing.revision === revision && !existing.closed && !existing.retired) {
+			return hold(filePath, existing);
+		}
+		const key = `${filePath}\0${revision}`;
+		let pending = building.get(key);
+		if (!pending) {
+			pending = buildSnapshot(filePath, revision)
+				.then(built => {
+					const previous = snapshots.get(filePath);
+					if (previous) retire(previous);
+					snapshots.set(filePath, built);
+					return built;
+				})
+				.finally(() => building.delete(key));
+			building.set(key, pending);
+		}
+		try {
+			const built = await pending;
+			if (!built.closed && !built.retired) return hold(filePath, built);
+		} catch (error) {
+			// The session grew while the snapshot was built: look again with the new revision.
+			if (!(error instanceof SavedHistoryError) || error.code !== "changed" || attempt >= BUILD_ATTEMPTS) throw error;
+		}
+	}
+}
+
+function release(snapshot: Snapshot): void {
+	snapshot.refs--;
+	if (snapshot.retired && snapshot.refs === 0) close(snapshot);
+	prune();
+}
+
+function close(snapshot: Snapshot): void {
+	if (snapshot.closed) return;
+	snapshot.closed = true;
+	closeSync(snapshot.fd);
+}
+
+function retire(snapshot: Snapshot): void {
+	snapshot.retired = true;
+	if (snapshot.refs === 0) close(snapshot);
+}
+
+function prune(): void {
+	let bytes = 0;
+	for (const snapshot of snapshots.values()) bytes += snapshot.bytes;
+	for (const [key, snapshot] of snapshots) {
+		if (snapshots.size <= SNAPSHOT_CACHE_LIMIT && bytes <= MAX_CACHED_BYTES) break;
+		if (snapshot.refs > 0) continue;
+		snapshots.delete(key);
+		bytes -= snapshot.bytes;
+		retire(snapshot);
+	}
+}
+
+/** An open, immediately unlinked file cannot outlive this process. */
+function openPrivateFile(): number {
+	const dir = mkdtempSync(join(tmpdir(), "omp-history-"));
+	const path = join(dir, "branch");
+	let fd: number | undefined;
+	try {
+		fd = openSync(path, "wx+", 0o600);
+		unlinkSync(path);
+		rmdirSync(dir);
+		return fd;
+	} catch (error) {
+		if (fd !== undefined) closeSync(fd);
+		try {
+			unlinkSync(path);
+		} catch {
+			// No file was created.
+		}
+		try {
+			rmdirSync(dir);
+		} catch {
+			// No directory remains.
+		}
+		throw error;
+	}
+}
+
+function writeAll(fd: number, bytes: Buffer, position: number): void {
+	let done = 0;
+	while (done < bytes.length) {
+		const written = writeSync(fd, bytes, done, bytes.length - done, position + done);
+		if (written === 0) throw new SavedHistoryError("unavailable");
+		done += written;
+	}
+}
+
+/**
+ * One streaming pass over the session file. Each active-branch entry is serialized once into an
+ * unlinked private file, in file order. The branch order comes from the active-branch index.
+ */
+async function buildSnapshot(filePath: string, revision: string): Promise<Snapshot> {
+	const branch = await indexSessionBranchFromFile(filePath, storage);
+	const onBranch = new Set(branch);
+	const fd = openPrivateFile();
+	try {
+		const placed = new Map<string, { fileStart: number; length: number }>();
+		let written = 0;
+		await visitEntriesFromFile(
+			filePath,
+			entry => {
+				if (entry.type === "session" || !onBranch.has(entry.id)) return;
+				// Duplicate ids make the branch ambiguous; refuse rather than guess which entry is canonical.
+				if (placed.has(entry.id)) throw new SavedHistoryError("unavailable");
+				const bytes = Buffer.from(`${JSON.stringify(entry)}\n`, "utf8");
+				if (written + bytes.length > MAX_SNAPSHOT_BYTES) throw new SavedHistoryError("unavailable");
+				writeAll(fd, bytes, written);
+				placed.set(entry.id, { fileStart: written, length: bytes.length });
+				written += bytes.length;
+			},
+			storage,
+		);
+		const segments: Segment[] = [];
+		let total = 0;
+		for (const id of branch) {
+			const item = placed.get(id);
+			if (!item) throw new SavedHistoryError("changed");
+			segments.push({ fileStart: item.fileStart, length: item.length, start: total });
+			total += item.length;
+		}
+		if (currentRevision(filePath) !== revision) throw new SavedHistoryError("changed");
+		return { revision, total, segments, fd, bytes: written, refs: 0, retired: false, closed: false };
+	} catch (error) {
+		closeSync(fd);
+		throw error;
+	}
+}
+
+/** First segment whose end lies after `offset`. */
+function segmentAt(segments: readonly Segment[], offset: number): number {
+	let low = 0;
+	let high = segments.length;
+	while (low < high) {
+		const mid = (low + high) >>> 1;
+		const segment = segments[mid]!;
+		if (segment.start + segment.length <= offset) low = mid + 1;
+		else high = mid;
+	}
+	return low;
+}
+
+/** Copy `[offset, end)` of the branch stream out of the snapshot file. */
+function readWindow(snapshot: Snapshot, offset: number, end: number): Buffer {
+	if (snapshot.closed) throw new SavedHistoryError("changed");
+	const out = Buffer.alloc(end - offset);
+	let filled = 0;
+	for (let index = segmentAt(snapshot.segments, offset); index < snapshot.segments.length && filled < out.length; index++) {
+		const segment = snapshot.segments[index]!;
+		const from = Math.max(offset, segment.start) - segment.start;
+		const to = Math.min(end, segment.start + segment.length) - segment.start;
+		let copied = 0;
+		while (copied < to - from) {
+			const count = readSync(snapshot.fd, out, filled + copied, to - from - copied, segment.fileStart + from + copied);
+			if (count === 0) throw new SavedHistoryError("changed");
+			copied += count;
+		}
+		filled += copied;
+	}
+	if (filled !== out.length) throw new SavedHistoryError("changed");
+	return out;
+}
