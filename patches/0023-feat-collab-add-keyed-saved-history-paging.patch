index 0000000000..5e650c3a87
--- /dev/null
+++ b/packages/coding-agent/src/collab/saved-history.ts
@@ -0,0 +1,161 @@
+import { createHash } from "node:crypto";
+import type { SavedHistoryErrorCode } from "@oh-my-pi/pi-wire";
+import { indexSessionBranchFromFile, visitEntriesFromFile } from "../session/session-loader";
+import { FileSessionStorage, type SessionStorage, type SessionStorageStat } from "../session/session-storage";
+
+/** Raw bytes per `saved-history` reply; base64url adds about a third on the wire. */
+export const SAVED_HISTORY_PAGE_BYTES = 256 * 1024;
+
+/**
+ * Layouts (branch ids with byte lengths) kept for recently read sessions. They hold
+ * ids and integers only, never message bodies, and are keyed by file revision.
+ */
+const LAYOUT_CACHE_LIMIT = 2;
+
+const storage: SessionStorage = new FileSessionStorage();
+
+/** A failure whose code is safe to send to guests. Messages never carry paths. */
+export class SavedHistoryError extends Error {
+	readonly code: SavedHistoryErrorCode;
+
+	constructor(code: SavedHistoryErrorCode) {
+		super(code);
+		this.name = "SavedHistoryError";
+		this.code = code;
+	}
+}
+
+export interface SavedHistoryPage {
+	revision: string;
+	offset: number;
+	/** Exactly `min(SAVED_HISTORY_PAGE_BYTES, total - offset)` bytes of NDJSON, split at byte boundaries. */
+	bytes: Buffer;
+	/** Offset of the next page; absent when this page reaches the end of the branch. */
+	nextOffset?: number;
+}
+
+interface Segment {
+	id: string;
+	start: number;
+	length: number;
+}
+
+interface SavedHistoryLayout {
+	revision: string;
+	total: number;
+	/** Active-branch entries in branch order; segments are contiguous. */
+	segments: Segment[];
+	byId: Map<string, Segment>;
+}
+
+const layoutCache = new Map<string, SavedHistoryLayout>();
+
+/** Revision of a session file as seen by stat: any append or rewrite changes size or mtime. */
+function revisionOf(stat: SessionStorageStat): string {
+	return createHash("sha256").update(`${stat.size}:${stat.mtimeMs}`).digest("hex");
+}
+
+/**
+ * Read one page of the active branch of a session file as newline-delimited JSON.
+ * The bytes are the canonical branch order with the session header omitted. A
+ * supplied `expectedRevision` must match the current file, and the file must not
+ * change while the page is built; otherwise the read fails with `changed`.
+ */
+export async function readSavedHistoryPage(
+	filePath: string,
+	offset: number,
+	expectedRevision: string | undefined,
+): Promise<SavedHistoryPage> {
+	if (!Number.isSafeInteger(offset) || offset < 0) throw new SavedHistoryError("invalid_request");
+	const revision = revisionOf(storage.statSync(filePath));
+	if (expectedRevision !== undefined && expectedRevision !== revision) throw new SavedHistoryError("changed");
+
+	const cached = layoutCache.get(filePath);
+	const layout = cached?.revision === revision ? cached : await rememberLayout(filePath, revision);
+	if (offset > layout.total) throw new SavedHistoryError("invalid_request");
+
+	const end = Math.min(layout.total, offset + SAVED_HISTORY_PAGE_BYTES);
+	const bytes = end === offset ? Buffer.alloc(0) : await readWindow(filePath, layout, offset, end);
+	if (revisionOf(storage.statSync(filePath)) !== revision) throw new SavedHistoryError("changed");
+	return { revision, offset, bytes, ...(end < layout.total ? { nextOffset: end } : {}) };
+}
+
+async function rememberLayout(filePath: string, revision: string): Promise<SavedHistoryLayout> {
+	const layout = await buildLayout(filePath, revision);
+	layoutCache.delete(filePath);
+	layoutCache.set(filePath, layout);
+	while (layoutCache.size > LAYOUT_CACHE_LIMIT) {
+		const oldest = layoutCache.keys().next().value;
+		if (oldest === undefined) break;
+		layoutCache.delete(oldest);
+	}
+	return layout;
+}
+
+/** Pass 1 and 2: the branch order and each entry's serialized byte length. */
+async function buildLayout(filePath: string, revision: string): Promise<SavedHistoryLayout> {
+	const branch = await indexSessionBranchFromFile(filePath, storage);
+	const onBranch = new Set(branch);
+	const lengths = new Map<string, number>();
+	await visitEntriesFromFile(
+		filePath,
+		entry => {
+			if (entry.type === "session" || !onBranch.has(entry.id)) return;
+			// Duplicate ids make the branch ambiguous; refuse rather than guess which entry is canonical.
+			if (lengths.has(entry.id)) throw new SavedHistoryError("unavailable");
+			lengths.set(entry.id, Buffer.byteLength(JSON.stringify(entry), "utf8") + 1);
+		},
+		storage,
+	);
+
+	const segments: Segment[] = [];
+	const byId = new Map<string, Segment>();
+	let total = 0;
+	for (const id of branch) {
+		const length = lengths.get(id);
+		if (length === undefined) throw new SavedHistoryError("changed");
+		const segment = { id, start: total, length };
+		segments.push(segment);
+		byId.set(id, segment);
+		total += length;
+	}
+	if (revisionOf(storage.statSync(filePath)) !== revision) throw new SavedHistoryError("changed");
+	return { revision, total, segments, byId };
+}
+
+/**
+ * Pass 3: serialize only the branch entries that overlap [offset, end) and keep
+ * just the overlapping bytes. The caller holds at most one page of output.
+ */
+async function readWindow(filePath: string, layout: SavedHistoryLayout, offset: number, end: number): Promise<Buffer> {
+	const pieces = new Map<string, Buffer>();
+	await visitEntriesFromFile(
+		filePath,
+		entry => {
+			if (entry.type === "session") return;
+			const segment = layout.byId.get(entry.id);
+			if (!segment) return;
+			const segmentEnd = segment.start + segment.length;
+			if (segmentEnd <= offset || segment.start >= end) return;
+			if (pieces.has(entry.id)) throw new SavedHistoryError("changed");
+			const body = Buffer.from(`${JSON.stringify(entry)}\n`, "utf8");
+			if (body.byteLength !== segment.length) throw new SavedHistoryError("changed");
+			const from = Math.max(offset, segment.start) - segment.start;
+			const to = Math.min(end, segmentEnd) - segment.start;
+			pieces.set(entry.id, Buffer.from(body.subarray(from, to)));
+		},
+		storage,
+	);
+
+	const parts: Buffer[] = [];
+	for (const segment of layout.segments) {
+		if (segment.start >= end) break;
+		if (segment.start + segment.length <= offset) continue;
+		const piece = pieces.get(segment.id);
+		if (!piece) throw new SavedHistoryError("changed");
+		parts.push(piece);
+	}
+	const bytes = Buffer.concat(parts);
+	if (bytes.byteLength !== end - offset) throw new SavedHistoryError("changed");
+	return bytes;
+}
