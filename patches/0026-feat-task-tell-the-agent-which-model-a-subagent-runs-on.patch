@@ -0,0 +1,32 @@
+import { prompt } from "@oh-my-pi/pi-utils";
+import subagentModelTemplate from "../prompts/tools/task-subagent-model.md" with { type: "text" };
+
+/** `customType` of the hidden message that tells the spawning agent which model a subagent runs on. */
+export const SUBAGENT_MODEL_NOTICE_TYPE = "subagent-model";
+
+export interface SubagentModelNoticeInput {
+	agentId: string;
+	/** `provider/id`, with an `@upstream` pin when one applies. */
+	identity: string;
+	thinkingLevel?: string;
+	/** True when the model is a retry fallback and not the one the child started on. */
+	fallback?: boolean;
+	/** True when the child moved to this model after an earlier notice named another. */
+	changed: boolean;
+}
+
+/**
+ * The message that tells the spawning agent which model its subagent resolved to. The name an agent
+ * gives a worker says nothing about the model, so the agent reads it here.
+ */
+export function renderSubagentModelNotice(input: SubagentModelNoticeInput): string {
+	return prompt
+		.render(subagentModelTemplate, {
+			agentId: input.agentId,
+			model: input.identity,
+			thinking: input.thinkingLevel,
+			fallback: input.fallback === true,
+			changed: input.changed,
+		})
+		.trim();
+}
