+ * configure the {@link AUTO_MODEL_ROLE} role that `stubAutoModelChoice()` picks, because a spawn whose automatic
+ * choice fails does not start. A test that uses these settings also stubs the choice and gives its session a model
+ * registry (see test/helpers/auto-model.ts).
  * Pass the test's own settings: a per-call `model` conflicts with an override, so a test that enables
  * `task.perCallModel` gets no pin and names its models itself.
  */
 export function pinnedTaskModels(
 	settings: Record<string, unknown> = {},
 	model = "openai/gpt-4.1-mini",
-): { "task.agentModelOverrides"?: Record<string, string> } {
+): { "task.agentModelOverrides"?: Record<string, string>; modelRoles?: Record<string, string> } {
 	if (settings["task.perCallModel"] !== undefined) return {};
 	return {
 		"task.agentModelOverrides": Object.fromEntries(loadBundledAgents().map(agent => [agent.name, model])),
+		modelRoles: { [AUTO_MODEL_ROLE]: model },
 	};
 }
