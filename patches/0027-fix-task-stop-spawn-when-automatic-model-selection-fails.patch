diff --git a/packages/coding-agent/test/helpers/auto-model.ts b/packages/coding-agent/test/helpers/auto-model.ts
new file mode 100644
index 0000000000..1fea4038ec
--- /dev/null
+++ b/packages/coding-agent/test/helpers/auto-model.ts
@@ -0,0 +1,29 @@
+import { vi } from "bun:test";
+import type { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import * as autoModelModule from "@oh-my-pi/pi-coding-agent/task/auto-model";
+
+/**
+ * A subagent without a caller-named model needs a successful automatic choice, and a failed choice stops the spawn.
+ * A test that is not about that choice stands in for it with {@link stubAutoModelChoice}. The stub picks the first
+ * role in the session's `modelRoles`, so the test configures that role as the model it expects the child to run on.
+ */
+export const AUTO_MODEL_ROLE = "auto";
+
+/**
+ * A registry that is still loading and holds no models. Automatic choice only runs when the session has a registry,
+ * and the stub never reads it. A per-call `model` is checked later, once models load, so a test session that is not
+ * about model lookup passes this one.
+ */
+export const EMPTY_MODEL_REGISTRY = {
+	getAll: () => [],
+	getAvailable: () => [],
+	isBackgroundRefreshPending: () => true,
+} as unknown as ModelRegistry;
+
+/** Make every automatic choice pick the first configured role. `vi.restoreAllMocks()` undoes it. */
+export function stubAutoModelChoice(): void {
+	vi.spyOn(autoModelModule, "classifyAutoTaskModel").mockImplementation(async ({ settings }) => {
+		const [first] = Object.keys(settings.getModelRoles());
+		return first ? { role: `@${first}` } : { failure: "the test configured no role" };
+	});
+}
