+/** Longest account tag shown before the ellipsis. `anthropic2` fits whole; `drewett.kieran` becomes `drewett.ki…`. */
+const TAG_MAX_LENGTH = 10;
+
+type TaggedAccount = Pick<OAuthAccountSummary, "active" | "email" | "accountId" | "projectId">;
+
+function accountIdentifier(account: TaggedAccount, index: number): string {
+	return account.email ?? account.accountId ?? account.projectId ?? `account ${index + 1}`;
+}
+
+function withoutDomain(identifier: string): string {
+	const at = identifier.indexOf("@");
+	return at > 0 ? identifier.slice(0, at) : identifier;
+}
+
+function chop(text: string): string {
+	if (text.length <= TAG_MAX_LENGTH) return text;
+	return `${text.slice(0, TAG_MAX_LENGTH).replace(/[._+-]+$/, "")}\u2026`;
+}
+
+/**
+ * Short identifier for the account at `index`: the part of its email before the `@`, chopped to
+ * `TAG_MAX_LENGTH` characters with an ellipsis. Accounts without an email use their account or project id.
+ * When another stored account would show the same text, the tag grows to the whole local part, then to the
+ * whole identifier, and only then adds the account's stored position (`kieran#2`, the same email in two
+ * organisations).
+ */
+export function accountTag(accounts: readonly TaggedAccount[], index: number): string {
+	const identifiers = accounts.map(accountIdentifier);
+	const forms = [
+		(identifier: string) => chop(withoutDomain(identifier)),
+		withoutDomain,
+		(identifier: string) => identifier,
+	];
+	for (const form of forms) {
+		const own = form(identifiers[index]);
+		if (!identifiers.some((identifier, other) => other !== index && form(identifier) === own)) return own;
 	}
-	return letter;
+	return `${chop(withoutDomain(identifiers[index]))}#${index + 1}`;
 }
 
