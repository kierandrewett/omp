+/** Spawns per parent that have entered {@link runStructuredSubagent} and not yet finished. */
+const spawnsInFlight = new Map<string, number>();
+
+function spawnParentKey(request: StructuredSubagentRequest): string {
+	return `${request.session.getSessionId?.() ?? ""}\0${request.session.getAgentId?.() ?? MAIN_AGENT_ID}`;
+}
+
+/**
+ * Count a spawn from its first synchronous step, so spawns started together all see each other before any
+ * of them has registered a child. Returns the function that ends the count.
+ */
+function enterSpawn(request: StructuredSubagentRequest): () => void {
+	const key = spawnParentKey(request);
+	spawnsInFlight.set(key, (spawnsInFlight.get(key) ?? 0) + 1);
+	return () => {
+		const left = (spawnsInFlight.get(key) ?? 1) - 1;
+		if (left > 0) spawnsInFlight.set(key, left);
+		else spawnsInFlight.delete(key);
+	};
+}
+
+/**
+ * Subagents that run at the same time as this spawn, this one included: the largest of the call's own batch,
+ * one plus this parent's subagents already running, and this parent's spawns in flight. They are never added,
+ * because each count already holds the others' members. The in-flight count is what lets several separate
+ * calls that start together (parallel tool calls, a `Promise.all` of `agent()`) see each other.
+ */
+async function countConcurrentSubagents(request: StructuredSubagentRequest): Promise<number> {
+	const batch = Math.max(1, Math.floor((await request.batchSize) ?? 1));
+	const parentId = request.session.getAgentId?.() ?? MAIN_AGENT_ID;
+	const registry = request.session.agentRegistry ?? AgentRegistry.global();
+	const running = registry.list().filter(ref => ref.status === "running" && ref.parentId === parentId).length;
+	return Math.max(batch, 1 + running, spawnsInFlight.get(spawnParentKey(request)) ?? 0);
+}
